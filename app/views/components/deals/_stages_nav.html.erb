<%= stylesheet_link_tag 'stages_nav', media: 'all' %>
<nav aria-label="breadcrumb" data-controller='load-flowbite' class="stage-bar my-2">
  <div class="flex flex-wrap gap-1">
    <% deal.stage.pipeline.stages.order(:position).each_with_index do | stage, index | %>
      <div class="flex-1 min-w-[20px]">
        
        <%# CONFIGURAÇÃO DAS BARRINHAS %>
        <% if stage == deal.stage or deal.stage.position > stage.position %>
          <%# 'bg-emerald-500' é o Verde vivo (Ganho), 'bg-red-600' (Perdido) e 'bg-teal-400' (Ciano/Andamento) %>
          <div class="h-2 w-full rounded-sm <%= deal.status == 'won' ? 'bg-emerald-500' : (deal.status == 'lost' ? 'bg-red-600' : 'bg-teal-400') %>" style="z-index: #{30 - index}"></div>
        <% else %>
          <div class="h-2 w-full rounded-sm bg-gray-300" style="z-index: #{30 - index}"></div>
        <% end %>
        
        <%# CONFIGURAÇÃO DA ESCRITA (NOME DA FASE) %>
        <% if stage == deal.stage %>
          <p class="text-[10px] font-bold mt-1 truncate <%= deal.status == 'won' ? 'text-emerald-700' : (deal.status == 'lost' ? 'text-red-700' : 'text-teal-600') %>">
            <%= stage.name %>
          </p>
        <% end %>

      </div>
    <% end %>
  </div>
</nav>

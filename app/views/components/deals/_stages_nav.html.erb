<%= stylesheet_link_tag 'stages_nav', media: 'all' %>
<nav aria-label="breadcrumb" id='<%= dom_id(deal, :stages_nav) %>' data-controller='load-flowbite deal--stage-update' class="stage-bar relative">
  <%# Loading Spinner Overlay %>
  <div data-deal--stage-update-target="spinner" class="hidden absolute inset-0 z-[100] flex items-center justify-center bg-white/50 dark:bg-slate-900/50 backdrop-blur-[1px] rounded-lg">
    <div class="animate-spin rounded-full h-4 w-4 border-2 border-emerald-500 border-t-transparent"></div>
  </div>

  <div class="flex space-x-1 items-start">
    <% stages = deal.stage.pipeline.stages.order(:position) %>
    <% stages.each_with_index do | stage, index | %>
      
      <div class="flex-1 flex flex-col items-center min-w-[30px] relative z-30">
        
        <% 
          is_past_or_current = (stage.position <= deal.stage.position)
          # Definição de cores de fundo e setas
          if is_past_or_current
            bg_color = case deal.status
                        when 'won' then 'bg-[#86efac]'  # Verde Pastel mais suave
                        when 'lost', 'cancelled' then 'bg-[#f87171]' # Vermelho Pastel
                        else 'bg-[#22c55e]'           # Verde Forte (Em andamento)
                        end 
            
            arrow_color = case deal.status
                            when 'won' then 'before:border-l-[#86efac]'
                            when 'lost', 'cancelled' then 'before:border-l-[#f87171]'
                            else 'before:border-l-[#22c55e]'
                            end
          else
            bg_color = 'bg-gray-200 dark:bg-slate-800'
            arrow_color = 'before:border-l-gray-200 dark:before:border-l-slate-800'
          end
        %>

        <% 
          tooltip_id = "tooltip-stage-#{deal.id}-#{stage.id}"
          tooltip_placement = "top"
          
          # Logic for classes shared between open and closed status
          common_classes = "first:rounded-l-lg last:rounded-r-lg justify-center flex w-full h-2 #{bg_color} relative transition-all before:absolute"
          arrow_logic = index == stages.length - 1 ? '' : "before:top-0 before:z-10 before:right-[-4px] before:border-solid #{arrow_color} before:border-l-[4px] before:border-y-transparent before:border-y-[4px] after:absolute after:top-0 after:border-solid after:border-y-transparent after:border-y-[4px] inline-block after:border-l-light-palette-p5 after:border-l-[4px] after:right-[-7px] "
        %>

        <% if deal.open? %>
          <%= link_to account_deal_path(deal.account, deal, deal: { stage_id: stage.id } ), 
                      data: { turbo_method: :patch, confirm: t('views.accounts.deals.stages_nav_desktop.are_you_sure?'), tooltip_target: tooltip_id, tooltip_placement: tooltip_placement }, 
                      class: "#{common_classes} group hover:scale-y-125 #{arrow_logic}", style:"z-index: #{30 - index} ", aria_current:"page" do %>
            &nbsp;
          <% end %>
        <% else %>
          <div class="<%= common_classes %> <%= arrow_logic %>" 
               data-tooltip-target="<%= tooltip_id %>" 
               data-tooltip-placement="<%= tooltip_placement %>"
               style="z-index: <%= 30 - index %> ">
            &nbsp;
          </div>
        <% end %>

        <div id="<%= tooltip_id %>" role="tooltip" data-turbo-permanent class="absolute z-50 invisible inline-block px-3 py-2 text-xs font-bold text-white transition-opacity duration-300 bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip dark:bg-slate-800 whitespace-nowrap">
          <%= stage.name %>
          <div class="tooltip-arrow" data-popper-arrow></div>
        </div>

        <%# TEXTO DA ETAPA COM CORES AJUSTADAS PARA LEITURA %>
        <% if stage == deal.stage %>
          <div class="flex flex-col items-center mt-2 pb-1 w-full min-w-[80px]">
            <% 
              text_color = case deal.status
                           when 'won' then 'text-green-700'   # Verde Vivo para Ganho
                           when 'lost' then 'text-red-700'    # Vermelho Vivo para Perdido
                           else 'text-black font-extrabold'   # Preto para Em Andamento
                           end 
            %>
            <p class="text-[10px] font-black text-center leading-tight whitespace-normal break-words <%= text_color %>">
              <%= stage.name.upcase %>
            </p>
            
            <% if deal.status == 'won' %>
              <span class="text-[9px] font-extrabold text-green-700 mt-1 tracking-tight bg-green-500/30 px-1.5 py-0.5 rounded shadow-[0_0_8px_rgba(74,222,128,0.4)] whitespace-nowrap">✓ GANHO</span>
            <% elsif deal.status == 'lost' %>
              <span class="text-[9px] font-extrabold text-red-700 mt-1 tracking-tight bg-red-500/30 px-1.5 py-0.5 rounded shadow-[0_0_8px_rgba(248,113,113,0.4)] whitespace-nowrap">✕ PERDIDO</span>
            <% end %>
          </div>
        <% end %>

      </div>
    <% end %>
  </div>
</nav>

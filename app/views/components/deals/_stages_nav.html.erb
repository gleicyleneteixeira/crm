<%= stylesheet_link_tag 'stages_nav', media: 'all' %>
<nav aria-label="breadcrumb" data-controller='load-flowbite' class="stage-bar my-2">
  <div class="flex flex-wrap gap-1">
    <% deal.stage.pipeline.stages.order(:position).each_with_index do | stage, index | %>
      <div class="flex-1 min-w-[20px]">
        <% if stage == deal.stage or deal.stage.position > stage.position %>
          <%= link_to account_deal_path(deal.account, deal, deal: { status: deal.status, stage_id: stage.id } ), 
              method: :patch, 
              class: "justify-center flex h-2 w-full rounded-sm #{ stage == deal.stage ? 'bg-green-600' : 'bg-green-300' }", 
              style:"z-index: #{30 - index}" do %>
          <% end %>
        <% else %>
          <%= link_to account_deal_path(deal.account, deal, deal: { status: deal.status, stage_id: stage.id } ), 
              method: :patch, 
              class: "justify-center flex h-2 w-full rounded-sm bg-gray-300", 
              style:"z-index: #{30 - index}" do %>
          <% end %>
        <% end %>
        
        <% if stage == deal.stage %>
          <p class="text-[10px] font-bold text-gray-700 mt-1 truncate">
            <%= stage.name %>
          </p>
        <% end %>
      </div>
    <% end %>
  </div>
</nav>

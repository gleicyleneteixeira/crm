<%= stylesheet_link_tag 'stages_nav', media: 'all' %>
<nav aria-label="breadcrumb" id='stages_nav' data-controller='load-flowbite' class="stage-bar">
  <div class="flex space-x-1 items-start">
    <% stages = deal.stage.pipeline.stages.order(:position) %>
    <% stages.each_with_index do | stage, index | %>
      
      <div class="flex-1 flex flex-col items-center min-w-[25px]">
        
        <% if stage == deal.stage or deal.stage.position > stage.position %>
          <%# Cores: Um tom abaixo do atual para suavizar %>
          <% 
            bg_color = case deal.status
                       when 'won' then 'bg-[#a7f3d0]'  # Verde Pago (Suave/Pastel Médio)
                       when 'lost' then 'bg-[#fca5a5]' # Vermelho Cancelado (Suave/Rosado)
                       else 'bg-green-500'             # Andamento (Mantido Verde Forte)
                       end 
            
            arrow_color = case deal.status
                           when 'won' then 'before:border-l-[#a7f3d0]'
                           when 'lost' then 'before:border-l-[#fca5a5]'
                           else 'before:border-l-green-500'
                           end
          %>

          <%# Barra fina h-2 para elegância %>
          <%= link_to account_deal_path(deal.account, deal, deal: { status: deal.status, stage_id: stage.id } ), method: :patch, data: { confirm: t('views.accounts.deals.stages_nav_desktop.are_you_sure?'), tooltip_target:"tooltip-default-#{stage.id}-#{stage.name}", data_tooltip_placement:"bottom" }, class: "first:rounded-l-lg last:rounded-r-lg justify-center flex w-full h-2 #{bg_color} group relative before:absolute #{ index == stages.length - 1 ? '' : "before:top-0 before:z-10 before:right-[-4px] before:border-solid #{arrow_color} before:border-l-[4px] before:border-y-transparent before:border-y-[4px] after:absolute after:top-0 after:border-solid after:border-y-transparent after:border-y-[4px] inline-block after:border-l-light-palette-p5 after:border-l-[4px] after:right-[-7px] " }", style:"z-index: #{30 - index} ", aria_current:"page" do %>
            &nbsp;
          <% end %>
        <% else %>
          <div class="flex w-full h-2 bg-gray-200 relative first:rounded-l-lg last:rounded-r-lg"></div>
        <% end %>

        <%# ESCRITA VIVIDA (TONS FORTES): Para leitura imediata %>
        <% if stage == deal.stage %>
          <p class="text-[9px] font-black mt-1 text-center leading-none <%= deal.status == 'won' ? 'text-green-900' : (deal.status == 'lost' ? 'text-red-900' : 'text-black') %>">
            <%= stage.name %>
          </p>
        <% end %>

      </div>
    <% end %>
  </div>
</nav>

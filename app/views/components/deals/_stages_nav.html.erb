<%= stylesheet_link_tag 'stages_nav', media: 'all' %>
<nav aria-label="breadcrumb" id='stages_nav' data-controller='load-flowbite' class="stage-bar">
  <div class="flex space-x-1">
    <% stages = deal.stage.pipeline.stages.order(:position) %>
    <% stages.each_with_index do | stage, index | %>
      
      <%# Criamos um container para empilhar a barra e o nome embaixo %>
      <div class="flex-1 flex flex-col items-center min-w-[30px]">
        
        <% if stage == deal.stage or deal.stage.position > stage.position %>
          <%# Lógica de Cores Dinâmicas %>
          <% 
            bg_color = case deal.status
                       when 'won' then 'bg-teal-400'
                       when 'lost' then 'bg-red-600'
                       else 'bg-green-500'
                       end 
            
            arrow_color = case deal.status
                           when 'won' then 'before:border-l-teal-400'
                           when 'lost' then 'before:border-l-red-600'
                           else 'before:border-l-green-500'
                           end
          %>

          <%# LINK ATIVO: Permite mudar a etapa clicando na barra %>
          <%= link_to account_deal_path(deal.account, deal, deal: { status: deal.status, stage_id: stage.id } ), method: :patch, data: { confirm: t('views.accounts.deals.stages_nav_desktop.are_you_sure?'), tooltip_target:"tooltip-default-#{stage.id}-#{stage.name}", data_tooltip_placement:"bottom" }, class: "first:rounded-l-lg last:rounded-r-lg justify-center flex w-full h-3 #{bg_color} group relative before:absolute #{ index == stages.length - 1 ? '' : "before:top-0 before:z-10 before:right-[-6px] before:border-solid #{arrow_color} before:border-l-[6px] before:border-y-transparent before:border-y-[6px] after:absolute after:top-0 after:border-solid after:border-y-transparent after:border-y-[6px] inline-block after:border-l-light-palette-p5 after:border-l-[6px] after:right-[-10px] " }", style:"z-index: #{30 - index} ", aria_current:"page" do %>
            &nbsp;
          <% end %>
        <% else %>
          <%# Barra Cinza para as próximas etapas %>
          <%= link_to account_deal_path(deal.account, deal, deal: { status: deal.status, stage_id: stage.id } ), method: :patch, data: { confirm: t('views.accounts.deals.stages_nav_desktop.are_you_sure?'), tooltip_target:"tooltip-default-#{stage.id}-#{stage.name}", data_tooltip_placement:"bottom" }, class: "flex w-full h-3 bg-gray-300 relative hover:bg-gray-400 first:rounded-l-lg last:rounded-r-lg justify-center before:absolute #{ index == stages.length - 1 ? '' : "before:top-0 before:z-10 before:right-[-6px] before:border-solid before:border-l-gray-300 before:hover:border-l-gray-400 before:border-l-[6px] before:border-y-transparent before:border-y-[6px] after:absolute after:top-0 after:border-solid after:border-y-transparent after:border-y-[6px] inline-block after:absolute after:top-0 after:border-solid after:border-l-light-palette-p5 after:border-l-[6px] after:right-[-10px]" } ", style:"z-index: #{30 - index } " do %>
            &nbsp;
          <% end %>
        <% end %>

        <%# NOME DA FASE SEMPRE VISÍVEL (SÓ NA ETAPA ATUAL) %>
        <% if stage == deal.stage %>
          <p class="text-[9px] font-bold mt-1 text-center leading-none <%= deal.status == 'won' ? 'text-teal-700' : (deal.status == 'lost' ? 'text-red-700' : 'text-black') %>">
            <%= stage.name %>
          </p>
        <% end %>

      </div>

      <%# Tooltip oficial mantido como reserva %>
      <div id="tooltip-default-<%= stage.id %>-<%= stage.name %>" role="tooltip" class="absolute z-50 invisible inline-block px-3 py-2 typography-text-m-lh150 text-dark-gray-palette-p3 bg-white border border-gray-400 rounded-lg shadow-sm opacity-0 tooltip transition-opacity duration-300">
        <%= stage.name %>
        <div class="tooltip-arrow" data-popper-arrow></div>
      </div>
    <% end %>
  </div>
</nav>

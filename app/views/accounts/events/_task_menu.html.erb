<% minimal = defined?(minimal) ? minimal : false %>
<div class="relative inline-block text-left" 
     data-controller="task-menu" 
     data-task-menu-event-id-value="<%= event.id %>"
     data-task-menu-update-url-value="<%= account_contact_event_path(event.account, event.contact, event, deal_id: event.deal_id) %>"
     data-task-menu-delete-url-value="<%= account_contact_event_path(event.account, event.contact, event, deal_id: event.deal_id) %>">
  
  <button data-task-menu-target="display" 
          type="button"
          data-action="click->task-menu#toggleMenu"
          class="flex items-center gap-1 cursor-pointer border-none bg-transparent p-0 m-0 outline-none focus:ring-0">
    <div class="flex items-center justify-center transition-colors rounded-full p-0.5 hover:bg-slate-100 dark:hover:bg-slate-800"
         data-task-menu-target="icon">
      <% if event.done? %>
        <i data-lucide="check" class="w-4 h-4 text-emerald-500"></i>
      <% else %>
        <i data-lucide="clock-4" class="w-4 h-4 <%= event.status_color %>"></i>
      <% end %>
    </div>
    
    <% if defined?(show_date) && show_date %>
      <span class="typography-body-800 text-[11px] <%= event.status_color %> select-none">
        <%= render "components/formatters/datetime", value: event.primary_date, type: "distance" %>
      </span>
    <% end %>
  </button>

  <% if minimal %>
    <%# SMART TELEPORT TARGET: ISOLATED FROM FLEX FLOW AT RUNTIME %>
    <div data-task-menu-target="editForm" 
         id="edit-form-inner-<%= event.id %>"
         class="hidden w-[240px] bg-slate-900 border border-slate-700 rounded-xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] p-4 cursor-default pointer-events-auto transition-all duration-300">
      <%= form_with model: event, url: account_contact_event_path(event.account, event.contact, event, deal_id: event.deal_id), method: :patch, data: { action: "submit->task-menu#submitEdit" } do |f| %>
        <div class="flex flex-col gap-3">
          <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-0.5">Editar Agendamento</p>
          
          <div class="space-y-2">
            <%= f.text_field :title, 
                class: "w-full text-xs h-9 px-3 bg-black/40 border border-slate-700/50 rounded-lg text-slate-100 placeholder:text-slate-600 focus:ring-1 focus:ring-sky-500/50 focus:border-sky-500/50 transition-all outline-none", 
                placeholder: "O que precisa ser feito?", 
                data: { task_menu_target: "input" } %>
            
            <div class="relative">
              <%= f.datetime_local_field :scheduled_at, 
                  value: event.scheduled_at&.strftime("%Y-%m-%dT%H:%M"), 
                  class: "w-full text-xs h-9 px-3 bg-black/40 border border-slate-700/50 rounded-lg text-slate-100 focus:ring-1 focus:ring-sky-500/50 focus:border-sky-500/50 transition-all outline-none" %>
            </div>
          </div>

          <div class="flex justify-end items-center gap-3 mt-1 pt-2 border-t border-slate-800">
            <button type="button" 
                    data-action="click->task-menu#fallbackCancel" 
                    class="text-[11px] font-medium text-slate-400 hover:text-slate-200 transition-colors">
              Cancelar
            </button>
            <%= f.submit "Salvar", 
                class: "bg-sky-600 hover:bg-sky-500 text-white text-[11px] font-bold px-4 py-1.5 rounded-lg shadow-lg shadow-sky-900/20 transition-all active:scale-95 cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Dropdown Menu -->
  <div id="task-menu-dropdown-<%= event.id %>"
       data-task-menu-target="menu" 
       class="hidden absolute w-40 origin-top-right rounded-xl bg-white dark:!bg-slate-900 shadow-[0_20px_50px_rgba(0,0,0,0.3)] ring-1 ring-black ring-opacity-5 focus:outline-none z-[9999] py-1 text-xs border border-slate-200 dark:border-slate-700" 
       role="menu">
    
    <% if event.done? %>
      <a href="#" class="flex items-center gap-2 px-3 py-1.5 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" 
         role="menuitem" 
         data-action="click->task-menu#reopenTask">
        <i data-lucide="rotate-ccw" class="w-3.5 h-3.5 text-sky-500"></i>
        <span>Reabrir Tarefa</span>
      </a>
    <% else %>
      <a href="#" class="flex items-center gap-2 px-3 py-1.5 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" 
         role="menuitem" 
         data-action="click->task-menu#completeTask">
        <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500"></i>
        <span>Concluir</span>
      </a>
    <% end %>

    <a href="#" class="flex items-center gap-2 px-3 py-1.5 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" 
       role="menuitem" 
       data-action="click->task-menu#showEdit">
      <i data-lucide="pencil" class="w-3.5 h-3.5 text-sky-500"></i>
      <span>Editar</span>
    </a>

    <div class="my-1 border-t border-slate-100 dark:border-slate-800"></div>

    <a href="#" class="flex items-center gap-2 px-3 py-1.5 text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors" 
       role="menuitem" 
       data-action="click->task-menu#deleteTask">
      <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
      <span>Excluir</span>
    </a>
  </div>
</div>


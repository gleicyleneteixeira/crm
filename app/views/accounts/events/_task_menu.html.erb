<div class="relative inline-block text-left" 
     data-controller="task-menu" 
     data-task-menu-update-url-value="<%= account_contact_event_path(event.account, event.contact, event, deal_id: event.deal_id) %>"
     data-task-menu-delete-url-value="<%= account_contact_event_path(event.account, event.contact, event, deal_id: event.deal_id) %>">
  
  <div data-task-menu-target="display" class="flex items-center gap-1.5 min-w-0">
    <button type="button" 
            class="flex items-center justify-center transition-colors rounded-full p-0.5 hover:bg-slate-200 dark:hover:bg-slate-800"
            data-action="click->task-menu#toggleMenu"
            data-task-menu-target="icon">
      <% if event.done? %>
        <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500"></i>
      <% else %>
        <i data-lucide="clock-4" class="w-3.5 h-3.5 <%= event.overdue? ? 'text-red-500' : 'text-slate-400' %>"></i>
      <% end %>
    </button>
    
    <% if defined?(show_date) && show_date %>
      <span class="typography-body-800 text-[10px] truncate max-w-[80px] <%= event.overdue? ? 'text-red-500' : 'text-slate-400 dark:text-slate-500' %>">
        <%= (event.title.present? && event.title.length < 15) ? event.title : render("components/formatters/datetime", value: event.primary_date, type: "distance") %>
      </span>
    <% end %>
  </div>

  <!-- Inline Edit Form (Hidden) -->
  <div data-task-menu-target="editForm" 
       class="hidden absolute left-0 sm:left-auto sm:right-0 mt-2 z-[60] bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-2xl p-2.5 w-56 animate-in fade-in zoom-in-95 duration-100">
    <%= form_with model: event, url: account_contact_event_path(event.account, event.contact, event, deal_id: event.deal_id), method: :patch, data: { action: "submit->task-menu#submitEdit" } do |f| %>
      <div class="flex flex-col gap-2">
        <div class="flex flex-col gap-1">
          <label class="text-[9px] uppercase font-bold text-slate-500 ml-1">Tarefa</label>
          <%= f.text_field :title, class: "form-input !text-[11px] !h-7 !px-2 !bg-slate-50 dark:!bg-slate-850 !border-slate-200 dark:!border-slate-800 focus:!ring-1 focus:!ring-brand-palette-03", placeholder: "O que fazer?", data: { task_menu_target: "input" } %>
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-[9px] uppercase font-bold text-slate-500 ml-1">Prazo</label>
          <%= f.datetime_local_field :scheduled_at, value: event.scheduled_at&.strftime("%Y-%m-%dT%H:%M"), class: "form-input !text-[11px] !h-7 !px-2 !bg-slate-50 dark:!bg-slate-850 !border-slate-200 dark:!border-slate-800 focus:!ring-1 focus:!ring-brand-palette-03" %>
        </div>
        <div class="flex justify-end gap-1.5 mt-1">
          <button type="button" data-action="click->task-menu#cancelEdit" class="text-[10px] font-medium px-2 py-1 text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 transition-colors">Cancelar</button>
          <%= f.submit "Salvar", class: "button-default-primary-xs !py-0.5 !px-3 !text-[10px] !h-6 !bg-brand-palette-03 !hover:bg-brand-palette-04" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Dropdown Menu -->
  <div data-task-menu-target="menu" 
       class="hidden absolute left-0 sm:left-auto sm:right-0 mt-1 w-36 origin-top-right rounded-md bg-white dark:bg-slate-900 shadow-xl ring-1 ring-black ring-opacity-5 focus:outline-none z-[60] py-1 text-[11px] border border-slate-200 dark:border-slate-800 animate-in fade-in slide-in-from-top-1 duration-100" 
       role="menu">
    
    <% if !event.done? %>
      <button type="button" 
         class="group flex w-full items-center gap-2 px-2.5 py-1.5 text-slate-600 dark:text-slate-400 hover:bg-emerald-50 dark:hover:bg-emerald-500/10 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors" 
         data-action="click->task-menu#completeTask">
        <i data-lucide="check" class="w-3.5 h-3.5 text-slate-400 group-hover:text-emerald-500 transition-colors"></i>
        <span>Concluir</span>
      </button>
    <% end %>

    <button type="button" 
       class="group flex w-full items-center gap-2 px-2.5 py-1.5 text-slate-600 dark:text-slate-400 hover:bg-sky-50 dark:hover:bg-sky-500/10 hover:text-sky-600 dark:hover:text-sky-400 transition-colors" 
       data-action="click->task-menu#showEdit">
      <i data-lucide="pencil" class="w-3.5 h-3.5 text-slate-400 group-hover:text-sky-500 transition-colors"></i>
      <span>Editar</span>
    </button>

    <div class="my-1 border-t border-slate-100 dark:border-slate-800 mx-2"></div>

    <button type="button" 
       class="group flex w-full items-center gap-2 px-2.5 py-1.5 text-slate-600 dark:text-slate-400 hover:bg-red-50 dark:hover:bg-red-500/10 hover:text-red-600 dark:hover:text-red-400 transition-colors" 
       data-action="click->task-menu#deleteTask">
      <i data-lucide="trash-2" class="w-3.5 h-3.5 text-slate-400 group-hover:text-red-500 transition-colors"></i>
      <span>Excluir</span>
    </button>
  </div>


</div>

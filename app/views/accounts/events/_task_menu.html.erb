<% minimal = defined?(minimal) ? minimal : false %>
<div class="relative inline-block text-left" 
     id="<%= dom_id(event, :menu_wrapper) %>"
     data-controller="task-menu" 
     data-task-menu-event-id-value="<%= event.id %>">
  
  <button type="button" 
          id="<%= dom_id(event, :menu_trigger) %>"
          data-action="click->task-menu#toggleMenu"
          class="flex items-center gap-1.5 focus:outline-none group transition-all duration-200">
    <i data-lucide="clock" class="w-3.5 h-3.5 <%= event.status_color %> transition-colors duration-200"></i>
    <% if !minimal && event.scheduled_at.present? %>
      <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400 group-hover:text-slate-700 dark:group-hover:text-slate-200 transition-colors">
        <%= render "components/formatters/datetime", value: event.primary_date, type: "distance" %>
      </span>
    <% end %>
  </button>

  <% if minimal %>
    <%# INLINE EDIT FORM (Kanban) %>
    <div data-task-menu-target="editForm" 
         id="edit-form-inner-<%= event.id %>"
         class="hidden w-[240px] bg-slate-900 border border-slate-700 rounded-xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] p-4 cursor-default pointer-events-auto z-[99999]">
      <%= form_with model: event, url: account_contact_event_path(event.account, event.contact, event, deal_id: event.deal_id), 
          method: :patch, 
          data: { action: "turbo:submit-end->task-menu#submitEdit" } do |f| %>
        <div class="flex flex-col gap-3">
          <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-0.5">Editar Agendamento</p>
          
          <div class="space-y-2">
            <%= f.text_field :title, 
                class: "w-full text-xs h-9 px-3 bg-black/40 border border-slate-700/50 rounded-lg text-slate-100 placeholder:text-slate-600 focus:ring-1 focus:ring-sky-500/50 focus:border-sky-500/50 transition-all outline-none", 
                placeholder: "O que precisa ser feito?", 
                data: { task_menu_target: "input" } %>
            
            <div class="relative">
              <%= f.datetime_local_field :scheduled_at, 
                  value: event.scheduled_at&.strftime("%Y-%m-%dT%H:%M"), 
                  class: "w-full text-xs h-9 px-3 bg-black/40 border border-slate-700/50 rounded-lg text-slate-100 focus:ring-1 focus:ring-sky-500/50 focus:border-sky-500/50 transition-all outline-none" %>
            </div>
          </div>

          <div class="flex justify-end items-center gap-3 mt-1 pt-2 border-t border-slate-800">
            <button type="button" 
                    data-action="click->task-menu#cancelEdit" 
                    class="text-[11px] font-medium text-slate-400 hover:text-slate-200 transition-colors">
              Cancelar
            </button>
            <%= f.submit "Salvar", 
                class: "bg-sky-600 hover:bg-sky-500 text-white text-[11px] font-bold px-4 py-1.5 rounded-lg shadow-lg shadow-sky-900/20 transition-all active:scale-95 cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Dropdown Menu (TURBO-NATIVO) -->
  <div id="task-menu-dropdown-<%= event.id %>"
       data-task-menu-target="menu" 
       class="hidden absolute w-44 origin-top-right rounded-xl bg-white dark:!bg-slate-900 shadow-[0_20px_50px_rgba(0,0,0,0.3)] ring-1 ring-black ring-opacity-5 focus:outline-none z-[9999] py-1 text-xs border border-slate-200 dark:border-slate-700 overflow-hidden" 
       role="menu">
    
    <% if event.done? %>
      <%= button_to account_contact_event_path(event.account, event.contact, event, "event[done]": false, deal_id: event.deal_id), 
          method: :patch,
          form_class: "w-full",
          class: "w-full flex items-center gap-2 px-3 py-2 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-left",
          data: { action: "click->task-menu#closeMenu" } do %>
        <i data-lucide="rotate-ccw" class="w-3.5 h-3.5 text-sky-500"></i>
        <span>Reabrir Tarefa</span>
      <% end %>
    <% else %>
      <%= button_to account_contact_event_path(event.account, event.contact, event, "event[done]": true, deal_id: event.deal_id), 
          method: :patch,
          form_class: "w-full",
          class: "w-full flex items-center gap-2 px-3 py-2 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-left",
          data: { action: "click->task-menu#closeMenu" } do %>
        <i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500"></i>
        <span>Concluir</span>
      <% end %>
    <% end %>

    <% if minimal %>
      <a href="#" class="flex items-center gap-2 px-3 py-2 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" 
         role="menuitem" 
         data-action="click->task-menu#showEdit">
        <i data-lucide="pencil" class="w-3.5 h-3.5 text-sky-500"></i>
        <span>Editar</span>
      </a>
    <% else %>
      <%= link_to edit_account_contact_event_path(event.account, event.contact, event, deal_id: event.deal_id), 
          class: "flex items-center gap-2 px-3 py-2 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors",
          data: { turbo_frame: "modal", action: "click->task-menu#closeMenu" } do %>
        <i data-lucide="pencil" class="w-3.5 h-3.5 text-sky-500"></i>
        <span>Editar</span>
      <% end %>
    <% end %>

    <div class="my-1 border-t border-slate-100 dark:border-slate-800"></div>

    <%= button_to account_contact_event_path(event.account, event.contact, event, deal_id: event.deal_id), 
        method: :delete,
        form_class: "w-full",
        class: "w-full flex items-center gap-2 px-3 py-2 text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors text-left",
        data: { turbo_confirm: "Tem certeza que deseja excluir esta tarefa?", action: "click->task-menu#closeMenu" } do %>
      <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
      <span>Excluir</span>
    <% end %>
  </div>
</div>

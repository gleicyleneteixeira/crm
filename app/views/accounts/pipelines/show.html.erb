<%# Local: app/views/accounts/pipelines/show.html.erb %>

<%= turbo_stream_from :stages %>
<%= turbo_frame_tag :stages do %>
  <%# MUDANÇA: Trocamos dark:bg-gray-900 por dark:bg-[#020617] %>
  <div data-controller="lists" data-lists-id="<%= @pipeline.id %>" class="min-h-screen min-w-full inline-block bg-blue-50 dark:bg-[#020617] transition-colors duration-200">
    <section class="p-8 grid grid-flow-col auto-cols-[18.75rem] h-auto gap-5" data-lists-target="lists">
      <% @pipeline.stages.sort_by(&:position).each do |stage| %>
        <%= turbo_frame_tag stage, src: account_stage_path(current_user.account, stage, filter_status_deal: @filter_status_deal), loading: :lazy do  %>
          <%= render '/components/skeleton/stage'%>
        <% end %>
      <% end %>
    </section>
  </div>
<% end %>

<%# Local: app/views/accounts/pipelines/show.html.erb %>
<% content_for :stylesheets do %>
  <meta name="turbo-cache-control" content="no-cache">
  <style>
    /* User Requested SPA Kanban Styles */
    
    /* Faz o main propagar a altura flex para o conteudo interno */
    main {
      display: flex !important;
      flex-direction: column !important;
    }

    /* Permite que o turbo-frame preencha a tela sem quebrar o layout */
    turbo-frame#stages {
      display: flex !important;
      flex-direction: column !important;
      flex: 1 1 auto !important;
      min-height: 0 !important;
    }

    /* Container do Kanban: preenche 100% do espaco restante */
    .kanban-board-container { 
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      flex-direction: column; 
      overflow: hidden;
      width: 100%;
    }

    /* Área exclusiva para rolagem horizontal das colunas */
    .kanban-scrollable-section {
      flex: 1 1 auto;
      min-height: 0; /* IMPEDe colunas de empurrarem a barra para fora da tela */
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      overflow-y: hidden;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.5rem;
      padding-bottom: 1rem; /* Dá espaço para a barra de rolagem nos navegadores Windows */
    }

    /* Scroll Invisible Helpers */
    .scrollbar-none { 
      scrollbar-width: none !important; 
    }
    .scrollbar-none::-webkit-scrollbar { 
      display: none !important; 
    }
  </style>
<% end %>

<%= turbo_stream_from :stages %>
<%= turbo_frame_tag :stages do %>
  <div data-controller="lists" data-lists-id="<%= @pipeline.id %>" class="kanban-board-container bg-brand-palette-08">
    <section class="kanban-scrollable-section" data-lists-target="lists">
      <% @pipeline.stages.sort_by(&:position).each do |stage| %>
        <div class="flex-shrink-0 w-[18.75rem] h-full">
          <%= turbo_frame_tag stage, src: account_stage_path(current_user.account, stage, filter_status_deal: @filter_status_deal), loading: :lazy, class: "h-full w-full block" do %>
            <%= render '/components/skeleton/stage'%>
          <% end %>
        </div>
      <% end %>
    </section>

    <div class="kanban-drop-zones" data-controller="load-lucid-icons" aria-hidden="true">
      <div class="kanban-drop-zone kanban-drop-zone--won" data-drop-zone="won">
        <i data-lucide="trophy" class="w-4 h-4"></i>
        <span>Marcar como ganho</span>
      </div>
      <div class="kanban-drop-zone kanban-drop-zone--lost" data-drop-zone="lost">
        <i data-lucide="x-circle" class="w-4 h-4"></i>
        <span>Marcar como perdido</span>
      </div>
      <div class="kanban-drop-zone kanban-drop-zone--delete" data-drop-zone="delete">
        <i data-lucide="trash-2" class="w-4 h-4"></i>
        <span>Excluir negócio</span>
      </div>
    </div>
  </div>
<% end %>
<%# Global Premium Floating Overlay (Centered) %>
<div data-controller="task-centered">
  <div id="task-centered-backdrop" 
       data-task-centered-target="backdrop" 
       class="task-centered-backdrop transition-opacity duration-300">
  </div>

  <div id="task-centered-overlay" 
       data-task-centered-target="overlay" 
       class="task-centered-overlay transition-all duration-300 transform scale-95 opacity-0 hidden">
    <%= turbo_frame_tag :modal, 
                        data: { task_centered_target: "frame", action: "turbo:frame-load->task-centered#show" } %>
  </div>
</div>


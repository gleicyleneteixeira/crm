<%# Local: app/views/accounts/pipelines/show.html.erb %>
<% content_for :stylesheets do %>
  <meta name="turbo-cache-control" content="no-cache">
  <style>
    /* User Requested SPA Kanban Styles */
    
    /* Container do Kanban: height, flex, overflow-x */
    .kanban-board-container { 
      height: calc(100vh - 58px); /* Adjusting for navbar height */
      display: flex; 
      overflow-x: auto;
      overflow-y: hidden;
      width: 100%;
    }

    /* Scroll Invisible Helpers */
    .scrollbar-none { 
      scrollbar-width: none !important; 
    }
    .scrollbar-none::-webkit-scrollbar { 
      display: none !important; 
    }
  </style>
<% end %>

<%= turbo_stream_from :stages %>
<%= turbo_frame_tag :stages do %>
  <div data-controller="lists" data-lists-id="<%= @pipeline.id %>" class="kanban-board-container bg-brand-palette-08 p-6 gap-5 items-start">
    <% @pipeline.stages.sort_by(&:position).each do |stage| %>
      <div class="flex-shrink-0 w-[18.75rem] h-full">
        <%= turbo_frame_tag stage, src: account_stage_path(current_user.account, stage, filter_status_deal: @filter_status_deal), loading: :lazy, class: "h-full w-full block" do %>
          <%= render '/components/skeleton/stage'%>
        <% end %>
      </div>
    <% end %>

    <div class="kanban-drop-zones" data-controller="load-lucid-icons" aria-hidden="true">
      <div class="kanban-drop-zone kanban-drop-zone--won" data-drop-zone="won">
        <i data-lucide="trophy" class="w-4 h-4"></i>
        <span>Marcar como ganho</span>
      </div>
      <div class="kanban-drop-zone kanban-drop-zone--lost" data-drop-zone="lost">
        <i data-lucide="x-circle" class="w-4 h-4"></i>
        <span>Marcar como perdido</span>
      </div>
      <div class="kanban-drop-zone kanban-drop-zone--delete" data-drop-zone="delete">
        <i data-lucide="trash-2" class="w-4 h-4"></i>
        <span>Excluir negócio</span>
      </div>
    </div>
  </div>
<% end %>
<%= turbo_frame_tag :modal %>

<%# Local: app/views/accounts/pipelines/show.html.erb %>
<% content_for :stylesheets do %>
  <meta name="turbo-cache-control" content="no-cache">
  <style>
    /* Lock the main container to exactly the viewport height minus the navbar */
    main.overflow-y-auto { 
      overflow: hidden !important; 
      display: flex !important; 
      flex-direction: column !important; 
      height: calc(100vh - 58px) !important;
      max-height: calc(100vh - 58px) !important;
      min-height: 0 !important;
      width: 100%;
    }

    /* Prevent turbo-frame from breaking the flex layout */
    turbo-frame#stages {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      min-height: 0;
      min-width: 0;
      overflow: hidden;
      width: 100%;
    }

    /* Container for the board - strictly contained */
    .kanban-board-container { 
      flex: 1 1 auto; 
      display: flex; 
      flex-direction: column; 
      min-height: 0; 
      min-width: 0; 
      overflow: hidden;
      width: 100%;
      height: 100%;
    }

    /* The horizontally scrollable section */
    .kanban-scrollable-section {
      flex: 1 1 auto;
      display: flex;
      flex-direction: row;
      gap: 1.25rem; 
      padding: 1.5rem; 
      overflow-x: auto;
      overflow-y: hidden;
      align-items: flex-start;
      margin: 0;
      min-height: 0;
      min-width: 0;
      width: 100%;
    }

    /* Utility to hide inner vertical column scrollbars visually */
    .scrollbar-none::-webkit-scrollbar { display: none; }
    .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
<% end %>

<%= turbo_stream_from :stages %>
<%= turbo_frame_tag :stages do %>
  <div data-controller="lists" data-lists-id="<%= @pipeline.id %>" class="kanban-board-container bg-brand-palette-08">
    <section class="kanban-scrollable-section" data-lists-target="lists">
      <% @pipeline.stages.sort_by(&:position).each do |stage| %>
        <div class="flex-shrink-0 w-[18.75rem] h-full max-h-full">
          <%= turbo_frame_tag stage, src: account_stage_path(current_user.account, stage, filter_status_deal: @filter_status_deal), loading: :lazy do %>
            <%= render '/components/skeleton/stage'%>
          <% end %>
        </div>
      <% end %>
    </section>

    <div class="kanban-drop-zones" data-controller="load-lucid-icons" aria-hidden="true">
      <div class="kanban-drop-zone kanban-drop-zone--won" data-drop-zone="won">
        <i data-lucide="trophy" class="w-4 h-4"></i>
        <span>Marcar como ganho</span>
      </div>
      <div class="kanban-drop-zone kanban-drop-zone--lost" data-drop-zone="lost">
        <i data-lucide="x-circle" class="w-4 h-4"></i>
        <span>Marcar como perdido</span>
      </div>
      <div class="kanban-drop-zone kanban-drop-zone--delete" data-drop-zone="delete">
        <i data-lucide="trash-2" class="w-4 h-4"></i>
        <span>Excluir negócio</span>
      </div>
    </div>
  </div>
<% end %>
<%= turbo_frame_tag :modal %>

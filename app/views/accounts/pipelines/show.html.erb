<%# Local: app/views/accounts/pipelines/show.html.erb %>
<% content_for :stylesheets do %>
  <meta name="turbo-cache-control" content="no-cache">
  <style>
    /* Hides the global vertical scrollbar just for the Kanban page */
    main.overflow-y-auto { overflow-y: hidden !important; }

    /* Utility to hide scrollbars while keeping scroll functionality */
    .scrollbar-none::-webkit-scrollbar { display: none; }
    .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
    
    /* Ensure the board fills the main container height exactly without triggering outer scroll */
    .kanban-board-container { 
      height: calc(100vh - 60px); /* Strict height to avoid main window scroll */
      display: flex; 
      flex-direction: column; 
    }
  </style>
<% end %>

<%= turbo_stream_from :stages %>
<%= turbo_frame_tag :stages do %>
  <div data-controller="lists" data-lists-id="<%= @pipeline.id %>" class="kanban-board-container bg-brand-palette-08 h-full w-full">
    <section class="flex-1 flex flex-row w-full gap-5 pl-8 pt-8 pr-8 pb-4 overflow-x-auto overflow-y-hidden items-start m-0" data-lists-target="lists">
      <% @pipeline.stages.sort_by(&:position).each do |stage| %>
        <div class="flex-shrink-0 w-[18.75rem] h-full max-h-full">
          <%= turbo_frame_tag stage, src: account_stage_path(current_user.account, stage, filter_status_deal: @filter_status_deal), loading: :lazy do %>
            <%= render '/components/skeleton/stage'%>
          <% end %>
        </div>
      <% end %>
    </section>

    <div class="kanban-drop-zones" data-controller="load-lucid-icons" aria-hidden="true">
      <div class="kanban-drop-zone kanban-drop-zone--won" data-drop-zone="won">
        <i data-lucide="trophy" class="w-4 h-4"></i>
        <span>Marcar como ganho</span>
      </div>
      <div class="kanban-drop-zone kanban-drop-zone--lost" data-drop-zone="lost">
        <i data-lucide="x-circle" class="w-4 h-4"></i>
        <span>Marcar como perdido</span>
      </div>
      <div class="kanban-drop-zone kanban-drop-zone--delete" data-drop-zone="delete">
        <i data-lucide="trash-2" class="w-4 h-4"></i>
        <span>Excluir negócio</span>
      </div>
    </div>
  </div>
<% end %>
<%= turbo_frame_tag :modal %>

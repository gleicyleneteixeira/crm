<%# Local: app/views/accounts/pipelines/show.html.erb %>

<%= turbo_stream_from :stages %>
<%= turbo_frame_tag :stages do %>
  <div data-controller="lists" data-lists-id="<%= @pipeline.id %>" class="h-full w-full bg-blue-50 dark:bg-slate-950 overflow-y-hidden transition-colors duration-200">
    <section class="p-8 grid grid-flow-col auto-cols-[18.75rem] h-full gap-5 overflow-x-auto overflow-y-hidden" data-lists-target="lists">
      <% @pipeline.stages.sort_by(&:position).each do |stage| %>
        <%= turbo_frame_tag stage, src: account_stage_path(current_user.account, stage, filter_status_deal: @filter_status_deal), loading: :lazy do  %>
          <%= render '/components/skeleton/stage'%>
        <% end %>
      <% end %>
    </section>

    <div class="kanban-drop-zones" data-controller="load-lucid-icons" aria-hidden="true">
      <div class="kanban-drop-zone kanban-drop-zone--won" data-drop-zone="won">
        <i data-lucide="trophy" class="w-4 h-4"></i>
        <span>Marcar como ganho</span>
      </div>
      <div class="kanban-drop-zone kanban-drop-zone--lost" data-drop-zone="lost">
        <i data-lucide="x-circle" class="w-4 h-4"></i>
        <span>Marcar como perdido</span>
      </div>
      <div class="kanban-drop-zone kanban-drop-zone--delete" data-drop-zone="delete">
        <i data-lucide="trash-2" class="w-4 h-4"></i>
        <span>Excluir negócio</span>
      </div>
    </div>
  </div>
<% end %>
<%= turbo_frame_tag :modal %>

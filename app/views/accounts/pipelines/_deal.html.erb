<%= content_tag :li, id: dom_id(deal), data: { id: deal.id, account_id: Current.account.id, position: deal.position } , class: 'hover:shadow-sm select-none cursor-pointer' do %>
  <%= turbo_stream_from deal %>
  
  <div class="rounded-xl border border-slate-200/70 dark:border-slate-800 bg-white dark:bg-slate-950/70 dark:backdrop-blur-md transition-colors duration-200 px-3 pt-3 pb-2" data-controller='load-lucid-icons'>
    
    <%= link_to account_deal_path(Current.account, deal.id), data: { turbo_frame: :_top }, class: 'flex flex-col gap-2' do %>
      <% unless deal.open? %>
        <div class='w-full flex'>
          <div class='inline-flex gap-1 items-center px-2 py-0.5 rounded text-[10px] font-black uppercase <%= deal.lost? ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700' %>'>
            <%= Deal.human_enum_name(:status, deal.status) %>
          </div>
        </div>
      <% end %>
      
      <p class="text-sm font-semibold text-slate-900 dark:text-slate-100 leading-snug truncate">
        <%= deal.name %>
      </p>
      <div class="w-full border-t border-slate-100/70 dark:border-slate-800 mt-1"></div>
    <% end %>

    <div class='flex items-center py-2'>
      <%= link_to account_contact_path(Current.account, deal.contact), class: "cursor-pointer peer" , data: { turbo_frame: :drawer } do %>
        <div class='flex items-start gap-2 text-xs'>
          <i data-lucide="user" class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500"></i>
          <p class='text-xs font-medium text-slate-500 dark:text-slate-300 hover:text-slate-700 dark:hover:text-slate-100 <%= dom_id(deal.contact, :stream_full_name) %>'>
            <%= deal.contact.full_name %>
          </p>
        </div>
      <% end %>
    </div>

    <div class='flex items-end justify-between pt-1'>
      <div class='flex flex-col gap-2 grow'>
        <% deal.account.custom_attribute_definitions.where(attribute_model: 'deal_attribute', show_in_card: true).each do |definition| %>
          <% key = definition.attribute_key %>
          <% value = deal.custom_attributes[key] %>
          <% next if value.blank? %>
          <div class="inline-flex items-center max-w-full px-2 py-0.5 rounded-full bg-sky-500/10 dark:bg-sky-500/20 text-[11px] border border-sky-500/30">
            <span class="truncate font-medium text-sky-700 dark:text-sky-300">
              <span class="font-semibold"><%= definition.attribute_display_name %>:</span>
              <%= value %>
            </span>
          </div>
        <% end %>
      </div>

      <div class='flex flex-col items-end gap-2'>
        <%# VALOR: Pílula Azul Pastel %>
        <% unless deal.total_amount_in_cents.zero? %>
          <div class='bg-emerald-500/15 text-emerald-300 px-3 py-0.5 rounded-full border border-emerald-500/40 font-semibold text-[11px]'>
            <%= render 'components/formatters/currency', value: deal.total_amount_in_cents %>
          </div>
        <% end %>
        
        <%# TAREFAS: Amarelo Pastel %>
        <% if deal.next_event_planned? %>
          <div class='inline-flex items-center px-3 py-0.5 rounded-full shadow-sm font-black text-[11px] bg-yellow-100 text-yellow-800 border border-yellow-200'>
             <%= render partial: 'accounts/pipelines/deal_event', locals: {event: deal.next_event_planned} %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<%= content_tag :li, id: dom_id(deal), data: { id: deal.id, account_id: Current.account.id, position: deal.position } , class: 'hover:shadow-sm select-none cursor-pointer' do %>
  <%= turbo_stream_from deal %>
  
  <div class="rounded-lg border-2 color-border-default dark:border-white/10 color-bg-fill-default dark:bg-slate-800/60 dark:backdrop-blur-lg transition-colors duration-200" data-controller='load-lucid-icons'>
    
    <%= link_to account_deal_path(Current.account, deal.id), data: { turbo_frame: :_top }, class: 'flex flex-col gap-2 pt-3 px-4' do %>
      <% unless deal.open? %>
        <div class='w-full flex'>
          <div class='inline-flex gap-1 items-center px-2 py-0.5 rounded text-[10px] font-black uppercase <%= deal.lost? ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700' %>'>
            <%= Deal.human_enum_name(:status, deal.status) %>
          </div>
        </div>
      <% end %>
      
      <p class="typography-body-900 color-fg-default dark:text-slate-100 font-bold text-[14px] leading-tight">
        <%= deal.name %>
      </p>
      <div class="w-full border-[0.5px] color-border-default dark:border-slate-800"></div>
    <% end %>

    <div class='flex items-center py-2'>
      <%= link_to account_contact_path(Current.account, deal.contact), class: "cursor-pointer peer" , data: { turbo_frame: :drawer } do %>
        <div class='flex items-start pl-4 gap-2 text-[12px]'>
          <i data-lucide="user" class="w-3.5 h-3.5 dark:text-slate-400"></i>
          <p class='typography-body-900 color-fg-soft dark:text-slate-300 hover:color-fg-default dark:hover:text-white <%= dom_id(deal.contact, :stream_full_name) %>'>
            <%= deal.contact.full_name %>
          </p>
        </div>
      <% end %>
    </div>

    <div class='flex items-end justify-between px-4 pb-4'>
      <div class='flex flex-col gap-2 grow'>
        <% if deal.users.present? %>
          <div class='flex -space-x-2'>
            <% deal.users.order(id: :desc).limit(2).each do |user| %>
              <div class="w-5 h-5 rounded-full bg-slate-700 border border-slate-900 flex items-center justify-center overflow-hidden dark:bg-slate-900/60 dark:border-white/10">
                <i data-lucide="user" class="w-3 text-white"></i>
              </div>
            <% end %>
          </div>
        <% end %>

        <% deal.account.custom_attribute_definitions.where(attribute_model: 'deal_attribute', show_in_card: true).each do |definition| %>
          <% key = definition.attribute_key %>
          <% value = deal.custom_attributes[key] %>
          <% next if value.blank? %>
          <div class="inline-flex items-center max-w-full px-2 py-0.5 rounded-full bg-slate-100 text-slate-800 text-[11px] dark:bg-slate-900/70 dark:text-slate-100 border border-slate-200/70 dark:border-slate-700/70">
            <span class="truncate">
              <strong><%= definition.attribute_display_name %>:</strong>
              <%= value %>
            </span>
          </div>
        <% end %>
      </div>

      <div class='flex flex-col items-end gap-2'>
        <%# VALOR: Pílula Azul Pastel %>
        <% unless deal.total_amount_in_cents.zero? %>
          <div class='bg-blue-100 text-blue-800 px-3 py-0.5 rounded-full shadow-sm font-black text-[11px]'>
            <%= render 'components/formatters/currency', value: deal.total_amount_in_cents %>
          </div>
        <% end %>
        
        <%# TAREFAS: Amarelo Pastel %>
        <% if deal.next_event_planned? %>
          <div class='inline-flex items-center px-3 py-0.5 rounded-full shadow-sm font-black text-[11px] bg-yellow-100 text-yellow-800 border border-yellow-200'>
             <%= render partial: 'accounts/pipelines/deal_event', locals: {event: deal.next_event_planned} %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<%= content_tag :li, id: dom_id(deal), data: { id: deal.id, account_id: Current.account.id, position: deal.position } , class: 'hover:shadow-sm select-none cursor-pointer' do %>
  <%= turbo_stream_from deal %>
  <div class="rounded border-2 color-border-default dark:border-gray-600 color-bg-fill-default dark:bg-gray-700 transition-colors duration-200" data-controller='load-lucid-icons'>
    <%= link_to account_deal_path(Current.account, deal.id), data: { turbo_frame: :_top }, class: 'flex flex-col gap-2 pt-2 px-4' do %>
      <% unless deal.open? %>
        <div class='w-full flex'>
          <div class='inline-flex gap-1 items-center px-2 py-0.5 rounded text-[10px] font-black uppercase
            <%= 'bg-red-600 text-white shadow-[0_0_10px_rgba(220,38,38,0.5)]' if deal.lost? %>
            <%= 'bg-green-600 text-white shadow-[0_0_10px_rgba(22,163,74,0.5)]' if deal.won? %>'>
              <%= Deal.human_enum_name(:status, deal.status) %>
          </div>
        </div>
      <% end %>
      
      <div class="flex items-center gap-2">
        <% if deal.open? %>
           <div class="w-3 h-3 rounded-full bg-[#39FF14] shadow-[0_0_12px_#39FF14]"></div>
        <% end %>
        <p class="typography-body-900 color-fg-default dark:text-white font-bold text-[14px] leading-tight">
          <%= deal.name %>
        </p>
      </div>
      <div class="w-full border-[0.5px] color-border-default dark:border-gray-600"></div>
    <% end %>

    <div class='flex items-center py-1'>
      <%= link_to account_contact_path(Current.account, deal.contact), class: "cursor-pointer peer" , data: { turbo_frame: :drawer } do %>
        <div class='flex items-start pl-4 gap-1'>
          <i data-lucide="user" class="w-3.5 h-3.5 dark:text-gray-300"></i>
          <p class='typography-body-900 color-fg-soft dark:text-gray-200 font-medium text-[12px] <%= dom_id(deal.contact, :stream_full_name) %>'>
            <%= deal.contact.full_name %>
          </p>
        </div>
      <% end %>
    </div>

    <div class='flex items-end justify-between px-4 pb-3'>
       <div class="flex -space-x-2">
          <% if deal.users.present? %>
            <% deal.users.order(id: :desc).limit(2).each do |user| %>
                <div class='w-6 h-6'>
                  <% if user.avatar_url.present? %>
                    <img class="w-6 h-6 rounded-full border-2 border-white dark:border-gray-800" src="<%= user.avatar_url %>">
                  <% else %>
                    <div class="w-6 h-6 rounded-full bg-gray-500 border-2 border-white dark:border-gray-800 flex items-center justify-center">
                      <i data-lucide="user" class="w-3 h-3 text-white"></i>
                    </div>
                  <% end %>
                </div>
            <% end %>
          <% end %>
       </div>

      <div class='flex flex-col items-end gap-1.5'>
        <%# CAIXA DO VALOR: Fundo azul sólido com cifrão e texto em BRANCO PURO %>
        <% unless deal.total_amount_in_cents.zero? %>
          <div class='bg-blue-600 dark:bg-blue-700 px-2 py-1 rounded shadow-md flex items-center gap-1.5'>
            <i data-lucide="circle-dollar-sign" class="w-3.5 h-3.5 text-white"></i>
            <span class='text-white font-black text-[11px] tracking-wide'>
              <%= render 'components/formatters/currency', value: deal.total_amount_in_cents %>
            </span>
          </div>
        <% end %>

        <%# CAIXA DO TEMPO: Verde Neon para o que está no prazo e Vermelho Alerta para o que venceu %>
        <% if deal.next_event_planned? %>
          <% is_overdue = deal.next_event_planned.date < Time.zone.now %>
          <div class='px-2 py-1 rounded flex items-center gap-1.5 shadow-md border-l-4 <%= is_overdue ? 'bg-red-950/80 border-red-500' : 'bg-black/60 border-[#39FF14]' %>'>
            <i data-lucide="clock" class="w-3.5 h-3.5 <%= is_overdue ? 'text-red-400' : 'text-[#39FF14]' %>"></i>
            <span class='font-black text-[11px] <%= is_overdue ? 'text-red-300' : 'text-[#39FF14]' %>'>
               <%= render partial: 'accounts/pipelines/deal_event', locals: {event: deal.next_event_planned} %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

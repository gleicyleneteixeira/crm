<%= content_tag :li, id: dom_id(deal), data: { id: deal.id, account_id: Current.account.id, position: deal.position } , class: 'hover:shadow-sm select-none cursor-pointer' do %>
  <%= turbo_stream_from deal %>
  <div class="rounded border-2 color-border-default dark:border-gray-600 color-bg-fill-default dark:bg-gray-700 transition-colors duration-200" data-controller='load-lucid-icons'>
    <%= link_to account_deal_path(Current.account, deal.id), data: { turbo_frame: :_top }, class: 'flex flex-col gap-2 pt-2 px-4' do %>
      <% unless deal.open? %>
        <div class='w-full flex'>
          <%# STATUS: Cores sólidas e vibrantes %>
          <div class='inline-flex gap-1 items-center 
            <%= 'border-red-500 text-red-500 bg-red-500/10' if deal.lost? %>
            <%= 'border-green-500 text-green-500 bg-green-500/10' if deal.won? %> border rounded p-1 h-4'>
            <span class='typography-body-800 font-bold uppercase text-[10px] shadow-sm'>
              <%= Deal.human_enum_name(:status, deal.status) %>
            </span>
          </div>
        </div>
      <% end %>
      
      <div class="flex items-center gap-2">
        <% if deal.open? %>
           <div class="w-2.5 h-2.5 rounded-full bg-[#00FF00] shadow-[0_0_10px_#00FF00]"></div>
        <% end %>
        <p class="typography-body-900 color-fg-default dark:text-white font-bold text-[13px]">
          <%= deal.name %>
        </p>
      </div>
      <div class="w-full border-[0.5px] color-border-default dark:border-gray-600"></div>
    <% end %>

    <div class='flex items-center'>
      <%= link_to account_contact_path(Current.account, deal.contact), class: "cursor-pointer peer" , data: { turbo_frame: :drawer } do %>
        <div class='flex items-start py-2 pl-4 gap-1'>
          <svg class="w-4 h-4 color-fg-default dark:text-gray-300 mt-px shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
          </svg>
          <p class='typography-body-900 color-fg-soft dark:text-gray-200 hover:color-fg-default dark:hover:text-white break-all text-[12px] <%= dom_id(deal.contact, :stream_full_name) %>'>
            <%= deal.contact.full_name %>
          </p>
        </div>
      <% end %>
    </div>

    <div class='flex'>
      <div class='flex grow'>
        <% if deal.users.present? %>
          <div class='flex flex-col pb-2 pl-4'>
            <div class="flex -space-x-2">
              <% deal.users.order(id: :desc).limit(2).each do |user| %>
                <div class='w-5 h-5'>
                  <% if user.avatar_url.present? %>
                    <img class="w-5 h-5 rounded-full object-cover border-2 border-white dark:border-gray-500" src="<%= user.avatar_url %>">
                  <% else %>
                    <div class="w-5 h-5 flex items-center justify-center bg-gray-400 rounded-full border border-white dark:border-gray-500">
                      <i data-lucide="user" class="w-3 h-3 text-white"></i>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <% if !deal.total_amount_in_cents.zero? || deal.next_event_planned? %>
        <%= link_to account_deal_path(Current.account, deal.id), data: { turbo_frame: :_top } do %>
          <div class='flex items-center flex-wrap justify-end gap-2 pr-4 pb-2'>
            <%# VALOR: Branco sólido para máxima leitura %>
            <% unless deal.total_amount_in_cents.zero? %>
              <div class='inline-flex gap-1 items-center text-white font-bold h-5 bg-blue-600/20 px-1 rounded'>
                <i data-lucide="circle-dollar-sign" class="w-3.5 h-3.5 text-blue-400"></i>
                <span class='text-[11px]'>
                  <%= render 'components/formatters/currency', value: deal.total_amount_in_cents %>
                </span>
              </div>
            <% end %>

            <%# TEMPORIZADORES: Verde Neon e Vermelho Vibrante %>
            <% if deal.next_event_planned? %>
              <div class="flex items-center gap-1 font-black transition-colors">
                <div class="dark:text-[#00FF00] drop-shadow-[0_0_5px_rgba(0,255,0,0.5)]">
                   <%= render partial: 'accounts/pipelines/deal_event', locals: {event: deal.next_event_planned} %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

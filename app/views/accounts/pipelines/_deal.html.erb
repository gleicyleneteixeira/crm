<%= content_tag :li, id: dom_id(deal), data: { id: deal.id, account_id: Current.account.id, position: deal.position } , class: 'hover:shadow-sm select-none cursor-pointer' do %>
  <%= turbo_stream_from deal %>
  
  <div class="rounded-xl border border-slate-200/70 dark:border-slate-800 bg-white dark:bg-slate-950/70 dark:backdrop-blur-md transition-colors duration-200 px-3 pt-3 pb-2" data-controller='load-lucid-icons'>
    <% priority_classes =
         case deal.priority_level
         when 'low'
           'border-emerald-500 text-emerald-400 bg-emerald-500/10'
         when 'medium'
           'border-amber-400 text-amber-300 bg-amber-400/10'
         when 'high'
           'border-red-500 text-red-400 bg-red-500/10'
         else
           'border-slate-500 text-slate-400 bg-transparent'
         end %>

    <% owner =
         if deal.creator.present?
           deal.creator
         elsif deal.users.loaded? ? deal.users.any? : deal.users.exists?
           deal.users.first
         else
           nil
         end %>

    <%# NÍVEL 1: TÍTULO + BANDEIRA DE PRIORIDADE %>
    <div class="flex items-start justify-between gap-2">
      <div class="flex-1 min-w-0">
        <% unless deal.open? %>
          <div class='mb-1 inline-flex gap-1 items-center px-2 py-0.5 rounded text-[10px] font-black uppercase <%= deal.lost? ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700' %>'>
            <%= Deal.human_enum_name(:status, deal.status) %>
          </div>
        <% end %>

        <%= link_to account_deal_path(Current.account, deal.id), data: { turbo_frame: :_top } do %>
          <p class="text-sm font-semibold text-slate-900 dark:text-slate-100 leading-snug whitespace-normal break-words">
            <%= deal.name %>
          </p>
        <% end %>
      </div>

      <div class="flex-shrink-0">
        <details class="relative group">
          <summary class="list-none cursor-pointer">
            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-xs <%= priority_classes %>">
              <i data-lucide="flag" class="w-3 h-3"></i>
            </span>
          </summary>
          <div class="absolute right-0 mt-1 w-32 rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-lg z-10 py-1">
            <%= button_to account_deal_path(Current.account, deal),
                          method: :patch,
                          params: { deal: { priority_level: :low } },
                          form: { data: { turbo_stream: true } },
                          class: "w-full text-left px-3 py-1.5 text-xs flex items-center gap-2 text-emerald-500 hover:bg-slate-100 dark:hover:bg-slate-800" do %>
              <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Baixa</span>
            <% end %>
            <%= button_to account_deal_path(Current.account, deal),
                          method: :patch,
                          params: { deal: { priority_level: :medium } },
                          form: { data: { turbo_stream: true } },
                          class: "w-full text-left px-3 py-1.5 text-xs flex items-center gap-2 text-amber-400 hover:bg-slate-100 dark:hover:bg-slate-800" do %>
              <span class="inline-block w-2 h-2 rounded-full bg-amber-400"></span>
              <span>Média</span>
            <% end %>
            <%= button_to account_deal_path(Current.account, deal),
                          method: :patch,
                          params: { deal: { priority_level: :high } },
                          form: { data: { turbo_stream: true } },
                          class: "w-full text-left px-3 py-1.5 text-xs flex items-center gap-2 text-red-400 hover:bg-slate-100 dark:hover:bg-slate-800" do %>
              <span class="inline-block w-2 h-2 rounded-full bg-red-500"></span>
              <span>Alta</span>
            <% end %>
            <%= button_to account_deal_path(Current.account, deal),
                          method: :patch,
                          params: { deal: { priority_level: :none } },
                          form: { data: { turbo_stream: true } },
                          class: "w-full text-left px-3 py-1.5 text-xs flex items-center gap-2 text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800" do %>
              <span class="inline-block w-2 h-2 rounded-full border border-slate-500 rounded-full"></span>
              <span>Sem prioridade</span>
            <% end %>
          </div>
        </details>
      </div>
    </div>

    <%# NÍVEL 2: TRIBUTOS DINÂMICOS %>
    <div class="mt-2 flex flex-wrap gap-1.5">
      <% deal.account.custom_attribute_definitions.where(attribute_model: 'deal_attribute', show_in_card: true).each do |definition| %>
        <% key = definition.attribute_key %>
        <% value = deal.custom_attributes[key] %>
        <% next if value.blank? %>
        <div class="woo-pill-sky">
          <span class="truncate">
            <span class="font-semibold"><%= definition.attribute_display_name %>:</span>
            <span class="font-medium"> <%= value %></span>
          </span>
        </div>
      <% end %>
    </div>

    <%# NÍVEL 3: GRID VALOR + PRAZO / ATIVIDADE %>
    <div class="mt-3 flex items-center justify-between">
      <div>
        <% unless deal.total_amount_in_cents.zero? %>
          <div class='inline-flex items-center px-3 py-0.5 rounded-full bg-emerald-500/15 text-emerald-300 border border-emerald-500/40 font-semibold text-[11px]'>
            <%= render 'components/formatters/currency', value: deal.total_amount_in_cents %>
          </div>
        <% end %>
      </div>

      <div class="flex items-center">
        <% if deal.next_event_planned? %>
          <% event = deal.next_event_planned %>
          <% pill_classes =
               if event.overdue?
                 'bg-red-500/10 text-red-400 border-red-500/40'
               elsif event.scheduled_at&.to_date == Time.zone.today
                 'bg-amber-500/10 text-amber-300 border-amber-500/40'
               else
                 'bg-sky-500/10 text-sky-300 border-sky-500/40'
               end %>

          <details class="relative group">
            <summary class="list-none cursor-pointer">
              <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border text-[11px] font-medium <%= pill_classes %>">
                <i data-lucide="alarm-clock" class="w-3 h-3"></i>
                <span>
                  <%= render partial: 'accounts/pipelines/deal_event', locals: { event: event } %>
                </span>
              </div>
            </summary>
            <div class="absolute right-0 mt-1 w-40 rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-lg z-10 py-1 text-xs">
              <% if event.editable? %>
                <%= link_to edit_account_contact_event_path(event.account, event.contact, event, deal_id: event.deal_id),
                            class: "block px-3 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2" do %>
                  <i data-lucide="pencil" class="w-3 h-3"></i>
                  <span>Editar tarefa</span>
                <% end %>
              <% end %>

              <% if event.activity? %>
                <% if event.done? %>
                  <%= link_to account_contact_event_path(event.account, event.contact, event, deal_id: event.deal_id, event: { done: false }),
                              method: :put,
                              data: { confirm: t('views.accounts.contacts.events.event.are_you_sure?') },
                              class: "block px-3 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2" do %>
                    <i data-lucide="rotate-ccw" class="w-3 h-3"></i>
                    <span>Reabrir tarefa</span>
                  <% end %>
                <% else %>
                  <%= link_to account_contact_event_path(event.account, event.contact, event, deal_id: event.deal_id, event: { done: true }),
                              method: :put,
                              data: { confirm: t('views.accounts.contacts.events.event.are_you_sure?') },
                              class: "block px-3 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2" do %>
                    <i data-lucide="check" class="w-3 h-3"></i>
                    <span>Concluir tarefa</span>
                  <% end %>
                <% end %>
              <% end %>

              <%= link_to events_to_do_account_deal_path(deal.account, deal),
                          data: { turbo_frame: :modal },
                          class: "block px-3 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2" do %>
                <i data-lucide="list-checks" class="w-3 h-3"></i>
                <span>Ver tarefas do negócio</span>
              <% end %>
            </div>
          </details>
        <% else %>
          <%= link_to new_account_contact_event_path(Current.account,
                                                     deal.contact,
                                                     kind: 'activity',
                                                     pipeline: deal.pipeline,
                                                     deal_id: deal.id),
                      data: { turbo_frame: dom_id(Event.new) },
                      class: "inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border border-slate-500/40 text-[11px] text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800" do %>
            <i data-lucide="plus" class="w-3 h-3"></i>
            <span>Nova tarefa</span>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="mt-3 mb-2 w-full border-t border-slate-100/70 dark:border-slate-800"></div>

    <%# ANDAR FINAL: CONTATO À ESQUERDA E AVATAR DO PROPRIETÁRIO À DIREITA %>
    <div class='flex items-center justify-between'>
      <div class='flex items-center gap-2'>
        <%= link_to account_contact_path(Current.account, deal.contact), class: "cursor-pointer peer" , data: { turbo_frame: :drawer } do %>
          <div class='flex items-center gap-2 text-xs'>
            <i data-lucide="user" class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500"></i>
            <p class='text-xs font-medium text-slate-500 dark:text-slate-300 hover:text-slate-700 dark:hover:text-slate-100 <%= dom_id(deal.contact, :stream_full_name) %>'>
              <%= deal.contact.full_name %>
            </p>
          </div>
        <% end %>
      </div>

      <% if owner %>
        <div class="flex items-center justify-center">
          <% if owner.avatar.attached? %>
            <%= image_tag owner.avatar, class: "w-7 h-7 rounded-full object-cover border border-slate-700/40" %>
          <% elsif owner.avatar_url.present? %>
            <%= image_tag owner.avatar_url, class: "w-7 h-7 rounded-full object-cover border border-slate-700/40" %>
          <% else %>
            <div class="w-7 h-7 rounded-full bg-emerald-500 text-white text-[11px] flex items-center justify-center font-semibold">
              <%= owner.initials %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

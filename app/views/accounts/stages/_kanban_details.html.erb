<div class="flex items-center justify-between w-full mt-1">
  <%# Mantemos a lógica original de valor, mas com as novas cores %>
  <div class="text-blue-400 dark:text-blue-300 font-extrabold text-[13px] tracking-tight">
    <% if stage.deals_total_amount.present? %>
      <%= render 'components/formatters/currency', value: stage.deals_total_amount %>
    <% else %>
      R$ 0,00
    <% end %>
  </div>

  <%# Mantemos a lógica do contador, mas com o círculo branco destacado %>
  <div class="bg-slate-50 text-slate-900 min-w-[20px] h-5 px-1.5 rounded-full flex items-center justify-center text-[10px] font-black shadow-sm border border-slate-200">
    <%= stage.deals_count %>
  </div>
</div>

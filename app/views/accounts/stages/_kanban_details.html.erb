<div class="flex items-center justify-between w-full mt-1">
  <%# VALOR TOTAL: Forçando a cor preta (claro) e branca (escuro) %>
  <div class="text-black dark:text-gray-100 font-bold text-[13px] tracking-tight">
    <%= render 'components/formatters/currency', value: stage.deals_total_amount %>
  </div>

  <%# CONTADOR: Mantendo a estrutura original mas com cor nítida %>
  <div class="text-black dark:text-gray-200 text-[11px] font-black">
    <%= stage.deals_count %>
  </div>
</div>

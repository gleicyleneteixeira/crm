<%= turbo_stream_from deal %>
<li id="<%= dom_id(deal, :chatwoot_embed) %>" class="grid grid-cols-[1fr_40px] gap-4 p-4 border-x-2 border-b-2 border-light-palette-p3 odd:bg-light-palette-p4 even:bg-light-palette-p5">
  <div class="">
    <div class="flex justify-between items-start mb-2">
      <h5 class="typography-text-m-lh150 text-dark-gray-palette-p1 flex-1 pr-2"><%= deal.name %></h5>
      <% unless deal.total_amount_in_cents.zero? %>
        <div class='inline-flex items-center px-2 py-0.5 rounded-full font-bold text-[10px] min-w-[60px] min-h-[18px] opacity-0 transition-opacity duration-200' data-as-badge="true">
          <%= render 'components/formatters/currency', value: deal.total_amount_in_cents %>
        </div>
      <% end %>
    </div>

    <div class="flex flex-wrap gap-2 items-center mb-1" data-controller="load-lucid-icons">
      <% 
        priority_classes = case deal.priority_level
                         when 'low' then 'border-emerald-500 text-emerald-500 bg-emerald-500/10'
                         when 'medium' then 'border-amber-400 text-amber-500 bg-amber-400/10'
                         when 'high' then 'border-red-500 text-red-500 bg-red-500/10'
                         else 'border-slate-400 text-slate-400 bg-transparent'
                         end
      %>
      
      <details class="relative group">
        <summary class="list-none cursor-pointer outline-none">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-lg border text-[10px] font-bold uppercase <%= priority_classes %>">
            <i data-lucide="flag" class="w-3 h-3"></i>
          </span>
        </summary>
        <div class="absolute left-0 mt-1 w-28 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-xl z-[100] py-1 animate-in fade-in zoom-in-95 duration-150">
          <% [[:high, "Alta", "text-red-600"], [:medium, "Média", "text-amber-500"], [:low, "Baixa", "text-emerald-600"], [:none, "Nenhuma", "text-slate-500"]].each do |level, label, color_class| %>
            <%= button_to account_deal_path(deal.account, deal),
                          method: :patch,
                          params: { deal: { priority_level: level } },
                          form: { data: { turbo_stream: true } },
                          class: "w-full text-left px-3 py-1.5 text-[11px] font-semibold #{color_class} hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors" do %>
              <%= label %>
            <% end %>
          <% end %>
        </div>
      </details>

      <span class="text-slate-300 pb-0.5">|</span>

      <p class="typography-sub-text-m-lh150 text-dark-gray-palette-p3 text-[10px] uppercase font-bold">Etapa</p>
      <%= render 'accounts/pipelines/deal_event', event: deal.next_event_planned if deal.next_event_planned? %>
    </div>

    <%# Custom Fields (Dynamic) %>
    <div class="mb-3 flex flex-wrap gap-1.5">
      <% deal.account.custom_attribute_definitions.where(attribute_model: 'deal_attribute', show_in_card: true).each do |definition| %>
        <% value = deal.custom_attributes[definition.attribute_key] %>
        <% next if value.blank? %>
        <div class="bg-blue-50 dark:bg-slate-800/50 text-blue-600 dark:text-blue-300 px-1.5 py-0.5 rounded text-[9px] font-medium border border-blue-100 dark:border-slate-700/50">
          <span class="opacity-70"><%= definition.attribute_display_name %>:</span> <%= value %>
        </div>
      <% end %>
    </div>

    <%= render 'components/deals/stages_nav', deal: deal  %>
  </div>
  <%= link_to(account_deal_path(deal.account, deal.id), data: { turbo_frame: :_top }, class: "arrow-btn flex items-center p-2 border-2 rounded-md border-light-palette-p3 odd:bg-light-palette-p4 even:bg-light-palette-p5 hover:odd:bg-light-palette-p5 hover:even:bg-light-palette-p4 self-start cursor-pointer") do %>
    <i data-lucide="arrow-up-right" class="w-6 h-6 stroke-dark-gray-palette-p3"></i>
  <% end %>
</li>

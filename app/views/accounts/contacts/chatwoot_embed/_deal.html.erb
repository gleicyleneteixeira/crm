<%= turbo_stream_from deal %>
<li id="<%= dom_id(deal, :chatwoot_embed) %>" class="relative grid grid-cols-[1fr_40px] gap-4 p-4 border-x-2 border-b-2 border-light-palette-p3 odd:bg-light-palette-p4 even:bg-light-palette-p5" data-controller="load-lucid-icons">
  <div class="">
    <div class="flex justify-between items-start mb-2">
      <h5 class="typography-text-m-lh150 text-dark-gray-palette-p1 flex-1 pr-2"><%= deal.name %></h5>
      <% unless deal.total_amount_in_cents.zero? %>
        <div class='inline-flex items-center px-2 py-0.5 rounded-full font-bold text-[10px] min-w-[60px] min-h-[18px] opacity-0 transition-opacity duration-200' data-as-badge="true">
          <%= render 'components/formatters/currency', value: deal.total_amount_in_cents %>
        </div>
      <% end %>
    </div>

    <div class="flex flex-wrap gap-2 items-center mb-1">
      <% 
        priority_classes = case deal.priority_level
                         when 'low' then 'border-emerald-500 text-emerald-500 bg-emerald-500/10'
                         when 'medium' then 'border-amber-400 text-amber-500 bg-amber-400/10'
                         when 'high' then 'border-red-500 text-red-500 bg-red-500/10'
                         else 'border-slate-400 text-slate-400 bg-transparent'
                         end
      %>
      
      <div data-as-icon="true" class="opacity-0 transition-opacity">
        <details class="relative group">
          <summary class="list-none cursor-pointer outline-none">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-lg border text-[10px] font-bold uppercase <%= priority_classes %>">
              <i data-lucide="flag" class="w-3 h-3"></i>
            </span>
          </summary>
          <div class="absolute left-0 mt-1 w-28 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-xl z-[100] py-1 animate-in fade-in zoom-in-95 duration-150">
            <% [[:high, "Alta", "text-red-600"], [:medium, "Média", "text-amber-500"], [:low, "Baixa", "text-emerald-600"], [:none, "Nenhuma", "text-slate-500"]].each do |level, label, color_class| %>
              <%= button_to account_deal_path(deal.account, deal),
                            method: :patch,
                            params: { deal: { priority_level: level } },
                            form: { data: { turbo_stream: true } },
                            class: "w-full text-left px-3 py-1.5 text-[11px] font-semibold #{color_class} hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors" do %>
                <%= label %>
              <% end %>
            <% end %>
          </div>
        </details>
      </div>

      <span class="text-slate-300 pb-0.5">|</span>

      <p class="typography-sub-text-m-lh150 text-dark-gray-palette-p3 text-[10px] uppercase font-bold">Etapa</p>
      <% if deal.next_event_planned? %>
        <% event = deal.next_event_planned %>
        <% pill_classes =
             if event.overdue?
               'bg-red-500/10 text-red-400 border-red-500/40'
             elsif event.done?
               'bg-emerald-500/5 text-emerald-400 border-emerald-500/20'
             elsif event.scheduled_at&.to_date == Time.zone.today
               'bg-amber-500/10 text-amber-300 border-amber-500/40'
             else
               'bg-sky-500/10 text-sky-300 border-sky-500/40'
             end %>
        <div data-as-badge="true" class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full border text-[11px] font-medium <%= pill_classes %> opacity-0 transition-opacity whitespace-nowrap">
          <%= render "accounts/events/task_menu", event: event, show_date: true, minimal: true %>
        </div>
      <% else %>
        <%# Delicate Task Creation Trigger %>
        <div data-controller="task-creation-delicate" 
             data-task-creation-delicate-url-value="<%= account_contact_events_path(account_id: deal.account, contact_id: deal.contact.id, deal_id: deal.id) %>"
             class="relative inline-block">
          
          <button type="button" 
                  data-task-creation-delicate-target="trigger"
                  data-action="click->task-creation-delicate#toggle"
                  class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full border border-slate-500/40 text-[10px] text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all active:scale-95 opacity-0 whitespace-nowrap"
                  data-as-badge="true">
            <i data-lucide="plus" class="w-2.5 h-2.5 text-sky-400"></i>
            <span>Nova tarefa</span>
          </button>

          <%# THE DELICATE BOX (REDUCED) %>
          <div data-task-creation-delicate-target="form" 
               class="hidden w-[240px] bg-slate-900 border border-slate-700 rounded-xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] p-4 cursor-default pointer-events-auto transition-all duration-300 z-[2147483647]">
            
            <%= form_with model: Event.new, url: account_contact_events_path(account_id: deal.account, contact_id: deal.contact.id, deal_id: deal.id), method: :post, id: dom_id(Event.new, :chatwoot_delicate), data: { turbo: false } do |f| %>
              <%= f.hidden_field :contact_id, value: deal.contact.id %>
              <%= f.hidden_field :deal_id, value: deal.id %>
              
              <div class="flex flex-col gap-3">
                <div class="flex justify-between items-center mb-0.5">
                  <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Novo Agendamento</p>
                  <div class="flex gap-1.5">
                     <span class="w-2 h-2 rounded-full bg-sky-500"></span>
                     <span class="w-2 h-2 rounded-full bg-slate-700"></span>
                  </div>
                </div>
                
                <div class="space-y-2">
                  <%= f.text_field :title, 
                      class: "w-full text-xs h-9 px-3 bg-black/40 border border-slate-700/50 rounded-lg text-slate-100 placeholder:text-slate-600 focus:ring-1 focus:ring-sky-500/50 focus:border-sky-500/50 transition-all outline-none", 
                      placeholder: "O que agendar?", 
                      required: true,
                      data: { task_creation_delicate_target: "input" } %>
                  
                  <div class="relative">
                    <%= f.datetime_local_field :scheduled_at, 
                        value: Time.current.strftime("%Y-%m-%dT%H:%M"), 
                        class: "w-full text-xs h-9 px-3 bg-black/40 border border-slate-700/50 rounded-lg text-slate-100 focus:ring-1 focus:ring-sky-500/50 focus:border-sky-500/50 transition-all outline-none" %>
                  </div>
                </div>

                <div class="flex justify-end items-center gap-3 mt-1 pt-2 border-t border-slate-800">
                  <button type="button" 
                          data-action="click->task-creation-delicate#close" 
                          class="text-[11px] font-medium text-slate-400 hover:text-slate-200 transition-colors">
                    Cancelar
                  </button>
                  <%= f.submit "Criar", 
                      class: "bg-sky-600 hover:bg-sky-500 text-white text-[11px] font-bold px-4 py-1.5 rounded-lg shadow-lg shadow-sky-900/20 transition-all active:scale-95 cursor-pointer" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>

    <%# Custom Fields (Dynamic) %>
    <div class="mb-3 flex flex-wrap gap-1.5">
      <% deal.account.custom_attribute_definitions.where(attribute_model: 'deal_attribute', show_in_card: true).each do |definition| %>
        <% value = deal.custom_attributes[definition.attribute_key] %>
        <% next if value.blank? %>
        <div class="bg-blue-50 dark:bg-slate-800/50 text-blue-600 dark:text-blue-300 px-1.5 py-0.5 rounded text-[9px] font-medium border border-blue-100 dark:border-slate-700/50">
          <span class="opacity-70"><%= definition.attribute_display_name %>:</span> <%= value %>
        </div>
      <% end %>
    </div>

    <%= render 'components/deals/stages_nav', deal: deal  %>
  </div>
  <%= link_to(account_deal_path(deal.account, deal.id), data: { turbo_frame: :_top, as_icon: true }, class: "arrow-btn flex items-center p-2 border-2 rounded-md border-light-palette-p3 odd:bg-light-palette-p4 even:bg-light-palette-p5 hover:odd:bg-light-palette-p5 hover:even:bg-light-palette-p4 self-start cursor-pointer opacity-0 transition-opacity duration-300") do %>
    <i data-lucide="arrow-up-right" class="w-6 h-6 stroke-dark-gray-palette-p3"></i>
  <% end %>
</li>

<%= turbo_stream_from deal %>
<li id="<%= dom_id(deal) %>" class="grid grid-cols-[1fr_40px] gap-4 p-4 border-x-2 border-b-2 border-light-palette-p3 odd:bg-light-palette-p4 even:bg-light-palette-p5">
  <div class="">
    <div class="flex justify-between items-start mb-2">
      <h5 class="typography-text-m-lh150 text-dark-gray-palette-p1 flex-1 pr-2"><%= deal.name %></h5>
      <div id="<%= dom_id(deal, :status_badge) %>">
         <% if deal.won? %>
           <span class="text-[9px] font-extrabold text-green-700 tracking-tight bg-green-500/30 px-1.5 py-0.5 rounded shadow-[0_0_8px_rgba(74,222,128,0.4)] whitespace-nowrap">✓ GANHO</span>
         <% elsif deal.lost? %>
           <span class="text-[9px] font-extrabold text-red-700 tracking-tight bg-red-500/30 px-1.5 py-0.5 rounded shadow-[0_0_8px_rgba(248,113,113,0.4)] whitespace-nowrap">✕ PERDIDO</span>
         <% end %>
      </div>
      <% unless deal.total_amount_in_cents.zero? %>
        <div class='inline-flex items-center px-2 py-0.5 rounded-full font-bold text-[10px] min-w-[60px] min-h-[18px] opacity-0 transition-opacity duration-200' data-as-badge="true">
          <%= render 'components/formatters/currency', value: deal.total_amount_in_cents %>
        </div>
      <% end %>
    </div>

    <div class="flex flex-wrap gap-2 items-center mb-1">
      <% 
        priority_color = case deal.priority_level
                         when 'low' then 'text-emerald-500'
                         when 'medium' then 'text-amber-500'
                         when 'high' then 'text-red-500'
                         else 'text-slate-400'
                         end
      %>
      <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase <%= priority_color %>" title="<%= Deal.human_enum_name(:priority_level, deal.priority_level) %>">
        <i data-lucide="flag" class="w-3 h-3"></i>
      </span>

      <span class="text-slate-300">|</span>

      <p class="typography-sub-text-m-lh150 text-dark-gray-palette-p3 text-[10px] uppercase font-bold">Etapa</p>
      <%= render 'accounts/pipelines/deal_event', event: deal.next_event_planned if deal.next_event_planned? %>
    </div>

    <%# Custom Fields (Dynamic) %>
    <div class="mb-3 flex flex-wrap gap-1">
      <% deal.account.custom_attribute_definitions.where(attribute_model: 'deal_attribute', show_in_card: true).each do |definition| %>
        <% value = deal.custom_attributes[definition.attribute_key] %>
        <% next if value.blank? %>
        <div class="bg-blue-50 dark:bg-slate-800/50 text-blue-600 dark:text-blue-300 px-1.5 py-0.5 rounded text-[9px] font-medium border border-blue-100 dark:border-slate-700/50 truncate max-w-[120px]">
          <span class="opacity-70"><%= definition.attribute_display_name %>:</span> <%= value %>
        </div>
      <% end %>
    </div>

    <%= render 'components/deals/stages_nav', deal: deal  %>
  </div>
  <%= link_to(account_deal_path(deal.account, deal.id), data: { turbo_frame: :_top }, class: "arrow-btn flex items-center p-2 border-2 rounded-md border-light-palette-p3 odd:bg-light-palette-p4 even:bg-light-palette-p5 hover:odd:bg-light-palette-p5 hover:even:bg-light-palette-p4 self-start cursor-pointer") do %>
    <i data-lucide="arrow-up-right" class="w-6 h-6 stroke-dark-gray-palette-p3"></i>
  <% end %>
</li>

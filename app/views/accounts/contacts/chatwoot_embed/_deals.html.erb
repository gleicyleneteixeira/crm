<div>
  <header class="flex justify-between items-center p-4 bg-light-palette-p5 border-2 rounded-t-md border-light-palette-p3  text-dark-gray-palette-p3">
    <h4 class="typography-body-s-lh150">
      <%= t('activerecord.models.deal.other') %>
    </h4>
    <% deal_params = { contact_id: contact.id } %>
    <% if defined?(chatwoot_conversation_url) && chatwoot_conversation_url.present? %>
      <% deal_params[:chatwoot_conversation_url] = chatwoot_conversation_url %>
    <% end %>
    <%= link_to new_account_deal_path(current_user.account, deal: deal_params), class: 'btn-secondary' do %>
      <%= t('activerecord.models.deal.new') %>
    <% end %>
  </header>
  <ul id="chatwoot_embed_deals_list">
    <%# Cache v2 para forçar atualização das melhorias visuais %>
    <% cache ["chatwoot_embed_deals_list_v2", contact, Current.account.id] do %>
      <% contact.deals.each do | deal |  %>
        <%= render 'accounts/contacts/chatwoot_embed/deal', deal: deal %>
      <% end %>
    <% end %>
  </ul>
  <%# <div class="flex justify-center border-b-2 border-x-2 border-light-palette-p3 rounded-b-md bg-light-palette-p5 py-3 cursor-pointer hover:bg-light-palette-p4">
    <p class="typography-sub-text-m-lh150 text-dark-gray-palette-p3">ver mais</p>
  </div> %>
</div>

<% if deal.contact %>
  <%= turbo_frame_tag "events_to_do_#{deal.contact.id}" do %>
    <div id="events_to_do_list_<%= deal.contact.id %>">
      <% events.each do |event| %>
        <%= render partial: 'accounts/contacts/events/event', locals: { event: event, deal: deal } %>
      <% end %>
    </div>

    <%= turbo_frame_tag "pagination_events_to_do_#{deal.contact.id}" do %>
      <% if defined?(pagy) && pagy.is_a?(Pagy) && pagy.next.present? %>
        <div class="flex justify-center p-4">
          <%= link_to t('views.accounts.contacts.events.load_more'), events_to_do_account_deal_path(deal.account, deal, page: pagy.next, format: :turbo_stream), class: "btn-load-more text-[10px] font-bold text-slate-500 uppercase tracking-widest hover:text-brand-palette-03 transition-all", data: { turbo_stream: true } %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= turbo_frame_tag event do %>
  <% if event.deal_updates? %>
    <%= render 'accounts/contacts/events/event_deal_updated', event: event %>
  <% else %>
    <div class="group event-<%= event.scheduled_kind %> event-item-<%= event.from %> my-5" data-controller="load-lucid-icons load-flowbite">
      <% is_current_deal = defined?(deal) && event.deal_id.present? && event.deal_id == deal.id %>
      <div class="<%= event.has_media_attachment? ? 'w-[500px]' : 'w-[956px]' %> block rounded-lg bg-white border <%= is_current_deal ? 'border-brand-palette-03 ring-1 ring-brand-palette-03' : 'border-light-palette-p3' %> dark:bg-neutral-700 transition-all duration-200">
        <div class="border-b-2 border-neutral-100 bg-light-palette-p4 px-3 py-2 flex items-center space-x-3">
          <div class="flex items-center justify-center">
            <%= render "accounts/events/task_menu", event: event, show_date: false %>
          </div>

          <div class="flex-grow py-1">
            <div class="flex flex-col gap-1.5">
              <% if defined?(deal) && event.deal_id.present? %>
                <div class="flex items-center gap-2">
                  <% if event.deal_id != deal.id %>
                    <span class="px-2 py-0.5 rounded-full typography-micro-b-lh150 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                      Outro negócio
                    </span>
                  <% else %>
                    <span class="px-2 py-0.5 rounded-full typography-micro-b-lh150 bg-brand-palette-08 text-brand-palette-03 dark:bg-brand-palette-03/20 dark:text-brand-palette-06 font-bold flex items-center gap-1.5 border border-brand-palette-03/30 w-fit">
                      <i data-lucide="target" class="w-3 h-3"></i> O negócio atual
                    </span>
                  <% end %>
                </div>
              <% end %>

              <div class="flex items-center gap-2">
                <span class="m-0 text-dark-gray-palette-p1 typography-text-s-lh150 font-bold flex items-center gap-2">
                  <%= event.activity? ? event.title : Event.human_enum_name(:kind, event.kind) %>
                  <% if event.evolution_api_message? %>
                    <%= embedded_svg('icon-whtass.svg', {class: "w-3.5 fill-[#26D367]"})  %>
                  <% else %>
                    <i data-lucide="<%= event.icon_key %>" class="w-4 h-4 text-slate-400"></i>
                  <% end %>
                </span>
              </div>
            </div>

            <% if event.scheduled_at.present? %>
              <div class="m-0 <%= event.status_color %> group-[.event-scheduled]:font-semibold group-[.event-item-from-contacts]:text-dark-gray-palette-p4 flex items-center gap-1 mt-1">
                <%= render "components/formatters/datetime", value: event.primary_date, type: "compact" %>
              </div>
            <% else %>
              <%= render "components/formatters/datetime", value: event.primary_date, type: "compact", class_style: "m-0 typography-subtext-m-lh150 text-dark-gray-palette-p4 mt-1 block" %>
            <% end %>
          </div>

        </div>
        <div class="py-3 px-4 space-y-3 text-dark-gray-palette-p3 typography-text-m-lh200 break-words">
          <%= event.content %>
          <%= render 'accounts/contacts/events/attachment', event: event if event.attachment.present? %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

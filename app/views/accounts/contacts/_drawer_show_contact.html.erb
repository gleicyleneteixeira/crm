<%# ESTILO DE FORÇA BRUTA PARA MATAR O BRANCO RESTANTE %>
<style>
  /* Se o modo dark estiver ativo, força o fundo de todas as áreas brancas */
  .dark .bg-white, 
  .dark .color-bg-surface-default,
  .dark .drawer-content,
  .dark [data-drawer-target] { 
    background-color: #020617 !important; 
  }

  /* Garante que os cards internos fiquem um pouco mais claros que o fundo */
  .dark .bg-slate-50, 
  .dark .border-slate-100 {
    background-color: #0f172a !important;
    border-color: #1e293b !important;
  }
</style>

<div class="flex flex-col h-full bg-white dark:bg-slate-950 transition-colors duration-200">
  
  <%# CABEÇALHO %>
  <header class="flex items-center justify-between p-4 border-b border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
    <div class="flex items-center gap-2">
      <i data-lucide="user-circle" class="text-slate-400 dark:text-slate-300 w-6 h-6"></i>
      <h2 class="text-lg font-bold text-slate-800 dark:text-white uppercase tracking-tight">
        <%= t('activerecord.models.contact') %>
      </h2>
    </div>
    <button type="button" class="text-slate-400 hover:text-slate-600 dark:hover:text-white p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800" data-action="click->drawer#close">
      <i data-lucide="x" class="w-6 h-6"></i>
    </button>
  </header>

  <%# CONTEÚDO SCROLLÁVEL %>
  <div class="flex-1 overflow-y-auto p-4 bg-slate-50 dark:bg-slate-950">
    
    <%# MINI PERFIL DO CLIENTE %>
    <div class="flex items-center gap-4 mb-6 p-4 bg-white dark:bg-slate-900 rounded-lg border border-slate-100 dark:border-slate-800 shadow-sm">
      <div class="h-12 w-12 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center border border-slate-200 dark:border-slate-700">
        <i data-lucide="user" class="text-slate-400 dark:text-slate-300 w-6 h-6"></i>
      </div>
      <div>
        <h3 class="text-sm font-extrabold text-slate-800 dark:text-white uppercase">
          <%= contact.full_name %>
        </h3>
        <p class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">
          CPF: <%= contact.additional_attributes['cpf'].presence || '---' %>
        </p>
      </div>
    </div>

    <%# NAVEGAÇÃO INTERNA %>
    <nav class="flex gap-4 mb-6 border-b border-slate-200 dark:border-slate-800">
      <button class="pb-2 text-[11px] font-black uppercase tracking-widest border-b-2 border-blue-600 text-blue-600 dark:text-blue-400">
        Detalhes do Registro
      </button>
    </nav>

    <%# ÁREA ONDE ENTRA O CHATWOOT E OS NEGÓCIOS %>
    <div class="space-y-4">
      <%= yield :show_additional_content %>
      <%= yield %>
    </div>
  </div>

  <%# RODAPÉ COM BOTÃO DE EDIÇÃO %>
  <footer class="p-4 border-t border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900">
    <%= link_to edit_account_contact_path(Current.account, contact), class: 'flex items-center justify-center w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold text-xs tracking-widest shadow-lg transition-all active:scale-95' do %>
      <i data-lucide="pencil" class="w-4 h-4 mr-2"></i>
      EDITAR INFORMAÇÕES
    <% end %>
  </footer>
</div>

<div class="flex flex-col h-full bg-white dark:bg-slate-950 transition-colors duration-200">
  <%# ÁREA DE CONTEÚDO SCROLLÁVEL %>
  <div class="flex-1 overflow-y-auto p-4 bg-slate-50 dark:bg-slate-950">
    
    <%# MINI PERFIL DO CLIENTE %>
    <div class="mb-5 p-4 bg-white dark:bg-slate-900 rounded-lg border border-slate-100 dark:border-slate-800 shadow-sm">
      <div class="flex items-center gap-4">
        <div class="h-10 w-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
          <i data-lucide="user" class="text-slate-400 dark:text-slate-300 w-5 h-5"></i>
        </div>
        <div>
          <h3 class="text-sm font-bold text-slate-800 dark:text-white uppercase"><%= contact.full_name %></h3>
          <p class="text-[10px] text-slate-500 dark:text-slate-400">CPF: <%= contact.additional_attributes['cpf'] %></p>
        </div>
      </div>
    </div>

    <%# SEÇÃO CHATWOOT %>
    <% if Apps::Chatwoot.first.present? %>
      <div class="mb-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded shadow-sm">
        <header class="p-4 border-b border-slate-100 dark:border-slate-800">
          <h1 class="text-slate-800 dark:text-white font-bold text-xs uppercase tracking-widest">Chatwoot</h1>
        </header>
        <div class="p-4 grid grid-cols-1 gap-3">
          <p class="text-xs text-slate-500 dark:text-slate-400 uppercase">ID: <span class="text-slate-800 dark:text-white font-medium"><%= contact.additional_attributes['chatwoot_id'] %></span></p>
        </div>
      </div>
    <% end %>

    <%# SEÇÃO NEGÓCIOS (VERDES PRIMEIRO) %>
    <div class="mb-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded shadow-sm">
      <header class="p-4 border-b border-slate-100 dark:border-slate-800">
        <h1 class="text-slate-800 dark:text-white font-bold text-xs uppercase tracking-widest">Negócios</h1>
      </header>
      <ul class="p-4 space-y-3">
        <% ordered_deals = contact.deals.sort_by { |d| { 'open' => 1, 'won' => 2, 'lost' => 3 }[d.status] || 4 } %>
        <% ordered_deals.each do |deal| %>
          <li class="flex items-center justify-between pb-3 border-b border-slate-50 dark:border-slate-800 last:border-none">
            <div>
              <p class="text-sm font-semibold text-slate-800 dark:text-white"><%= deal.name %></p>
              <span class="text-[10px] font-black uppercase <%= deal.status == 'open' ? 'text-green-600 dark:text-green-400' : 'text-red-500' %>">
                ● <%= Deal.human_enum_name(:status, deal.status) %>
              </span>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>

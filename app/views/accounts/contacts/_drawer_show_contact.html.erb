<%# 1. TRAVA DE SEGURANÇA PARA AS CORES %>
<style>
  /* MODO DARK: Só ativa se a lua estiver selecionada */
  .dark .contact-drawer-content,
  .dark .bg-white, 
  .dark .bg-slate-50 {
    background-color: #0f172a !important; /* Azul Slate-900 para os cards */
    color: #f1f5f9 !important;
    border-color: #1e293b !important;
  }

  .dark .text-gray-900, .dark .text-gray-700 { color: #f1f5f9 !important; }
  .dark .text-gray-500 { color: #94a3b8 !important; } /* Slate-400 para rótulos */

  /* MODO CLARO (CLEAN): Força o branco original e garante o clique */
  body:not(.dark) .contact-drawer-content,
  body:not(.dark) .bg-white {
    background-color: #ffffff !important;
    color: #111827 !important;
  }
</style>

<%# 2. ESTRUTURA DA GAVETA (DRAWER) %>
<div class="contact-drawer-content flex flex-col h-full bg-white dark:bg-slate-950 transition-colors duration-200">
  
  <%# Cabeçalho: Mantém o ID e as ações originais para o fechar funcionar %>
  <header class="flex items-center justify-between p-4 border-b dark:border-slate-800">
    <h2 class="text-lg font-bold text-gray-900 dark:text-slate-100">Detalhes do Contato</h2>
    <button type="button" data-action="click->drawer#close" class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-slate-800 text-gray-400">
      <i data-lucide="x" class="w-6 h-6"></i>
    </button>
  </header>

  <%# Conteúdo com Scroll %>
  <div class="flex-1 overflow-y-auto p-4 space-y-6">
    
    <%# Card de Informações (O topo da sua foto) %>
    <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border dark:border-slate-800 shadow-sm">
      <div class="grid grid-cols-2 gap-y-4">
        <%# Exemplo de campo dinâmico %>
        <div>
          <span class="block text-xs font-bold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Nome Completo</span>
          <p class="text-sm text-gray-900 dark:text-slate-100"><%= @contact.full_name %></p>
        </div>
        <div>
          <span class="block text-xs font-bold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Telefone</span>
          <p class="text-sm text-gray-900 dark:text-slate-100"><%= @contact.phone %></p>
        </div>
      </div>
    </div>

    <%# Bloco Chatwoot (Onde está o azul na sua foto) %>
    <div class="bg-white dark:bg-slate-900 rounded-xl border dark:border-slate-800 overflow-hidden shadow-sm">
      <div class="p-3 bg-slate-50 dark:bg-slate-800/50 border-b dark:border-slate-800 flex items-center gap-2">
        <i data-lucide="message-square" class="w-4 h-4 text-blue-500"></i>
        <span class="font-bold text-sm dark:text-slate-200">Chatwoot</span>
      </div>
      <div class="p-4">
        <%# Conteúdo do Chatwoot %>
      </div>
    </div>

    <%# Bloco Negócios %>
    <div class="bg-white dark:bg-slate-900 rounded-xl border dark:border-slate-800 overflow-hidden shadow-sm">
      <div class="p-3 bg-slate-50 dark:bg-slate-800/50 border-b dark:border-slate-800 flex items-center gap-2">
        <i data-lucide="briefcase" class="w-4 h-4 text-blue-500"></i>
        <span class="font-bold text-sm dark:text-slate-200">Negócios</span>
      </div>
      <div class="p-2">
        <%# Aqui o sistema renderiza as linhas de negócios do contato %>
      </div>
    </div>

  </div>
</div>

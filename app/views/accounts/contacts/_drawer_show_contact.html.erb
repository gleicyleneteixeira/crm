<% content_for :show_additional_content do %>
  <% if chatwoot_configured? %>
    <%# Card do Chatwoot: Dinâmico (Branco no Claro / Azul Marinho no Escuro) %>
    <div class="mb-5 bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 rounded shadow-sm dark:shadow-none dark:backdrop-blur-md transition-colors" id="<%= "#{Apps::Chatwoot.model_name.human.downcase}-#{contact.class.name.downcase}" %>-section">
      <header class="flex flex-wrap items-center justify-between gap-2 p-4">
        <div class='flex items-center gap-2'>
          <i data-lucide="message-circle" class='text-slate-400 dark:text-slate-300 stroke-1.04 w-5 h-5 -rotate-[101deg]'></i>
          <h1 class='text-slate-800 dark:text-white font-bold typography-sub-title-900 '>
            <%= Apps::Chatwoot.model_name.human %>
          </h1>
        </div>
        <div class='flex items-center gap-2'>
          <button type="button" class="button-default-blank-secondary-icon-only-sm text-slate-400" data-accordion-target="#accordion-collapse-<%= "#{Apps::Chatwoot.model_name.human}-#{contact.class.name.downcase}-#{contact.object_id}"%>">
            <i data-accordion-icon data-lucide="chevron-down" class="shrink-0" height="16"></i>
          </button>
        </div>
      </header>
      
      <div class="p-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 border-t border-slate-200 dark:border-slate-700" id="accordion-collapse-<%= "#{Apps::Chatwoot.model_name.human}-#{contact.class.name.downcase}-#{contact.object_id}"%>">
        <div class='flex flex-col gap-1'>
          <p class='text-xs text-slate-500 dark:text-slate-400 font-semibold'><%= t("activerecord.attributes.contact.id") %></p>
          <p class='text-sm text-slate-800 dark:text-white break-all'><%= contact.additional_attributes['chatwoot_id'] %></p>
        </div>
        <div class='flex flex-col gap-1'>
          <p class='text-xs text-slate-500 dark:text-slate-400 font-semibold'><%= Contact.human_attribute_name(:chatwoot_identifier) %></p>
          <p class='text-sm text-slate-800 dark:text-white break-all'><%= contact.additional_attributes['chatwoot_identifier'] %></p>
        </div>
        <div class='flex flex-col gap-1'>
          <p class='text-xs text-slate-500 dark:text-slate-400 font-semibold'><%= Contact.human_attribute_name(:chatwoot_last_conversation) %></p>
          <div class='text-sm text-blue-600 dark:text-blue-400'><%= render '/components/links/chatwoot_conversation_link', contact: contact, display_format: 'text' %></div>
        </div>
        <div class='flex flex-col gap-1 col-span-full'>
          <p class='text-xs text-slate-500 dark:text-slate-400 font-semibold'><%= Contact.human_attribute_name(:chatwoot_conversations_label_list) %></p>
          <%= render 'components/list_labels', labels: contact.chatwoot_conversations_label_list, max_width: '100%', justify_content: 'start' %>
        </div>
      </div>
    </div>
  <% end %>

  <%# Card de Negócios: Com a Ordenação v1.0.2 (Abertos > Ganhos > Perdidos) %>
  <div class="mb-5 bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-white/10 rounded shadow-sm dark:shadow-none dark:backdrop-blur-md transition-colors" id="<%= "#{Deal.model_name.human(count: 2).downcase}-#{contact.class.name.downcase}" %>-section">
    <header class="flex flex-wrap items-center justify-between gap-2 p-4">
      <div class='flex items-center gap-2'>
        <i data-lucide="clipboard-list" class='text-slate-400 dark:text-slate-300 stroke-1.04 w-5 h-5'></i>
        <h1 class='text-slate-800 dark:text-white font-bold typography-sub-title-900 '>
          <%= Deal.model_name.human(count: 2) %>
        </h1>
      </div>
      <div class='flex items-center gap-2'>
        <button type="button" class="button-default-blank-secondary-icon-only-sm text-slate-400" data-accordion-target="#accordion-collapse-<%= "#{Deal.model_name.human(count: 2)}-#{contact.class.name.downcase}-#{contact.object_id}"%>">
          <i data-accordion-icon data-lucide="chevron-down" class="shrink-0" height="16"></i>
        </button>
      </div>
    </header>

    <ul class="p-4 flex flex-col gap-2 border-t border-slate-200 dark:border-slate-700" id="<%= dom_id(contact, :deals) %>">
      <% if contact.account %>
        <%= turbo_stream_from [contact.account.id, contact.id, :deals] %>
      <% end %>
      <%# Lógica de Ordenação: Aberto (1), Perdido/Cancelado (2), Ganho (3) %>
      <% ordered_deals = contact.deals.sort_by { |d| { 'open' => 1, 'lost' => 2, 'cancelled' => 2, 'won' => 3 }[d.status] || 4 } %>
      
      <% ordered_deals.each do |deal| %>
        <%= render 'accounts/deals/deal_row', deal: deal %>
      <% end %>
    </ul>
  </div>
<% end %>

<%# Sidebar Lateral %>
<% content_for :sidebar do %>
  <%= render 'components/show_model/sidebar', model: contact,
      links: [
        { label: t('activerecord.models.show'), icon: "info" },
        (chatwoot_configured? ? { label: Apps::Chatwoot.model_name.human, icon: "message-circle" } : nil),
        { label: t('activerecord.models.deal.other'), icon: "clipboard-list" }
      ].compact %>
<% end %>

<%= render 'components/show_model/show_model', model: contact, edit_path: edit_account_contact_path(Current.account, contact) %>

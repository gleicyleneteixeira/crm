<div class="flex flex-col h-full bg-white dark:bg-slate-950 transition-colors duration-200">
  <%# CABEÇALHO DA GAVETA %>
  <header class="flex items-center justify-between p-4 border-b border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
    <div class="flex items-center gap-2">
      <i data-lucide="user-circle" class="text-slate-400 dark:text-slate-300 w-6 h-6"></i>
      <h2 class="text-lg font-bold text-slate-800 dark:text-white uppercase tracking-tight">
        <%= t('activerecord.models.contact') %>
      </h2>
    </div>
    <button type="button" class="text-slate-400 hover:text-slate-600 dark:hover:text-white p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" data-action="click->drawer#close">
      <i data-lucide="x" class="w-6 h-6"></i>
    </button>
  </header>

  <%# CONTEÚDO PRINCIPAL %>
  <div class="flex-1 overflow-y-auto p-4 bg-slate-50 dark:bg-slate-950">
    
    <%# CARD DE DETALHES DO CONTATO %>
    <div class="mb-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded shadow-sm p-4">
       <div class="flex items-center gap-4">
          <div class="h-12 w-12 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
            <i data-lucide="user" class="text-slate-400 dark:text-slate-300 w-6 h-6"></i>
          </div>
          <div>
            <h3 class="text-sm font-extrabold text-slate-800 dark:text-white uppercase"><%= contact.full_name %></h3>
            <p class="text-[10px] text-slate-500 dark:text-slate-400">ID: <%= contact.id %></p>
          </div>
       </div>
    </div>

    <%# SEÇÃO CHATWOOT %>
    <% if Apps::Chatwoot.first.present? %>
      <div class="mb-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded shadow-sm">
        <header class="p-4 border-b border-slate-100 dark:border-slate-800">
          <h1 class="text-slate-800 dark:text-white font-bold text-sm uppercase tracking-wider">Chatwoot</h1>
        </header>
        <div class="p-4 space-y-3">
          <p class="text-xs text-slate-500 dark:text-slate-400 font-semibold uppercase">ID Chatwoot: <span class="text-slate-800 dark:text-white font-normal"><%= contact.additional_attributes['chatwoot_id'] %></span></p>
          <p class="text-xs text-slate-500 dark:text-slate-400 font-semibold uppercase">Identificador: <span class="text-slate-800 dark:text-white font-normal"><%= contact.additional_attributes['chatwoot_identifier'] %></span></p>
        </div>
      </div>
    <% end %>

    <%# SEÇÃO NEGÓCIOS (VERDES PRIMEIRO) %>
    <div class="mb-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded shadow-sm">
      <header class="p-4 border-b border-slate-100 dark:border-slate-800">
        <h1 class="text-slate-800 dark:text-white font-bold text-sm uppercase tracking-wider">Negócios</h1>
      </header>
      <ul class="p-4 space-y-2">
        <% ordered_deals = contact.deals.sort_by { |d| { 'open' => 1, 'won' => 2, 'lost' => 3 }[d.status] || 4 } %>
        <% ordered_deals.each do |deal| %>
          <li class="flex items-center justify-between py-2 border-b border-slate-50 dark:border-slate-800 last:border-none">
            <div>
              <p class="text-sm font-medium text-slate-800 dark:text-white"><%= deal.name %></p>
              <span class="text-[10px] font-black uppercase <%= deal.status == 'open' ? 'text-green-600 dark:text-green-400' : 'text-red-500' %>">
                ● <%= Deal.human_enum_name(:status, deal.status) %>
              </span>
            </div>
            <%= link_to account_deal_path(Current.account, deal), class: 'text-slate-400 hover:text-blue-600' do %>
              <i data-lucide="arrow-right" class="w-4 h-4"></i>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <%# RODAPÉ COM BOTÃO DE EDITAR %>
  <footer class="p-4 border-t border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900">
    <%= link_to edit_account_contact_path(Current.account, contact), class: 'flex items-center justify-center w-full py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold text-xs uppercase transition-all' do %>
      <i data-lucide="pencil" class="w-4 h-4 mr-2"></i>
      Editar Contato
    <% end %>
  </footer>
</div>

<%# 1. ESTILO GLOBAL PARA O FUNDO (Caso o container falhe) %>
<style>
  .dark .drawer-content, .dark .drawer-container { 
    background-color: #020617 !important; 
  }
</style>

<div class="flex flex-col h-full bg-white dark:bg-slate-950 transition-colors duration-200">
  
  <%# 2. CABEÇALHO DA GAVETA %>
  <header class="flex items-center justify-between p-4 border-b border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
    <div class="flex items-center gap-2">
      <i data-lucide="user" class="text-slate-400 w-5 h-5"></i>
      <h2 class="text-lg font-bold text-slate-800 dark:text-white">
        <%= t('activerecord.models.contact') %>
      </h2>
    </div>
    <button type="button" class="text-slate-400 hover:text-slate-600 dark:hover:text-white p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800" data-action="click->drawer#close">
      <i data-lucide="x" class="w-6 h-6"></i>
    </button>
  </header>

  <%# 3. ÁREA DE CONTEÚDO SCROLLÁVEL %>
  <div class="flex-1 overflow-y-auto p-4 bg-slate-50 dark:bg-slate-950">
    
    <%# MINI CARD DE IDENTIFICAÇÃO %>
    <div class="flex items-center gap-4 mb-6 p-4 bg-white dark:bg-slate-900 rounded-lg border border-slate-100 dark:border-slate-800 shadow-sm">
      <div class="h-12 w-12 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center border-2 border-slate-200 dark:border-slate-700">
        <i data-lucide="user-round" class="text-slate-400 dark:text-slate-300 w-6 h-6"></i>
      </div>
      <div>
        <h3 class="text-sm font-bold text-slate-800 dark:text-white uppercase leading-tight">
          <%= contact.full_name %>
        </h3>
        <p class="text-[10px] text-slate-500 dark:text-slate-400 font-mono mt-1">
          ID: <%= contact.id %> | CPF: <%= contact.additional_attributes['cpf'].presence || 'Não informado' %>
        </p>
      </div>
    </div>

    <%# NAVEGAÇÃO INTERNA %>
    <nav class="flex gap-4 mb-6 border-b border-slate-200 dark:border-slate-800">
      <button class="pb-2 text-xs font-bold uppercase tracking-wider border-b-2 border-blue-600 text-blue-600 dark:text-blue-400">
        Informações do Cliente
      </button>
    </nav>

    <%# 4. CONTEÚDO DINÂMICO (Aqui entra Detalhes, Chatwoot e Negócios) %>
    <div class="space-y-4">
      <%= yield :show_additional_content %>
      <%= yield %>
    </div>
  </div>

  <%# 5. RODAPÉ FIXO %>
  <footer class="p-4 border-t border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 mt-auto">
    <%= link_to edit_account_contact_path(Current.account, contact), class: 'flex items-center justify-center w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold text-sm shadow-sm transition-all active:scale-95' do %>
      <i data-lucide="pencil" class="w-4 h-4 mr-2"></i>
      EDITAR CONTATO
    <% end %>
  </footer>
</div>

<style>
  /* Mata o branco teimoso e aplica o Azul Marinho no modo Dark */
  .dark .show-model-container, 
  .dark .color-bg-surface-default,
  .dark .bg-white {
    background-color: #0f172a !important; 
    border-color: #1e293b !important;
  }

  /* Faz a escrita ficar branca no escuro e preta no claro automaticamente */
  .dark .color-fg-default, .dark .text-slate-800, .dark h1, .dark h2, .dark h3, .dark p, .dark span {
    color: #f8fafc !important; 
  }

  /* Ajusta rótulos (CPF, etc) para não sumirem no fundo azul */
  .dark .color-fg-soft, .dark .text-slate-500 {
    color: #94a3b8 !important;
  }
</style>

<%= render 'components/show_model/show_model', model: contact, edit_path: edit_account_contact_path(Current.account, contact) %>

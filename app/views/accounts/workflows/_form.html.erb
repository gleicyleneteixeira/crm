<%= form_with(model: [current_user.account, workflow], class: "space-y-6") do |f| %>
  <% if workflow.errors.any? %>
    <div class="bg-red-50 p-4 rounded-md">
      <div class="text-sm text-red-700">
        <ul>
          <% workflow.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Título da Automação", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= f.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm dark:bg-brand-palette-03 dark:border-gray-600 dark:text-white", placeholder: "Ex: Notificar Webhook ao Criar Negócio" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= f.label :trigger_type, "Quando (Gatilho)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <%= f.select :trigger_type, Workflow.available_triggers, { include_blank: "Selecione um gatilho" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm dark:bg-brand-palette-03 dark:border-gray-600 dark:text-white" %>
    </div>

    <div>
      <%= f.label :action_type, "Fazer (Ação)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <%= f.select :action_type, Workflow.available_actions, { include_blank: "Selecione uma ação" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm dark:bg-brand-palette-03 dark:border-gray-600 dark:text-white" %>
    </div>
  </div>

  <div class="bg-gray-50 dark:bg-brand-palette-03 p-4 rounded-md space-y-4">
    <h3 class="text-sm font-medium text-gray-900 dark:text-white">Configurações da Ação (JSON)</h3>
    <%= f.fields_for :data do |d| %>
      <p class="text-xs text-gray-500 dark:text-gray-400 mb-2">Configure os parâmetros da ação (ex: url, message, etc.)</p>
      <div class="space-y-2">
        <div>
          <label class="block text-xs text-gray-500">URL (para Webhooks)</label>
          <%= text_field_tag "workflow[data][url]", workflow.data['url'], class: "mt-1 block w-full rounded-md border-gray-300 text-sm dark:bg-brand-palette-04 dark:border-gray-600 dark:text-white" %>
        </div>
        <div>
          <label class="block text-xs text-gray-500">Mensagem (para WhatsApp)</label>
          <%= text_area_tag "workflow[data][message]", workflow.data['message'], class: "mt-1 block w-full rounded-md border-gray-300 text-sm dark:bg-brand-palette-04 dark:border-gray-600 dark:text-white" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="flex items-center">
    <%= f.check_box :active, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
    <%= f.label :active, "Automação Ativa", class: "ml-2 block text-sm text-gray-900 dark:text-white" %>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to 'Cancelar', account_workflows_path(current_user.account), class: "btn-secondary" %>
    <%= f.submit "Salvar Automação", class: "btn-primary" %>
  </div>
<% end %>

<%= turbo_frame_tag dom_id(@deal, :form_custom_attributes) do %>
  <%= form_with(model: @deal, url: account_deal_path(current_user.account, @deal), data: { turbo_frame: dom_id(@deal, :form_custom_attributes) }) do |form| %>
    
    <div class="h-full w-full space-y-4">
      
      <%# MÁGICA AQUI: Ele varre o banco e já mostra todos os campos de uma vez %>
      <% current_user.account.custom_attribute_definitions.where(attribute_model: 'deal').each do |definition| %>
        <div class="flex flex-col gap-1">
          
          <%# Nome do Campo (CPF, Banco, etc.) %>
          <label class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest">
            <%= definition.attribute_display_name %>
          </label>
          
          <%# Caixa de texto que já nasce aberta e salva sozinha ao sair do campo %>
          <input type="text" 
                 name="deal[custom_attributes][<%= definition.attribute_key %>]" 
                 value="<%= @deal.custom_attributes[definition.attribute_key] %>" 
                 class="w-full form-input bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700 text-sm rounded-md"
                 placeholder="Preencher..."
                 onblur="this.form.requestSubmit()">
        </div>
      <% end %>

    </div>
  <% end %>
<% end %>

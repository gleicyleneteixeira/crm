<tr id="deal_<%= deal.id %>" is='turbo-frame' class="border-b color-border-default dark:border-slate-800 last:border-none transition-colors duration-200" data-controller='load-lucid-icons'>
  <%# 1. ÍCONE %>
  <td class="py-2.5 pl-4 pr-4 flex-shrink-0">
    <div class="w-[52px] h-[52px] flex">
      <div class="border color-border-default bg-light-palette-p5 dark:bg-slate-800 dark:border-slate-700 rounded-md h-full w-full flex items-center justify-center">
        <%= embedded_svg("deals-icon.svg", class: "fill-dark-gray-palette-p3 dark:fill-slate-400 m-auto w-6 h-6") %>
      </div>
    </div>
  </td>
  
  <%# 2. NOME %>
  <td class="pr-4 py-2.5 typography-body-r-lh150 color-fg-default dark:text-slate-100 max-w-[350px] truncate">
    <%= deal.name %>
  </td>

  <%# 3. STATUS %>
  <td class="pr-4 py-2.5 typography-body-r-lh150 dark:text-slate-300 max-w-[100px] truncate">
    <span class="flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full <%= deal.status == 'open' ? 'bg-green-500' : (deal.status == 'won' ? 'bg-blue-500' : 'bg-red-500') %>"></span>
      <%= Deal.human_enum_name(:status, deal.status) %>
    </span>
  </td>

  <%# 4. ID %>
  <td class="pr-4 py-2.5 typography-body-r-lh150 color-fg-subtle dark:text-slate-400 max-w-[150px] truncate">
    <%= deal.id %>
  </td>

  <%# 5. ESTÁGIO %>
  <td class="pr-4 py-2.5 typography-body-r-lh150 color-fg-default dark:text-slate-300 max-w-[250px] truncate">
    <%= deal.stage&.name || "—" %>
  </td>

  <%# 6. VALOR %>
  <td class="pr-4 py-2.5 typography-body-r-lh150 color-fg-default dark:text-slate-100 max-w-[200px] truncate font-medium">
    <%= render 'components/formatters/currency', value: deal.total_amount_in_cents %>
  </td>

  <%# 7. PIPELINE %>
  <td class="pr-4 py-2.5 typography-body-r-lh150 color-fg-subtle dark:text-slate-400 max-w-[250px] truncate">
    <%= deal.pipeline&.name || "—" %>
  </td>

  <%# 8. CONTATO %>
  <td class="pr-4 py-2.5 max-w-[280px]">
    <%= render '/components/links/hovercard_trigger', model: deal.contact, hovercard_preview_url: hovercard_preview_account_contact_path(Current.account, deal.contact), details_url: account_contact_path(Current.account, deal.contact) do %>
      <p class='typography-sub-title-900 text-blue-600 dark:text-blue-400 hover:underline truncate'>
        <%= deal.contact&.full_name %>
      </p>
    <% end %>
  </td>

  <%# 9. CRIADOR %>
  <td class="pr-4 py-2.5 typography-body-r-lh150 color-fg-subtle dark:text-slate-400 max-w-[280px] truncate">
    <%= deal.creator&.full_name %>
  </td>

  <%# 10. DATA %>
  <td class="pr-4 py-2.5 typography-body-r-lh150 color-fg-subtle dark:text-slate-400 max-w-[250px] truncate">
    <%= l(deal.created_at, format: :short) %>
  </td>
  
  <%# 11. BOTÃO DE AÇÕES %>
  <td class="py-2.5 pl-4 pr-4 sticky right-0 bg-white dark:bg-slate-950 z-10 shadow-[-10px_0_15px_rgba(0,0,0,0.05)] dark:shadow-[-10px_0_15px_rgba(0,0,0,0.3)] border-l dark:border-slate-800">
    <div class="flex justify-end">
      <button id="dropdownuserBtn_<%= deal.id %>" data-dropdown-toggle="dropdownuserOptions<%= deal.id %>" class="color-fg-subtle dark:text-slate-400 hover:color-fg-default" type="button">
        <i data-lucide="more-vertical" class="w-5 h-5"></i>
      </button>
    </div>
  </td>
</tr>

<%# --- MENU SUSPENSO QUE ESTAVA FALTANDO --- %>
<div id="dropdownuserOptions<%= deal.id %>" class="z-50 hidden bg-white dark:bg-slate-800 divide-y divide-gray-100 dark:divide-slate-700 rounded-lg shadow-xl w-44 border dark:border-slate-700">
  <ul class="py-2 text-sm text-gray-700 dark:text-slate-200">
    <li>
      <%= link_to account_deal_path(Current.account, deal), data: { turbo_frame: :_top }, class: "block px-4 py-2 hover:bg-gray-100 dark:hover:bg-slate-700" do %>
        <%= t('activerecord.models.show') %>
      <% end %>
    </li>
    <li>
      <%= button_to account_deal_path(current_user.account, deal), method: :delete, data: { confirm: t('views.layouts.shared.navbar_deal.are_you_sure?') }, class: "w-full text-left block px-4 py-2 text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20", form: { style: "display:block" } do %>
        <%= t('activerecord.models.delete') %>
      <% end %>
    </li>
  </ul>
</div>

<%= content_tag :li, id: dom_id(deal, :drawer_row), class: "grid gap-5 border-b border-slate-100 dark:border-slate-800 last:border-none py-5 first:pt-0 last:pb-0", data: {controller: 'load-lucid-icons'} do %>
  <div class= "flex items-center gap-4">
    <div data-as-icon="true" class="h-10 w-10 flex items-center justify-center rounded-lg border-2 border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-slate-800/60 dark:backdrop-blur-lg text-slate-400 dark:text-slate-300 relative opacity-0 transition-opacity duration-300">
      <i data-lucide="clipboard-list" class='w-5 h-5'></i>
      <% 
        priority_color = case deal.priority_level
                         when 'low' then 'bg-emerald-500'
                         when 'medium' then 'bg-amber-400'
                         when 'high' then 'bg-red-500'
                         else 'bg-slate-400'
                         end
      %>
      <div class="absolute -top-1 -right-1 w-3 h-3 rounded-full border-2 border-white dark:border-slate-900 <%= priority_color %>" title="<%= Deal.human_enum_name(:priority_level, deal.priority_level) %>"></div>
    </div>
    <div class="mr-auto flex-1 min-w-0">
      <div class="flex flex-col">
        <div class="flex justify-between items-start gap-2">
          <h2 class="text-sm font-medium text-slate-800 dark:text-white truncate">
            <%= deal.name %>
          </h2>
          <% unless deal.total_amount_in_cents.zero? %>
            <div class='inline-flex items-center px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 font-bold text-[10px] whitespace-nowrap' data-as-badge="true">
              <%= render 'components/formatters/currency', value: deal.total_amount_in_cents %>
            </div>
          <% end %>
        </div>
        <div class="flex items-center gap-2 mt-0.5">
          <span class="text-[10px] uppercase font-bold <%= deal.status == 'open' ? 'text-green-600 dark:text-green-400' : (deal.status == 'won' ? 'text-blue-600 dark:text-blue-400' : 'text-red-500 dark:text-red-400') %>">
            ● <%= Deal.human_enum_name(:status, deal.status) %>
          </span>
          <% if deal.next_event_planned? %>
            <% event = deal.next_event_planned %>
            <%# Farol de Cores (Pill Strategy from Kanban) %>
            <% pill_classes =
                 if event.overdue?
                   'bg-red-500/10 text-red-400 border-red-500/40'
                 elsif event.done?
                   'bg-emerald-500/5 text-emerald-400 border-emerald-500/20'
                 elsif event.scheduled_at&.to_date == Time.zone.today
                   'bg-amber-500/10 text-amber-300 border-amber-500/40'
                 else
                   'bg-sky-500/10 text-sky-400 border-sky-500/30'
                 end %>
            <span class="text-slate-300 mx-1">|</span>
            <div data-as-badge="true" class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full border text-[11px] font-medium <%= pill_classes %> opacity-0 transition-opacity duration-300">
               <%= render "accounts/events/task_menu", event: event, show_date: true, minimal: true %>
            </div>
          <% else %>
            <% if deal.contact %>
              <span class="text-slate-300 mx-1">|</span>
              <%# Delicate Task Creation Trigger %>
              <div data-controller="task-creation-delicate" 
                   data-task-creation-delicate-url-value="<%= account_contact_events_path(account_id: deal.account, contact_id: deal.contact.id, deal_id: deal.id) %>"
                   class="relative inline-block">
              
              <button type="button" 
                      data-task-creation-delicate-target="trigger"
                      data-action="click->task-creation-delicate#toggle"
                      class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full border border-slate-500/40 text-[10px] text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all active:scale-95 opacity-0"
                      data-as-badge="true">
                <i data-lucide="plus" class="w-2.5 h-2.5 text-sky-400"></i>
                <span class="hidden sm:inline">Nova atividade</span>
              </button>

              <%# THE DELICATE BOX (REDUCED) %>
              <div data-task-creation-delicate-target="form" 
                   class="hidden w-[240px] bg-slate-900 border border-slate-700 rounded-xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] p-4 cursor-default pointer-events-auto transition-all duration-300">
                
                <%= form_with model: Event.new, url: account_contact_events_path(account_id: deal.account, contact_id: deal.contact.id, deal_id: deal.id), method: :post, data: { action: "submit->task-creation-delicate#submit" } do |f| %>
                  <%= f.hidden_field :contact_id, value: deal.contact.id %>
                  <%= f.hidden_field :deal_id, value: deal.id %>
                  <%= f.hidden_field :kind, value: 'activity' %>
                  <div class="flex flex-col gap-3">
                    <div class="flex justify-between items-center mb-0.5">
                      <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Novo Agendamento</p>
                      <div class="flex gap-1.5">
                         <span class="w-2 h-2 rounded-full bg-sky-500"></span>
                         <span class="w-2 h-2 rounded-full bg-slate-700"></span>
                      </div>
                    </div>
                    
                    <div class="space-y-2">
                      <%= f.text_field :title, 
                          class: "w-full text-xs h-9 px-3 bg-black/40 border border-slate-700/50 rounded-lg text-slate-100 placeholder:text-slate-600 focus:ring-1 focus:ring-sky-500/50 focus:border-sky-500/50 transition-all outline-none", 
                          placeholder: "O que agendar?", 
                          data: { task_creation_delicate_target: "input" } %>
                      
                      <div class="relative">
                        <%= f.datetime_local_field :scheduled_at, 
                            value: Time.current.strftime("%Y-%m-%dT%H:%M"), 
                            class: "w-full text-xs h-9 px-3 bg-black/40 border border-slate-700/50 rounded-lg text-slate-100 focus:ring-1 focus:ring-sky-500/50 focus:border-sky-500/50 transition-all outline-none" %>
                      </div>
                    </div>

                    <div class="flex justify-end items-center gap-3 mt-1 pt-2 border-t border-slate-800">
                      <button type="button" 
                              data-action="click->task-creation-delicate#close" 
                              class="text-[11px] font-medium text-slate-400 hover:text-slate-200 transition-colors">
                        Cancelar
                      </button>
                      <%= f.submit "Criar", 
                          class: "bg-sky-600 hover:bg-sky-500 text-white text-[11px] font-bold px-4 py-1.5 rounded-lg shadow-lg shadow-sky-900/20 transition-all active:scale-95 cursor-pointer" %>
                    </div>
              </div>
            <% end %>
          <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="flex items-center gap-2 mt-1 px-1" id="<%= dom_id(deal, :drawer_stage_name) %>">
          <div data-as-icon="true" class="opacity-0 transition-opacity">
            <i data-lucide="layers" class="w-3 h-3 text-slate-400"></i>
          </div>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wider">
            Etapa: <span class="text-slate-700 dark:text-slate-200"><%= deal.stage&.name %></span>
          </span>
        </div>

        <%# Progress Bar (Visual Pipeline) %>
        <div class="mt-3" id="<%= dom_id(deal, :drawer_stage_nav) %>">
          <%= render 'components/deals/stages_nav', deal: deal %>
        </div>

        <%# Custom Fields (Dynamic) %>
        <div class="mt-2 flex flex-wrap gap-1">
          <% deal.account.custom_attribute_definitions.where(attribute_model: 'deal_attribute', show_in_card: true).each do |definition| %>
            <% value = deal.custom_attributes[definition.attribute_key] %>
            <% next if value.blank? %>
            <div class="bg-slate-50 dark:bg-slate-800/40 text-slate-500 dark:text-slate-400 px-1.5 py-0.5 rounded text-[9px] font-medium border border-slate-200 dark:border-slate-700/50 truncate max-w-[150px]">
              <span class="opacity-70"><%= definition.attribute_display_name %>:</span> <%= value %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <%= link_to account_deal_path(deal.account, deal), data: { turbo_frame: :_top, as_icon: 'true' }, class: 'flex items-center justify-center rounded text-slate-400 w-8 h-8 hover:bg-slate-100 dark:hover:bg-slate-700 transition-opacity duration-300 opacity-0' do %>
      <i data-lucide="arrow-right" class="w-5 h-5"></i>
    <% end %>
  </div>
<% end %>

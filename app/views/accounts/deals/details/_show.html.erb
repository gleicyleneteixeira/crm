<%= turbo_frame_tag dom_id(model, :deal_show_page_overview) do %>
  <% if model.is_a?(Deal) %>
    <div class="mb-4 flex flex-col gap-2" data-controller="load-lucid-icons">
      <% if model.open? %>
        <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] gap-2">
          <%= link_to mark_as_won_account_deal_path(Current.account, model),
                      data: { turbo_frame: :modal },
                      class: "deal-outcome-button-won" do %>
            <i data-lucide="trophy" class="w-4 h-4"></i>
            <span>Ganho</span>
          <% end %>
          <%= link_to mark_as_lost_account_deal_path(Current.account, model),
                      data: { turbo_frame: :modal },
                      class: "deal-outcome-button-lost" do %>
            <i data-lucide="x-circle" class="w-4 h-4"></i>
            <span>Perdido</span>
          <% end %>
          <details class="relative">
            <summary class="deal-outcome-menu-button">
              <i data-lucide="more-vertical" class="w-4 h-4"></i>
            </summary>
            <div class="absolute right-0 mt-1 w-40 rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-lg z-30 py-1">
              <%= button_to account_deal_path(Current.account, model),
                            method: :delete,
                            form: { data: { turbo_confirm: t('views.layouts.shared.navbar_deal.are_you_sure?') } },
                            class: "w-full text-left px-3 py-1.5 text-xs text-red-600 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2" do %>
                <i data-lucide="trash-2" class="w-3 h-3"></i>
                <span>Excluir negócio</span>
              <% end %>
            </div>
          </details>
        </div>
      <% else %>
        <div class="rounded-md border border-slate-200 dark:border-slate-700 px-3 py-2 flex items-center justify-between text-xs text-slate-600 dark:text-slate-300">
          <span>
            <%= t("views.layouts.shared.navbar_deal.deal_#{model.status}") %>
          </span>
          <%= button_to account_deal_path(Current.account, model, deal: { status: 'open'} ),
                        method: :patch,
                        form: { data: { turbo_confirm: t('views.layouts.shared.navbar_deal.are_you_sure?') } },
                        class: "button-default-primary-xs px-2 py-1 text-[11px]" do %>
            <span>Reabrir</span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="flex items-center py-4 justify-between gap-1.5 relative" data-controller="load-lucid-icons load-flowbite">
    <div class='flex items-center gap-2.5 '>
      <div class="flex items-center gap-2 text-dark-gray-palette-p1">
        <i data-lucide=<%= model.class.name.downcase == 'contact' ? 'phone' : 'info' %> class='w-5 h-5 stroke-1.04'></i>
        <p class="typography-body-s-lh150 ">
          <%= t("activerecord.models.#{model.class.name.downcase}.one") %>
        </p>
      </div>
      <% if model.is_a?(Contact) %>
        <%= render '/components/links/chatwoot_conversation_link', contact: model %>
      <% elsif model.is_a?(Deal) && Apps::Chatwoot.first.present? %>
        <% if model.chatwoot_conversation_url.present? %>
          <%= link_to model.chatwoot_conversation_url,
                      target: :_blank,
                      class: "flex items-center justify-center w-5 h-5 text-[#7CC7F7] hover:text-[#369EF2]",
                      data: { turbo: false, controller: 'iframe-redirect', action: 'iframe-redirect#redirect' } do %>
            <i data-lucide="message-circle" class="-rotate-[101deg] w-4 h-4"></i>
          <% end %>
        <% else %>
          <details class="relative group" data-controller="chatwoot-url-popup">
            <summary class="list-none cursor-pointer flex items-center justify-center w-5 h-5 text-slate-400 hover:text-slate-200">
              <i data-lucide="message-circle" class="-rotate-[101deg] w-4 h-4"></i>
            </summary>
            <div class="fixed inset-0 z-50 flex items-center justify-center">
              <div class="w-80 max-w-sm rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-lg p-3">
                <p class="mb-2 text-xs text-slate-500 dark:text-slate-400">
                  Cole a URL da conversa do Chatwoot para este negócio.
                </p>
                <%= form_with model: model,
                              url: account_deal_path(Current.account, model),
                              method: :patch,
                              data: { turbo_frame: dom_id(model) } do |form| %>
                  <div class="flex flex-col gap-2">
                    <%= form.text_field :chatwoot_conversation_url,
                                        placeholder: "https://seu.chatwoot.com/app/accounts/...",
                                        class: "form-input h-8 px-2 py-1 text-xs",
                                        data: { chatwoot_url_popup_target: "input" } %>
                    <div class="flex justify-end">
                      <%= form.button "Salvar",
                                      type: :submit,
                                      class: "button-default-primary-xs px-2 py-1 text-[11px]" %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </details>
        <% end %>
      <% end %>
    </div>
    <div class='flex gap-2'>
      <button type="button" class="button-default-blank-secondary-icon-only-sm" data-accordion-target="#accordion-collapse-<%= "#{model.class.name.downcase}_#{model.id}"%>" aria-expanded="true" aria-controls="accordion-collapse-<%= "#{model.class.name.downcase}_#{model.id}"%> ">
        <i data-accordion-icon data-lucide="chevron-down" class="rotate-180 shrink-0" height="16"></i>
      </button>
    </div>
  </div>
  <div id="accordion-collapse-<%= "#{model.class.name.downcase}_#{model.id}"%>" class="hidden grid sm:grid-cols-2 gap-4 pb-4" aria-labelledby="accordion-collapse-heading-<%= "#{model.class.name.downcase}_#{model.id}"%>">
    <% model.class::SHOW_FIELDS.slice(:deal_page_overview_details).each do | show_field_category |  %>
      <% show_field_category[1].each do | show_field |  %>
        <% if show_field.is_a?(Hash) && show_field.key?(:relations) %>
          <% show_field[:relations].each do |relation_name, field| %>
            <% if relation_name == :stage && model.is_a?(Deal) && defined?(update_path) && update_path.present? %>
              <% stages_for_select = Stage.ordered_by_pipeline_and_position %>
              <div
                class="flex flex-col col-span-full"
                data-controller="stage-inline-edit"
                data-stage-inline-edit-update-url-value="<%= update_path %>"
                data-stage-inline-edit-model-key-value="<%= model.model_name.param_key %>">
                <p class='typography-text-s-lh150 text-gray-pallete-p3'>
                  <%= t("activerecord.attributes.#{model.model_name.i18n_key}.#{relation_name}") %>
                </p>
                <select
                  class="w-full bg-white/80 dark:bg-slate-800/80 border border-slate-300 dark:border-slate-700 rounded px-2 py-1 typography-sub-text-m-lh150 text-dark-gray-palette-p1 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500"
                  data-stage-inline-edit-target="input"
                  data-action="change->stage-inline-edit#submit">
                  <% stages_for_select.each do |stage| %>
                    <option value="<%= stage.id %>" <%= 'selected' if stage.id == model.stage_id %>>
                      <%= "#{stage.pipeline.name} - #{stage.name}" %>
                    </option>
                  <% end %>
                </select>
              </div>
            <% else %>
              <div class="flex flex-col col-span-full">
                <p class='typography-text-s-lh150 text-gray-pallete-p3'>
                  <%= t("activerecord.attributes.#{model.model_name.i18n_key}.#{relation_name}") %>
                </p>
                <p class='typography-sub-text-m-lh150 text-dark-gray-palette-p1 break-all'>
                  <%= model.send(relation_name)&.send(field) %>
                </p>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <% unless show_field.in?([:chatwoot_conversations_label_list]) && model.send(show_field).blank? %>
            <div class="flex flex-col col-span-full">
              <p class='typography-text-s-lh150 text-gray-pallete-p3'>
                <%= t("activerecord.attributes.#{model.model_name.i18n_key}.#{show_field}") %>
              </p>
              <% if show_field.in?([:label_list, :chatwoot_conversations_label_list]) %>
                <%= render 'components/list_labels', labels: model.send(show_field), max_width: '100%', justify_content: 'start' %>
              <% else %>
                <% inline_attribute_name = (show_field == :total_amount_in_cents && model.class.name == 'Deal') ? :manual_amount_in_cents : show_field %>
                <div
                  class="group flex items-center gap-1"
                  data-controller="<%= defined?(update_path) && update_path.present? ? 'inline-edit' : '' %>"
                  data-inline-edit-update-url-value="<%= defined?(update_path) && update_path.present? ? update_path : '' %>"
                  data-inline-edit-model-key-value="<%= model.model_name.param_key %>"
                  data-inline-edit-attribute-name-value="<%= inline_attribute_name %>">
                  <div
                    class="typography-sub-text-m-lh150 text-dark-gray-palette-p1 break-all cursor-pointer"
                    data-inline-edit-target="display"
                    data-action="click->inline-edit#activate">
                    <% if show_field == :total_amount_in_cents %>
                      <%= render 'components/formatters/currency', value: model.send(show_field), class_style: 'stream_deal_total_amount_in_cents' %>
                    <% else %>
                      <p>
                        <%= model.send(show_field) %>
                      </p>
                    <% end %>
                  </div>
                  <% if defined?(update_path) && update_path.present? %>
                    <button
                      type="button"
                      class="opacity-0 group-hover:opacity-100 transition-opacity text-slate-400 hover:text-slate-200 flex items-center justify-center"
                      data-inline-edit-target="pencil"
                      data-action="click->inline-edit#activate">
                      <i data-lucide="pencil" class="w-3 h-3"></i>
                    </button>
                    <input
                      type="text"
                      class="hidden w-full typography-sub-text-m-lh150 text-dark-gray-palette-p1 break-all bg-white/80 dark:bg-slate-800/80 border border-slate-300 dark:border-slate-700 rounded px-2 py-1 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500"
                      data-inline-edit-target="input"
                      data-action="blur->inline-edit#submit keydown->inline-edit#handleKeydown"
                      name="<%= "#{model.model_name.param_key}[#{inline_attribute_name}]" %>"
                      value="<%= inline_attribute_name == :manual_amount_in_cents && model.respond_to?(:manual_amount_in_cents) ? (model.manual_amount_in_cents || 0) : model.send(inline_attribute_name) %>">
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
      <% if model.class == Deal %>
        <% if model.lost_at.present? %>
          <div class="flex flex-col col-span-full">
            <p class='typography-text-s-lh150 text-gray-pallete-p3'>
              <%= t("activerecord.attributes.deal.lost_at") %>
            </p>
            <p class='typography-sub-text-m-lh150 text-dark-gray-palette-p1 break-all'>
              <%= render 'components/formatters/datetime', value: model.lost_at, type: "short" %>
            </p>
          </div>
        <% end %>
        <% if model.lost_reason.present? %>
          <div class="flex flex-col col-span-full">
            <p class='typography-text-s-lh150 text-gray-pallete-p3'>
              <%= t("activerecord.attributes.deal.lost_reason") %>
            </p>
            <p class='typography-sub-text-m-lh150 text-dark-gray-palette-p1 break-all'>
              <%= model.lost_reason %>
            </p>
          </div>
        <% end %>
        <% if model.won_at.present? %>
          <div class="flex flex-col col-span-full">
            <p class='typography-text-s-lh150 text-gray-pallete-p3'>
              <%= t("activerecord.attributes.deal.won_at") %>
            </p>
            <p class='typography-sub-text-m-lh150 text-dark-gray-palette-p1 break-all'>
              <%= render 'components/formatters/datetime', value: model.won_at, type: "short" %>
            </p>
          </div>
        <% end %>
      <% end %>
      <%= render 'accounts/deals/details/show_custom_attributes',
                 model: model,
                 update_path: (defined?(update_path) ? update_path : nil) %>
    <% end %>
  </div>
<% end %>

<% if @deal.previous_changes.key?(:stage_id) %>
  <% old_stage_id, new_stage_id = @deal.previous_changes[:stage_id] %>

  <%= turbo_stream.remove dom_id(@deal) %>
  <%= turbo_stream.append dom_id(Stage.find(new_stage_id), :deals) do %>
    <%= render 'accounts/pipelines/deal', deal: @deal %>
  <% end %>

  <% ['all', @deal.status].each do |status| %>
    <%= turbo_stream.replace "stage-#{old_stage_id}-#{status}-kaban-details" do %>
      <%= render 'accounts/stages/kanban_details', stage: Stage.find(old_stage_id), filter_status_deal: status %>
    <% end %>
    <%= turbo_stream.replace "stage-#{new_stage_id}-#{status}-kaban-details" do %>
      <%= render 'accounts/stages/kanban_details', stage: Stage.find(new_stage_id), filter_status_deal: status %>
    <% end %>
  <% end %>
<% end %>

<%# ATUALIZAÇÃO DO DETALHE DO NEGÓCIO (EMBED E SHOW) %>
<%= turbo_stream.replace dom_id(@deal, :chatwoot_embed), partial: 'accounts/contacts/chatwoot_embed/deal', locals: { deal: @deal } %>

<%= turbo_stream.replace dom_id(@deal, :deal_show_page_overview) do %>
  <%= render '/accounts/deals/details/show',
             model: @deal,
             update_path: account_deal_path(current_user.account, @deal) %>
<% end %>

<%= turbo_stream.replace 'stages_nav' do %>
  <%= render "/components/deals/stages_nav", deal: @deal %>
<% end %>

<%= turbo_stream.replace 'stages_nav_desktop' do %>
  <%= render "/accounts/deals/stages_nav_desktop", deal: @deal %>
<% end %>

<%= turbo_stream.replace dom_id(@deal, :form) do %>
  <%= render '/accounts/deals/details/show',
             model: @deal,
             update_path: account_deal_path(current_user.account, @deal) %>
<% end %>

<%= turbo_stream.replace dom_id(@deal) do %>
  <%= render 'accounts/pipelines/deal', deal: @deal %>
<% end %>

<%= turbo_stream.replace 'navbar_deal' do %>
  <%= render "/layouts/shared/navbar_show_deal", deal: @deal %>
<% end %>

<%# LÓGICA DE FINALIZAÇÃO (WIN / LOSS) %>
<% if @deal.previous_changes.key?(:status) %>
  <% if @deal.won? %>
    <%= turbo_stream.append "app" do %>
      <div data-controller="confetti"></div>
    <% end %>
    <%= turbo_stream.update :flash_message, partial: "components/flash_message", locals: { message: "Parabéns! 🥳 Negócio ganho!", type: :success } %>
  <% elsif @deal.lost? %>
    <%= turbo_stream.update :flash_message, partial: "components/flash_message", locals: { message: "Que pena! 😢 Fica para a próxima. Negócio perdido.", type: :error } %>
  <% end %>

  <% if @deal.won? || @deal.lost? %>
    <%= turbo_stream.remove 'modal' %>
  <% end %>
<% else %>
  <%# Se não houve mudança de status para finalizado, apenas limpa o modal normalmente se necessário %>
  <%= turbo_stream.replace :modal do %>
    <%= turbo_frame_tag :modal %>
  <% end %>
<% end %>

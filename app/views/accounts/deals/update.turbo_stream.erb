<%# Lógica de atualização local via formulário (Feedback Imediato) %>

<%# Navbar e Outros elementos de navegação que podem não estar nos canais globais %>
<%= turbo_stream.replace 'stages_nav' do %>
  <%= render "/components/deals/stages_nav", deal: @deal %>
<% end %>

<%= turbo_stream.replace 'stages_nav_desktop' do %>
  <%= render "/accounts/deals/stages_nav_desktop", deal: @deal %>
<% end %>

<%# ATUALIZAÇÃO IMEDIATA (FEEDBACK INSTANTÂNEO) %>
<%= turbo_stream.replace dom_id(@deal, :deal_show_page_overview) do %>
  <%= render '/accounts/deals/details/show',
             model: @deal,
             update_path: account_deal_path(current_user.account, @deal) %>
<% end %>

<%= turbo_stream.replace dom_id(@deal) do %>
  <%= render 'accounts/pipelines/deal', deal: @deal %>
<% end %>

<%# ATUALIZAÇÃO CIRÚRGICA (SHALLOW UPDATE) PARA VELOCIDADE MÁXIMA NA GAVETA %>
<%= turbo_stream.update dom_id(@deal, :drawer_stage_name) do %>
  <i data-lucide="layers" class="w-3 h-3 text-slate-400"></i>
  <span class="text-[10px] text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wider">
    Etapa: <span class="text-slate-700 dark:text-slate-200"><%= @deal.stage&.name %></span>
  </span>
<% end %>

<%= turbo_stream.update dom_id(@deal, :drawer_stage_nav) do %>
  <%= render 'components/deals/stages_nav', deal: @deal %>
<% end %>

<%= turbo_stream.replace dom_id(@deal, :chatwoot_embed), partial: 'accounts/contacts/chatwoot_embed/deal', locals: { deal: @deal } %>

<%# Scripts de reinicialização (essencial para o DOM local) %>
<%= turbo_stream.append_all "body" do %>
  <script data-turbo-cache="false">
    if (typeof initFlowbite === 'function') { initFlowbite(); }
    if (typeof lucide !== 'undefined') { lucide.createIcons(); }
  </script>
<% end %>

<%# Navbar update removed to prevent layout regression and redundant buttons %>


<%# LÓGICA DE FINALIZAÇÃO (WIN / LOSS) %>
<% if @deal.previous_changes.key?(:status) %>
  <% if @deal.won? %>
    <%= turbo_stream.update :flash_message, partial: "components/flash_message", locals: { message: "Negócio ganho!", type: :success } %>
  <% elsif @deal.lost? %>
    <%= turbo_stream.update :flash_message, partial: "components/flash_message", locals: { message: "Negócio perdido.", type: :error } %>
  <% end %>

  <% if @deal.won? || @deal.lost? %>
    <%= turbo_stream.remove 'modal' %>
  <% end %>
<% else %>
  <%# Se não houve mudança de status para finalizado, apenas limpa o modal normalmente se necessário %>
  <%= turbo_stream.replace :modal do %>
    <%= turbo_frame_tag :modal %>
  <% end %>
<% end %>

<%# FORÇA O FUNDO ESCURO EM TUDO PARA MATAR A PARTE BRANCA EXTERNA %>
<style>
  .dark body, .dark .app-wrapper, .dark #main-content { 
    background-color: #020617 !important; 
  }
</style>

<div class="bg-light-palette-p5 dark:bg-slate-950 border-2 border-light-palette-p3 dark:border-slate-800 rounded m-8 transition-colors duration-200">
  <header class="border-b-2 border-light-palette-p3 dark:border-slate-800 flex items-center justify-end gap-2 p-4 sticky top-0 bg-light-palette-p5 dark:bg-slate-950 z-20">
    <%= render '/components/form/input_expandable_search',
               search_url: account_deals_path(Current.account),
               turbo_frame_search: :deals_table,
               placeholder: t('activerecord.models.search', model: @deals.model_name.human) %>
    <%= link_to new_select_contact_account_deals_path(current_user.account), class: 'button-default-blank-secondary-icon-only-sm dark:text-slate-400', data: { turbo_frame: :_top } do %>
      <i data-lucide="plus" class='h-4 w-4'></i>
    <% end %>
  </header>

  <%= turbo_frame_tag :deals_table do %>
    <div class="overflow-x-auto">
      <%# LARGURA MANTIDA PARA ACOMODAR AS 11 COLUNAS SEM APERTAR %>
      <table class="w-full text-left rtl:text-right min-w-[2100px] table-fixed">
        <thead class="border-b border-light-palette-p3 dark:border-slate-800 bg-light-palette-p4 dark:bg-slate-900">
          <tr>
            <th scope="col" class="w-[70px] py-3 pl-4"></th>
            <th scope="col" class="w-[350px] pr-4 py-3 text-dark-gray-palette-p1 dark:text-slate-300 uppercase text-xs font-bold"><%= t('activerecord.attributes.deal.name') %></th>
            <th scope="col" class="w-[120px] pr-4 py-3 text-dark-gray-palette-p1 dark:text-slate-300 uppercase text-xs font-bold"><%= t('activerecord.attributes.deal.status') %></th>
            <th scope="col" class="w-[120px] pr-4 py-3 text-dark-gray-palette-p1 dark:text-slate-300 uppercase text-xs font-bold"><%= t('activerecord.attributes.deal.id') %></th>
            <th scope="col" class="w-[200px] pr-4 py-3 text-dark-gray-palette-p1 dark:text-slate-300 uppercase text-xs font-bold"><%= t('activerecord.attributes.deal.stage') %></th>
            <th scope="col" class="w-[180px] pr-4 py-3 text-dark-gray-palette-p1 dark:text-slate-300 uppercase text-xs font-bold"><%= t('activerecord.attributes.deal.total_amount_in_cents') %></th>
            <th scope="col" class="w-[250px] pr-4 py-3 text-dark-gray-palette-p1 dark:text-slate-300 uppercase text-xs font-bold"><%= t('activerecord.attributes.deal.pipeline') %></th>
            <th scope="col" class="w-[280px] pr-4 py-3 text-dark-gray-palette-p1 dark:text-slate-300 uppercase text-xs font-bold"><%= t('activerecord.attributes.deal.contact') %></th>
            <th scope="col" class="w-[280px] pr-4 py-3 text-dark-gray-palette-p1 dark:text-slate-300 uppercase text-xs font-bold"><%= t('activerecord.attributes.deal.creator') %></th>
            <th scope="col" class="w-[250px] pr-4 py-3 text-dark-gray-palette-p1 dark:text-slate-300 uppercase text-xs font-bold"><%= t('activerecord.attributes.deal.created_at') %></th>
            <th scope="col" class="w-[80px] py-3 sticky right-0 bg-light-palette-p4 dark:bg-slate-900 z-10 border-l dark:border-slate-800"></th>
          </tr>
        </thead>
        <tbody class="w-full" id='deals'><%= render partial: '/accounts/deals/deal', collection: @deals, as: :deal %></tbody>
      </table>
    </div>
  <% end %>
</div>

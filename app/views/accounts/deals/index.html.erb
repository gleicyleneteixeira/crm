<style>
  .dark body, .dark .app-wrapper, .dark #main-content { background-color: #020617 !important; }
</style>

<div class="bg-slate-50 dark:bg-slate-950 min-h-screen transition-colors duration-200">
  <div class="p-4 md:p-8">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl overflow-hidden">
      
      <header class="border-b border-slate-200 dark:border-slate-800 flex items-center justify-end gap-2 p-4 bg-white dark:bg-slate-900 sticky top-0 z-20">
        <%= render '/components/form/input_expandable_search',
                   search_url: account_deals_path(Current.account),
                   turbo_frame_search: :deals_table,
                   placeholder: t('activerecord.models.search', model: @deals.model_name.human) %>
        <%= link_to new_select_contact_account_deals_path(current_user.account), class: 'p-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300', data: { turbo_frame: :_top } do %>
          <i data-lucide="plus" class='h-5 w-5'></i>
        <% end %>
      </header>

      <%= turbo_frame_tag :deals_table do %>
        <div class="overflow-x-auto">
          <%# Ajustamos o min-w para 1300px para dar fôlego às colunas %>
          <table class="w-full text-left min-w-[1300px] table-fixed">
            <thead class="bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-800">
              <tr>
                <th class="w-[80px] py-4 pl-6 text-slate-700 dark:text-slate-200 font-bold uppercase text-xs">Ícone</th>
                <th class="w-[35%] py-4 font-bold text-slate-700 dark:text-slate-200 uppercase text-xs">Nome</th>
                <th class="w-[15%] py-4 font-bold text-slate-700 dark:text-slate-200 uppercase text-xs">Status</th>
                <th class="w-[15%] py-4 font-bold text-slate-700 dark:text-slate-200 uppercase text-xs">Estágio</th>
                <th class="w-[15%] py-4 font-bold text-slate-700 dark:text-slate-200 uppercase text-xs">Valor</th>
                <th class="w-[15%] py-4 font-bold text-slate-700 dark:text-slate-200 uppercase text-xs">Contato</th>
                <%# Coluna de ações com largura fixa para não sumir %>
                <th class="w-[80px] py-4 pr-6 sticky right-0 bg-slate-50 dark:bg-slate-800 z-10 text-right">Ações</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800" id='deals'>
              <%= render partial: '/accounts/deals/deal', collection: @deals, as: :deal %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
</div>

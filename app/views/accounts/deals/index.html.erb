<tr id="deal_<%= deal.id %>" class="border-b color-border-default dark:border-slate-800 last:border-none hover:bg-gray-50 dark:hover:bg-slate-900 transition-colors duration-200">
  <td class="py-2.5 pl-4 pr-4 flex-shrink-0">
    <div class="w-[40px] h-[40px] flex border color-border-default dark:border-slate-700 bg-brand-palette-08 dark:bg-slate-800 rounded-md">
      <%= embedded_svg("deals-icon.svg", class: "fill-dark-gray-palette-p3 dark:fill-slate-400 m-auto w-5 h-5") %>
    </div>
  </td>
  
  <%# Nome do Negócio - Texto claro no modo dark %>
  <td class="pr-4 py-2.5 typography-body-r-lh150 color-fg-default dark:text-slate-100 truncate max-w-[300px]">
    <%= deal.name %>
  </td>

  <%# Status com cores que saltam aos olhos %>
  <td class="pr-4 py-2.5">
    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold <%= deal.status == 'open' ? 'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-400' : (deal.status == 'won' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-400' : 'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-400') %>">
      ● <%= Deal.human_enum_name(:status, deal.status) %>
    </span>
  </td>

  <%# ID e Estágio %>
  <td class="pr-4 py-2.5 color-fg-subtle dark:text-slate-400">
    <%= deal.id %>
  </td>

  <td class="pr-4 py-2.5 color-fg-default dark:text-slate-300">
    <%= deal.stage.name %>
  </td>

  <%# Valor em destaque %>
  <td class="pr-4 py-2.5 color-fg-default dark:text-slate-100 font-medium">
    <%= render 'components/formatters/currency', value: deal.total_amount_in_cents %>
  </td>

  <%# Contato com azul harmônico %>
  <td class="pr-4 py-2.5">
    <p class="text-blue-600 dark:text-blue-400 font-semibold truncate max-w-[200px]">
      <%= deal.contact&.full_name %>
    </p>
  </td>

  <%# Coluna de Ações (A parte que estava ficando preta/branca demais) %>
  <td class="py-2.5 pl-4 pr-4 sticky right-0 bg-white dark:bg-slate-950 z-10 shadow-[-10px_0_15px_rgba(0,0,0,0.05)] dark:shadow-[-10px_0_20px_rgba(0,0,0,0.5)]">
    <div class="flex justify-end">
      <button id="dropdownuserBtn_<%= deal.id %>" data-dropdown-toggle="dropdownuserOptions<%= deal.id %>" class="color-fg-subtle dark:text-slate-400 hover:dark:text-white">
        <i data-lucide="more-vertical" class="w-5 h-5"></i>
      </button>
    </div>
  </td>
</tr>

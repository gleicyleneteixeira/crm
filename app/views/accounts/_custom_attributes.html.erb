<h2 class="typography-body-s-lh150 text-dark-gray-palette-p1 dark:text-slate-400 font-bold mb-4 uppercase">
  <%= t('activerecord.models.custom_attribute_definition.other') %>
</h2>

<%= f.fields_for(:custom_attributes) do |sf| %>
  <%# MANTIVE SUA LÓGICA: Ele busca as definições e monta os campos %>
  <% current_user.account.custom_attributes_definitions.where(attribute_model: "#{m.class.name.downcase}_attribute").each do | custom_attribute | %>
    <div class="grid gap-1 mb-4">
      <%# Rótulo com cor adaptável para o Dark Mode %>
      <%= sf.label custom_attribute.attribute_key.to_sym, custom_attribute.attribute_display_name, 
          class: "typography-text-m-lh150 text-dark-gray-palette-p1 dark:text-slate-300 font-semibold" %>
      
      <%# O campo de texto agora com fundo escuro e letra branca no modo dark %>
      <%= sf.text_field custom_attribute.attribute_key.to_sym, 
          value: m.custom_attributes[custom_attribute.attribute_key], 
          autofocus: true, 
          class: "form-input bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700 text-slate-800 dark:text-white rounded-md",
          placeholder: "Preencher..." %>
    </div>
  <% end %>
<% end %>

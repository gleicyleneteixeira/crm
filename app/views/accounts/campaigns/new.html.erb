<div class="h-[calc(100vh-80px)] overflow-y-auto w-full">
  <div class="w-full px-4 sm:px-6 lg:px-8 py-8 mx-auto xl:max-w-[1600px]">
    <div>
      <h1 class="typography-title-b-lh150 text-dark-gray-palette-p1">Nova Campanha</h1>
      <p class="typography-body-s-lh150 text-slate-500">Configure os destinos e importe seus dados (CSV, XLS ou Colar).</p>
    </div>
  </div>

  <%= form_with(model: [current_user.account, @campaign], data: { controller: 'campaign-import', 'campaign-import-pipelines-value': @pipelines.to_json(include: :stages), 'campaign-import-crm-fields-value': @crm_fields.to_json, 'campaign-import-initial-mapping-value': @campaign.mapping.to_json, action: 'submit->campaign-import#handleFormSubmit' }, class: "flex flex-col gap-6") do |f| %>
    <%= f.hidden_field :account_id, value: current_user.account_id %>
    
    <!-- TOP SECTION: Configuração de Campanha e Destino -->
    <div class="bg-white dark:bg-slate-900 p-6 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div>
          <%= f.label :name, 'Nome da Campanha', class: 'block typography-micro-b-lh150 text-slate-700 mb-2' %>
          <%= f.text_field :name, class: 'w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-800 focus:border-brand-palette-03 focus:ring-brand-palette-03 text-sm mb-2', placeholder: 'Ex: Lançamento Março 2024', required: true %>

        </div>
        
        <div>
          <%= f.label :campaign_category_id, 'Tipo de Campanha', class: 'block typography-micro-b-lh150 text-slate-700 mb-2' %>
          <div class="flex gap-2">
            <%= f.collection_select :campaign_category_id, @campaign_categories, :id, :name, { prompt: 'Selecione...' }, { id: 'category-select-options', class: 'w-full rounded-lg border-slate-300 focus:border-brand-palette-03 focus:ring-brand-palette-03 dark:bg-slate-800 dark:border-slate-600 text-sm', required: true, data: { action: 'change->campaign-import#handleCategoryChange', 'campaign-import-target': 'categorySelect' } } %>
            <%= link_to new_account_campaign_category_path(current_user.account), class: 'btn-secondary px-3 flex items-center justify-center', title: 'Novo Tipo de Campanha', data: { turbo_frame: 'modal' } do %>
              <i data-lucide="plus" class="w-5 h-5"></i>
            <% end %>
          </div>
          <div class="mt-2">
            <label class="flex items-center gap-2 cursor-pointer mb-2">
              <input type="checkbox" data-action="change->campaign-import#toggleNameMapping" class="rounded border-slate-300 text-brand-palette-03 focus:ring-brand-palette-03 dark:bg-slate-800 dark:border-slate-600 transition-colors">
              <span class="text-xs text-slate-600 dark:text-slate-400 font-medium">Mapear?</span>
            </label>
            <div data-name-mapping-select-container class="hidden">
              <select name="campaign[mapping][__campaign_name_target__]" class="w-full text-xs py-1.5 px-2 rounded-md border-slate-300 dark:border-slate-600 dark:bg-slate-800 focus:border-brand-palette-03 text-slate-700 dark:text-slate-300" data-action="change->campaign-import#handleHeaderMappingChange" data-col="__fixed_name__">
                <option value="">Selecione o tributo...</option>
                <% if @crm_fields['Negócio'] %>
                  <% @crm_fields['Negócio'].each do |label, key| %>
                    <option value="<%= key %>"><%= label %></option>
                  <% end %>
                <% end %>
              </select>
            </div>
          </div>
        </div>

        <div>
          <%= f.label :pipeline_id, 'Pipeline de Destino', class: 'block typography-micro-b-lh150 text-slate-700 mb-2' %>
          <%= f.collection_select :pipeline_id, @pipelines, :id, :name, { prompt: 'Selecione o funil...' }, { class: 'w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-800 focus:border-brand-palette-03 text-sm', data: { action: 'change->campaign-import#handlePipelineChange', 'campaign-import-target': 'pipelineSelect' }, required: true } %>
        </div>
        
        <div>
          <%= f.label :stage_id, 'Etapa Inicial', class: 'block typography-micro-b-lh150 text-slate-700 mb-2' %>
          <%= f.select :stage_id, [], { prompt: 'Selecione o funil primeiro...' }, { class: 'w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-800 focus:border-brand-palette-03 text-sm', data: { 'campaign-import-target': 'stageSelect', action: 'change->campaign-import#validateMapping' }, required: true } %>
        </div>
      </div>
    </div>

    <!-- MAIN SECTION: Importação de Dados -->
    <div class="bg-white dark:bg-slate-900 p-0 sm:p-6 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 flex flex-col min-h-[500px]">
      <div data-campaign-import-target="emptyStateContainer" class="p-6">
        <div class="border-2 border-dashed border-slate-200 dark:border-slate-700 rounded-xl p-8 text-center transition-colors hover:border-brand-palette-03" data-campaign-import-target="dropzone">
          <div class="flex flex-col items-center gap-4">
            <i data-lucide="upload-cloud" class="w-12 h-12 text-slate-400"></i>
            <div>
              <p class="typography-body-b-lh150 text-dark-gray-palette-p1">Upload de arquivo</p>
              <p class="typography-body-s-lh150 text-slate-500">Arraste e solte seu arquivo CSV ou XLS aqui, ou clique para selecionar</p>
            </div>
            <input type="file" id="file_upload" class="hidden" accept=".csv, .xlsx, .xls" data-action="change->campaign-import#handleFile">
            <label for="file_upload" class="btn-secondary cursor-pointer">Selecionar Arquivo</label>
          </div>
        </div>

        <div class="relative mt-6 mb-6">
          <div class="absolute inset-0 flex items-center" aria-hidden="true">
            <div class="w-full border-t border-slate-200 dark:border-slate-700"></div>
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="px-3 bg-white dark:bg-slate-900 text-slate-500 typography-micro-b-lh150 uppercase">Ou cole os dados abaixo</span>
          </div>
        </div>
      </div>
      
      <div class="flex-1 flex flex-col px-6 pb-6">
        <div class="flex items-center justify-between mb-4 mt-2">
          <label class="block typography-h4-lh150 text-slate-800 dark:text-slate-100 font-bold">Planilha de Importação</label>
          <div class="flex items-center gap-4">
            <div class="flex items-center gap-2 bg-slate-100 dark:bg-slate-800 py-1.5 px-3 rounded-md">
              <%= f.check_box :insert_ddi, class: 'rounded border-slate-300 text-brand-palette-03 focus:ring-brand-palette-03 dark:bg-slate-700 dark:border-slate-600', data: { action: 'change->campaign-import#handleDdiToggle', campaign_import_target: 'ddiToggle' } %>
              <%= f.label :insert_ddi, 'Inserir DDI 55', class: 'text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer mb-0' %>
            </div>
            <div class="flex items-center gap-2 bg-slate-100 dark:bg-slate-800 py-1.5 px-3 rounded-md">
              <%= check_box_tag :first_row_header, '1', true, data: { action: 'change->campaign-import#handleHeaderToggle', campaign_import_target: 'headerToggle' }, class: 'rounded border-slate-300 text-brand-palette-03 focus:ring-brand-palette-03 dark:bg-slate-700 dark:border-slate-600' %>
              <%= label_tag :first_row_header, '1ª linha é cabeçalho', class: 'text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer mb-0' %>
            </div>
          </div>
        </div>
        
        <div data-campaign-import-target="gridWrapper" class="hidden flex-1 flex flex-col rounded-lg border border-slate-300 dark:border-slate-600 overflow-hidden mb-2 shadow-sm">
          <div class="bg-slate-50 dark:bg-slate-800/50 p-3 lg:p-4 flex flex-col sm:flex-row justify-between items-center border-b border-slate-200 dark:border-slate-700 gap-3">
            <div class="flex gap-4 sm:gap-6 text-sm">
               <div class="flex flex-col">
                  <span class="text-slate-500 dark:text-slate-400 text-xs uppercase font-semibold">Total</span>
                  <span data-campaign-import-target="countTotal" class="font-bold text-slate-900 dark:text-white text-lg">0</span>
               </div>
               <div class="flex flex-col">
                  <span class="text-slate-500 dark:text-slate-400 text-xs uppercase font-semibold">Válidos</span>
                  <span data-campaign-import-target="countValid" class="font-bold text-green-600 dark:text-green-400 text-lg">0</span>
               </div>
               <div class="flex flex-col">
                  <span class="text-slate-500 dark:text-slate-400 text-xs uppercase font-semibold">Inválidos</span>
                  <span data-campaign-import-target="countInvalid" class="font-bold text-red-500 dark:text-red-400 text-lg">0</span>
               </div>
            </div>
            <div class="flex items-center gap-2">
              <div class="relative" data-controller="dropdown">
                <button type="button" data-action="click->dropdown#toggle" class="btn-secondary px-3 py-1.5 flex items-center gap-2 text-sm font-semibold">
                  <i data-lucide="buffer" class="w-4 h-4"></i>
                  Ações em Massa
                  <i data-lucide="chevron-down" class="w-3 h-3"></i>
                </button>
                <div data-dropdown-target="menu" class="hidden absolute left-0 mt-2 w-48 bg-white dark:bg-slate-800 rounded-xl shadow-xl border border-slate-200 dark:border-slate-700 z-50 py-2">
                  <button type="button" data-action="click->campaign-import#removeInvalidRows click->dropdown#close" class="w-full text-left px-4 py-2 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-2">
                    <i data-lucide="user-minus" class="w-4 h-4 text-red-400"></i> Remover Inválidos
                  </button>
                  <button type="button" data-action="click->campaign-import#removeDuplicates click->dropdown#close" class="w-full text-left px-4 py-2 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-2">
                    <i data-lucide="copy-minus" class="w-4 h-4 text-orange-400"></i> Remover Duplicados
                  </button>
                  <div class="h-px bg-slate-200 dark:bg-slate-700 my-1"></div>
                  <button type="button" data-action="click->campaign-import#exportInvalidRows click->dropdown#close" class="w-full text-left px-4 py-2 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-2">
                    <i data-lucide="download" class="w-4 h-4 text-emerald-400"></i> Exportar Inválidos
                  </button>
                </div>
              </div>

              <button type="button" data-action="click->campaign-import#clearData" class="text-red-500 hover:text-red-700 hover:bg-red-50 dark:hover:bg-red-900/20 px-3 py-1.5 rounded-md text-sm font-semibold transition-colors flex items-center gap-2">
                <i data-lucide="trash-2" class="w-4 h-4"></i> Limpar Dados
              </button>
            </div>
          </div>
          <div class="overflow-x-auto overflow-y-auto max-h-[65vh] w-full" data-campaign-import-target="gridContainer" data-action="paste->campaign-import#handleGridPaste">
          </div>
        </div>

        <textarea 
          class="w-full h-48 rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-800 font-mono text-sm shadow-inner" 
          placeholder="Cole dados do Excel ou Google Sheets aqui..."
          data-action="input->campaign-import#handlePaste"
          data-campaign-import-target="pasteArea"
        ></textarea>
      </div>
    </div>

    <% if @campaign.errors.any? %>
      <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl p-4 mb-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <i data-lucide="alert-circle" class="h-5 w-5 text-red-400"></i>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800 dark:text-red-200">
              Ops! Encontramos <%= pluralize(@campaign.errors.count, "erro") %>:
            </h3>
            <div class="mt-2 text-sm text-red-700 dark:text-red-300">
              <ul class="list-disc pl-5 space-y-1">
                <% @campaign.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <%= f.hidden_field :spreadsheet_data, value: (@campaign.spreadsheet_data.is_a?(String) ? @campaign.spreadsheet_data : @campaign.spreadsheet_data.to_json), data: { 'campaign-import-target': 'jsonOutput' } %>

    <!-- BOTTOM SECTION: Action Form -->
    <div class="bg-white dark:bg-slate-900 p-4 sm:p-6 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 mt-6 flex items-center justify-between">
      <div class="text-sm text-slate-500">
        Mapeie os campos de Nome e Telefone para habilitar o envio.
      </div>
      <div class="flex gap-3">
        <%= link_to 'Cancelar', account_campaigns_path(current_user.account), class: 'btn-secondary font-semibold' %>
        <%= f.button 'Próximo <i data-lucide="arrow-right" class="w-4 h-4 ml-2"></i>'.html_safe, type: 'submit', class: 'btn-primary font-semibold flex items-center shadow-lg hover:shadow-xl transition-all', data: { 'campaign-import-target': 'submitButton' } %>
      </div>
    </div>
  <% end %>
</div>

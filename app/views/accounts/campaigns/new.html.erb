<div class="max-w-4xl mx-auto py-8">
  <div class="mb-8">
    <h1 class="typography-title-b-lh150 text-dark-gray-palette-p1">Nova Campanha</h1>
    <p class="typography-body-s-lh150 text-slate-500">Comece carregando seus dados. Você pode subir um arquivo CSV/XLS ou colar os dados diretamente.</p>
  </div>

  <%= form_with(model: [current_user.account, @campaign], data: { controller: 'campaign-import' }) do |f| %>
    <div class="flex flex-col gap-6 bg-white dark:bg-slate-900 p-8 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700">
      
      <div class="flex flex-col md:flex-row gap-4">
        <div class="flex-1">
          <%= f.label :name, 'Nome da Campanha', class: 'block typography-micro-b-lh150 text-slate-700 mb-2' %>
          <%= f.text_field :name, class: 'w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-800 focus:border-brand-palette-03 focus:ring-brand-palette-03', placeholder: 'Ex: Lançamento Março 2024', required: true %>
        </div>
        <div class="flex-1">
          <%= f.label :campaign_category_id, 'Tipo de Campanha', class: 'block typography-micro-b-lh150 text-slate-700 mb-2' %>
          <div class="flex gap-2">
            <%= f.collection_select :campaign_category_id, @campaign_categories, :id, :name, { prompt: 'Selecione o tipo...' }, { class: 'w-full rounded-lg border-slate-300 focus:border-brand-palette-03 focus:ring-brand-palette-03 dark:bg-slate-800 dark:border-slate-600', required: true, data: { action: 'change->campaign-import#handleCategoryChange', 'campaign-import-target': 'categorySelect' } } %>
            <button type="button" class="btn-secondary px-3" title="Novo Tipo de Campanha">
              <i data-lucide="plus" class="w-5 h-5"></i>
            </button>
          </div>
        </div>
      </div>

      <div data-campaign-import-target="emptyStateContainer">
        <div class="border-2 border-dashed border-slate-200 dark:border-slate-700 rounded-xl p-8 text-center transition-colors hover:border-brand-palette-03" data-campaign-import-target="dropzone">
          <div class="flex flex-col items-center gap-4">
            <i data-lucide="upload-cloud" class="w-12 h-12 text-slate-400"></i>
            <div>
              <p class="typography-body-b-lh150 text-dark-gray-palette-p1">Upload de arquivo</p>
              <p class="typography-body-s-lh150 text-slate-500">Arraste e solte seu arquivo CSV ou XLS aqui, ou clique para selecionar</p>
            </div>
            <input type="file" id="file_upload" class="hidden" accept=".csv, .xlsx, .xls" data-action="change->campaign-import#handleFile">
            <label for="file_upload" class="btn-secondary cursor-pointer">Selecionar Arquivo</label>
          </div>
        </div>

        <div class="relative mt-6">
          <div class="absolute inset-0 flex items-center" aria-hidden="true">
            <div class="w-full border-t border-slate-200 dark:border-slate-700"></div>
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="px-3 bg-white dark:bg-slate-900 text-slate-500 typography-micro-b-lh150 uppercase">Ou cole os dados abaixo</span>
          </div>
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="block typography-micro-b-lh150 text-slate-700">Editor de Planilha</label>
          <div class="flex items-center gap-2">
            <%= check_box_tag :first_row_header, '1', true, data: { action: 'change->campaign-import#handleHeaderToggle', campaign_import_target: 'headerToggle' }, class: 'rounded border-slate-300 text-brand-palette-03 focus:ring-brand-palette-03 dark:bg-slate-800 dark:border-slate-600' %>
            <%= label_tag :first_row_header, 'Primeira linha é cabeçalho', class: 'typography-micro-b-lh150 text-slate-700 dark:text-slate-300 cursor-pointer' %>
          </div>
        </div>
        
        <div data-campaign-import-target="gridWrapper" class="hidden rounded-lg border border-slate-300 dark:border-slate-600 overflow-hidden mb-4">
          <div class="bg-slate-50 dark:bg-slate-800/50 p-3 lg:p-4 flex flex-col sm:flex-row justify-between items-center border-b border-slate-200 dark:border-slate-700 gap-3">
            <div class="flex gap-4 sm:gap-6 text-sm">
               <div class="flex flex-col">
                  <span class="text-slate-500 dark:text-slate-400 text-xs uppercase font-semibold">Total</span>
                  <span data-campaign-import-target="countTotal" class="font-bold text-slate-900 dark:text-white text-lg">0</span>
               </div>
               <div class="flex flex-col">
                  <span class="text-slate-500 dark:text-slate-400 text-xs uppercase font-semibold">Válidos</span>
                  <span data-campaign-import-target="countValid" class="font-bold text-green-600 dark:text-green-400 text-lg">0</span>
               </div>
               <div class="flex flex-col">
                  <span class="text-slate-500 dark:text-slate-400 text-xs uppercase font-semibold">Inválidos</span>
                  <span data-campaign-import-target="countInvalid" class="font-bold text-red-500 dark:text-red-400 text-lg">0</span>
               </div>
            </div>
            <button type="button" data-action="click->campaign-import#clearData" class="text-red-500 hover:text-red-700 hover:bg-red-50 dark:hover:bg-red-900/20 px-3 py-1.5 rounded-md text-sm font-semibold transition-colors flex items-center gap-2">
              <i data-lucide="trash-2" class="w-4 h-4"></i> Limpar Dados
            </button>
          </div>
          <div class="overflow-x-auto max-h-[500px]" data-campaign-import-target="gridContainer" data-action="paste->campaign-import#handleGridPaste">
          </div>
        </div>

        <textarea 
          class="w-full h-64 rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-800 font-mono text-sm" 
          placeholder="Cole dados do Excel ou Google Sheets aqui..."
          data-action="input->campaign-import#handlePaste"
          data-campaign-import-target="pasteArea"
        ></textarea>
      </div>

        <div data-campaign-import-target="mappingSection" class="hidden mt-8 pt-6 border-t border-slate-200 dark:border-slate-700">
          <div class="mb-6">
            <h3 class="typography-body-b-lh150 text-dark-gray-palette-p1">Mapeamento de Variáveis (IA)</h3>
            <p class="typography-body-s-lh150 text-slate-500">Relacione as colunas da planilha com os atributos do CRM para gerar as tags da IA. Nome e Telefone são obrigatórios.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <% @crm_fields.each do |group_name, fields| %>
              <div class="bg-slate-50 dark:bg-slate-800/50 p-6 rounded-xl border border-slate-200 dark:border-slate-700">
                <h4 class="typography-micro-b-lh150 text-slate-700 dark:text-slate-300 uppercase mb-4"><%= group_name %></h4>
                <div class="flex flex-col gap-4">
                  <% fields.each do |label, key| %>
                    <% is_required = (key == 'contact.full_name' || key == 'contact.phone') %>
                    <div class="flex flex-col flex-1">
                      <div class="flex justify-between items-center mb-1">
                        <label class="typography-micro-b-lh150 text-slate-700 dark:text-slate-300">
                          <%= label %> <%= '<span class="text-red-500">*</span>'.html_safe if is_required %>
                        </label>
                        <% variable_name = "{{#{label.parameterize.underscore}}}" %>
                        <code class="text-[10px] sm:text-xs text-brand-palette-03 bg-brand-palette-03/10 px-2 py-0.5 rounded font-mono"><%= variable_name %></code>
                      </div>
                      <select name="campaign[mapping][<%= key %>]" 
                              class="w-full text-sm rounded-lg border-slate-300 focus:border-brand-palette-03 focus:ring-brand-palette-03 dark:bg-slate-800 dark:border-slate-600"
                              data-campaign-import-target="mappingSelect"
                              data-action="change->campaign-import#validateMapping"
                              data-required="<%= is_required %>"
                              data-crm-field="<%= label %>">
                        <option value="">Ignorar este campo</option>
                      </select>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%= f.hidden_field :spreadsheet_data, data: { 'campaign-import-target': 'jsonOutput' } %>

      <div class="flex justify-end gap-4 border-t border-slate-100 dark:border-slate-800 pt-6 mt-6">
        <%= link_to 'Cancelar', account_campaigns_path(current_user.account), class: 'btn-secondary' %>
        <%= f.button 'Finalizar e Criar Campanha', type: 'submit', class: 'btn-primary opacity-50 cursor-not-allowed', disabled: true, data: { 'campaign-import-target': 'submitButton' } %>
      </div>
    </div>
  <% end %>
</div>

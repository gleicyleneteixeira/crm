<div class="max-w-4xl mx-auto py-8">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="typography-title-b-lh150 text-dark-gray-palette-p1">Mapeamento de Colunas</h1>
      <p class="typography-body-s-lh150 text-slate-500 text-dark-gray-palette-p3">Relacione as colunas da sua planilha com os campos do Woofed CRM.</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="px-3 py-1 bg-slate-100 dark:bg-slate-800 rounded-full typography-micro-b-lh150 text-slate-600 dark:text-slate-400">Passo 2 de 3</span>
    </div>
  </div>

  <%= form_with(model: @campaign, url: update_mapping_account_campaign_path(current_user.account, @campaign), method: :patch) do |f| %>
    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
      <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
        <thead class="bg-slate-50 dark:bg-slate-800">
          <tr>
            <th class="px-6 py-4 text-left typography-micro-b-lh150 text-slate-500 uppercase">Coluna da Planilha</th>
            <th class="px-6 py-4 text-left typography-micro-b-lh150 text-slate-500 uppercase">Amostra (Linha 2)</th>
            <th class="px-6 py-4 text-left typography-micro-b-lh150 text-slate-500 uppercase">Campo no CRM</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
          <% sample_row = @campaign.spreadsheet_data[1] || [] %>
          <% @headers.each_with_index do |header, index| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap typography-body-b-lh150 text-dark-gray-palette-p1">
                <%= header %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap typography-body-s-lh150 text-slate-500 truncate max-w-[200px]">
                <%= sample_row[index] || '(Vazio)' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= select_tag "campaign[mapping][#{index}]", 
                    grouped_options_for_select(@crm_fields, @campaign.mapping[index.to_s]),
                    include_blank: 'Ignorar esta coluna',
                    class: 'w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-800 focus:border-brand-palette-03 focus:ring-brand-palette-03 text-sm' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <div class="p-6 bg-slate-50 dark:bg-slate-800/50 flex justify-end gap-4 border-t border-slate-200 dark:border-slate-700">
        <%= link_to 'Voltar', edit_account_campaign_path(current_user.account, @campaign), class: 'btn-secondary' %>
        <%= f.submit 'Salvar e Próximo: Composição', class: 'btn-primary' %>
      </div>
    </div>
  <% end %>
</div>

<div class="h-[calc(100vh-80px)] overflow-y-auto w-full">
  <div class="w-full px-4 sm:px-6 lg:px-8 py-8 mx-auto">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="typography-title-b-lh150 text-dark-gray-palette-p1">Importação de Dados</h1>
        <p class="typography-body-s-lh150 text-slate-500">Passo 2: Higienização e Mapeamento da Planilha</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-3 py-1 bg-brand-palette-03/10 text-brand-palette-03 rounded-full typography-micro-b-lh150 font-bold">Passo 2 de 3</span>
      </div>
    </div>

    <%= form_with(model: @campaign, url: update_import_account_campaign_path(current_user.account, @campaign), method: :patch, data: { controller: 'campaign-import', 'campaign-import-crm-fields-value': @crm_fields.to_json, 'campaign-import-crm-phones-value': @crm_phones.to_json }, class: "flex flex-col gap-6 w-full") do |f| %>
      
      <!-- MAIN SECTION: Importação de Dados -->
      <div class="bg-white dark:bg-slate-900 p-0 sm:p-6 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 flex flex-col min-h-[500px]">
        <div data-campaign-import-target="emptyStateContainer" class="p-6">
          <div class="border-2 border-dashed border-slate-200 dark:border-slate-700 rounded-xl p-8 text-center transition-colors hover:border-brand-palette-03" data-campaign-import-target="dropzone">
            <div class="flex flex-col items-center gap-4">
              <i data-lucide="upload-cloud" class="w-12 h-12 text-slate-400"></i>
              <div>
                <p class="typography-body-b-lh150 text-dark-gray-palette-p1">Upload de arquivo</p>
                <p class="typography-body-s-lh150 text-slate-500">Arraste e solte seu arquivo CSV ou XLS aqui, ou clique para selecionar</p>
              </div>
              <input type="file" id="file_upload" class="hidden" accept=".csv, .xlsx, .xls" data-action="change->campaign-import#handleFile">
              <label for="file_upload" class="btn-secondary cursor-pointer">Selecionar Arquivo</label>
            </div>
          </div>

          <div class="relative mt-6 mb-6">
            <div class="absolute inset-0 flex items-center" aria-hidden="true">
              <div class="w-full border-t border-slate-200 dark:border-slate-700"></div>
            </div>
            <div class="relative flex justify-center text-sm">
              <span class="px-3 bg-white dark:bg-slate-900 text-slate-500 typography-micro-b-lh150 uppercase">Ou cole os dados abaixo</span>
            </div>
          </div>
        </div>
        
        <div class="flex-1 flex flex-col px-6 pb-6">
          <div class="flex items-center justify-between mb-4 mt-2">
            <label class="block typography-h4-lh150 text-slate-800 dark:text-slate-100 font-bold">Planilha de Importação</label>
            <div class="flex items-center gap-4">
              <div class="flex items-center gap-2 bg-slate-100 dark:bg-slate-800 py-1.5 px-3 rounded-md">
                <input type="checkbox" id="insert_ddi" <%= @campaign.insert_ddi ? 'checked' : '' %> class="rounded border-slate-300 text-brand-palette-03 focus:ring-brand-palette-03 dark:bg-slate-700 dark:border-slate-600" data-action="change->campaign-import#handleDdiToggle" data-campaign-import-target="ddiToggle">
                <label for="insert_ddi" class="text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer mb-0">Inserir DDI 55</label>
              </div>
              <div class="flex items-center gap-2 bg-slate-100 dark:bg-slate-800 py-1.5 px-3 rounded-md">
                <%= check_box_tag :first_row_header, '1', true, data: { action: 'change->campaign-import#handleHeaderToggle', campaign_import_target: 'headerToggle' }, class: 'rounded border-slate-300 text-brand-palette-03 focus:ring-brand-palette-03 dark:bg-slate-700 dark:border-slate-600' %>
                <%= label_tag :first_row_header, '1ª linha é cabeçalho', class: 'text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer mb-0' %>
              </div>
            </div>
          </div>
          
          <div data-campaign-import-target="gridWrapper" class="hidden flex-1 flex flex-col rounded-lg border border-slate-300 dark:border-slate-600 overflow-hidden mb-2 shadow-sm">
            <div class="bg-slate-50 dark:bg-slate-800/50 p-3 lg:p-4 flex flex-col sm:flex-row justify-between items-center border-b border-slate-200 dark:border-slate-700 gap-3">
              <div class="flex gap-4 sm:gap-6 text-sm flex-1">
                 <div class="flex flex-col">
                    <span class="text-slate-500 dark:text-slate-400 text-xs uppercase font-semibold">Total</span>
                    <span data-campaign-import-target="countTotal" class="font-bold text-slate-900 dark:text-white text-lg">0</span>
                 </div>
                 <div class="flex flex-col">
                    <span class="text-slate-500 dark:text-slate-400 text-xs uppercase font-semibold">Válidos</span>
                    <span data-campaign-import-target="countValid" class="font-bold text-green-600 dark:text-green-400 text-lg">0</span>
                 </div>
                 <div class="flex flex-col">
                    <span class="text-slate-500 dark:text-slate-400 text-xs uppercase font-semibold">Inválidos</span>
                    <span data-campaign-import-target="countInvalid" class="font-bold text-red-500 dark:text-red-400 text-lg">0</span>
                 </div>
              </div>
              <div class="flex gap-2 flex-wrap justify-end">
                <button type="button" data-action="click->campaign-import#removeInvalidRows" class="btn-secondary px-3 py-1.5 rounded-md text-xs font-semibold flex items-center gap-2">
                  <i data-lucide="filter-x" class="w-4 h-4"></i> Inválidas
                </button>
                <button type="button" data-action="click->campaign-import#exportInvalidRows" class="btn-secondary px-3 py-1.5 rounded-md text-xs font-semibold flex items-center gap-2">
                  <i data-lucide="download" class="w-4 h-4"></i> CSV
                </button>
                <button type="button" data-action="click->campaign-import#removeDuplicates" class="btn-secondary px-3 py-1.5 rounded-md text-xs font-semibold flex items-center gap-2">
                  <i data-lucide="copy-minus" class="w-4 h-4"></i> Duplicados
                </button>
                <button type="button" data-action="click->campaign-import#clearData" class="text-red-500 hover:text-red-700 hover:bg-red-50 dark:hover:bg-red-900/20 px-3 py-1.5 rounded-md text-sm font-semibold transition-colors flex items-center gap-2 ml-2">
                  <i data-lucide="trash-2" class="w-4 h-4"></i> Limpar Dados
                </button>
              </div>
            </div>
            <div class="overflow-x-auto overflow-y-auto max-h-[65vh] w-full" data-campaign-import-target="gridContainer" data-action="paste->campaign-import#handleGridPaste">
            </div>
          </div>

          <textarea 
            class="w-full h-48 rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-800 font-mono text-sm shadow-inner" 
            placeholder="Cole dados do Excel ou Google Sheets aqui..."
            data-action="input->campaign-import#handlePaste"
            data-campaign-import-target="pasteArea"
          ></textarea>
        </div>
      </div>

      <%= f.hidden_field :spreadsheet_data, data: { 'campaign-import-target': 'jsonOutput' } %>

      <div class="bg-white dark:bg-slate-900 p-4 sm:p-6 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 mt-6 flex items-center justify-between">
        <div class="text-sm text-slate-500">
          Mapeie os campos de Nome e Telefone para habilitar o envio.
        </div>
        <div class="flex gap-3">
          <%= link_to 'Voltar', edit_account_campaign_path(current_user.account, @campaign), class: 'btn-secondary font-semibold' %>
          <%= f.button 'Próximo <i data-lucide="arrow-right" class="w-4 h-4 ml-2"></i>'.html_safe, type: 'submit', class: 'btn-primary font-semibold opacity-50 cursor-not-allowed flex items-center shadow-lg hover:shadow-xl transition-all', disabled: true, data: { 'campaign-import-target': 'submitButton' } %>
        </div>
      </div>
    <% end %>
  </div>
</div>

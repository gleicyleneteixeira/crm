<div class="flex flex-col gap-8 p-12 bg-[#0B0E14] min-h-screen font-sans text-slate-300">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-6">
      <div class="w-14 h-14 bg-brand-palette-03/10 rounded-2xl flex items-center justify-center border border-brand-palette-03/20 shadow-lg shadow-brand-palette-03/5">
        <i data-lucide="megaphone" class="w-7 h-7 text-brand-palette-03"></i>
      </div>
      <div>
        <h1 class="text-2xl font-black text-white tracking-tight uppercase">Suas Campanhas</h1>
        <p class="text-[11px] text-slate-500 font-bold uppercase tracking-[0.2em] mt-1">Gerencie seus disparos e acompanhe o progresso em tempo real</p>
      </div>
    </div>
    <%= link_to new_account_campaign_path(@account), class: 'flex items-center gap-3 px-8 py-4 bg-brand-palette-03 text-white rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-brand-palette-04 transition-all shadow-2xl shadow-brand-palette-03/20 active:scale-95 group border-none' do %>
      <i data-lucide="plus" class="w-4 h-4 group-hover:rotate-90 transition-transform"></i>
      Nova Campanha
    <% end %>
  </div>

  <% if @draft_campaigns.any? %>
    <!-- Dashboard de Retomada (Dark Aesthetic) -->
    <div class="bg-[#161B22] border border-slate-800/60 rounded-[2.5rem] p-10 shadow-2xl relative overflow-hidden group">
      <div class="flex items-center gap-4 mb-8">
        <div class="w-12 h-12 bg-amber-500/10 rounded-2xl flex items-center justify-center border border-amber-500/20">
          <i data-lucide="history" class="w-6 h-6 text-amber-500"></i>
        </div>
        <div>
          <h2 class="text-sm font-black text-white uppercase tracking-wider">Retomar Rascunhos</h2>
          <p class="text-[10px] text-slate-500 font-bold uppercase tracking-[0.2em]">Você possui <%= pluralize(@draft_campaigns.count, 'campanha', 'campanhas') %> incompletas</p>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @draft_campaigns.limit(3).each do |draft| %>
          <div class="group/card bg-[#0D1117] border border-slate-800/60 p-6 rounded-[2rem] flex items-center justify-between hover:border-amber-500/30 hover:bg-[#1C2128] transition-all duration-300">
            <div class="min-w-0 pr-4">
              <p class="text-xs font-black text-white truncate mb-2 uppercase tracking-wide" title="<%= draft.name %>"><%= draft.name %></p>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                <p class="text-[9px] text-slate-500 font-black uppercase tracking-[0.15em]">Passo <%= draft.current_step %>/4 • <%= draft.updated_at.strftime('%d/%m %H:%M') %></p>
              </div>
            </div>
            <% 
              resume_path = case draft.current_step
                            when 1 then edit_account_campaign_path(@account, draft)
                            when 2 then composition_account_campaign_path(@account, draft)
                            when 3 then logistics_account_campaign_path(@account, draft)
                            when 4 then automation_account_campaign_path(@account, draft)
                            else edit_account_campaign_path(@account, draft)
                            end
            %>
            <div class="flex gap-2">
              <%= button_to account_campaign_path(@account, draft), method: :delete, data: { confirm: 'Tem certeza que deseja excluir este rascunho?' }, class: 'p-3 bg-slate-900 border border-slate-800 text-slate-500 rounded-xl hover:text-red-500 hover:border-red-500/30 hover:bg-red-500/5 transition-all cursor-pointer' do %>
                <i data-lucide="trash-2" class="w-4 h-4"></i>
              <% end %>
              <%= link_to resume_path, class: 'p-3 bg-amber-500 text-[#0D1117] rounded-xl hover:bg-amber-400 transition-all cursor-pointer shadow-lg shadow-amber-500/20 group-hover/card:scale-105' do %>
                <i data-lucide="play" class="w-4 h-4 fill-current"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Tabela de Campanhas (Dark Aesthetic Custom) -->
  <div class="bg-[#161B22] border border-slate-800/60 rounded-[2.5rem] shadow-2xl overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-800/40">
        <thead class="bg-[#0D1117]/50">
          <tr>
            <th class="px-10 py-6 text-left text-[10px] font-black text-slate-500 uppercase tracking-[0.3em]">Campanha</th>
            <th class="px-10 py-6 text-left text-[10px] font-black text-slate-500 uppercase tracking-[0.3em]">Progresso</th>
            <th class="px-10 py-6 text-left text-[10px] font-black text-slate-500 uppercase tracking-[0.3em]">Status</th>
            <th class="px-10 py-6 text-left text-[10px] font-black text-slate-500 uppercase tracking-[0.3em]">Data Criação</th>
            <th class="px-10 py-6 text-right text-[10px] font-black text-slate-500 uppercase tracking-[0.3em]">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/40">
          <% @campaigns.each do |campaign| %>
            <tr class="hover:bg-[#0D1117]/30 transition-colors group/row">
              <td class="px-10 py-8 whitespace-nowrap">
                <div class="flex items-center gap-5">
                  <div class="w-12 h-12 rounded-2xl bg-[#0D1117] border border-slate-800/60 flex items-center justify-center text-slate-600 group-hover/row:border-brand-palette-03/30 transition-all">
                    <i data-lucide="<%= campaign.running? ? 'rocket' : 'send' %>" class="w-5 h-5 <%= 'text-emerald-500' if campaign.running? %>"></i>
                  </div>
                  <div>
                    <%= link_to campaign.name, account_campaign_path(@account, campaign), class: 'text-sm font-black text-white hover:text-brand-palette-03 tracking-wide uppercase' %>
                    <p class="text-[10px] text-slate-500 font-bold uppercase tracking-wider mt-1"><%= campaign.total_leads %> contatos total</p>
                  </div>
                </div>
              </td>
              <td class="px-10 py-8 whitespace-nowrap">
                <div class="w-40">
                  <div class="flex items-center justify-between mb-2 text-[9px] font-black text-slate-500 uppercase tracking-widest">
                    <span><%= campaign.processed_leads || 0 %> / <%= campaign.total_leads %></span>
                    <% progress = campaign.total_leads.to_i > 0 ? (campaign.processed_leads.to_f / campaign.total_leads.to_f * 100).round : 0 %>
                    <span class="<%= progress == 100 ? 'text-emerald-500' : 'text-brand-palette-03' %>"><%= progress %>%</span>
                  </div>
                  <div class="h-1.5 w-full bg-slate-900 rounded-full overflow-hidden border border-slate-800/30">
                    <div class="h-full bg-brand-palette-03 rounded-full shadow-[0_0_10px_rgba(45,108,223,0.3)] transition-all duration-1000" style="width: <%= progress %>%"></div>
                  </div>
                </div>
              </td>
              <td class="px-10 py-8 whitespace-nowrap">
                <% 
                  status_classes = case campaign.status
                    when 'running' then 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20'
                    when 'paused' then 'bg-amber-500/10 text-amber-500 border-amber-500/20'
                    when 'completed' then 'bg-brand-palette-03/10 text-brand-palette-03 border-brand-palette-03/20'
                    when 'failed' then 'bg-red-500/10 text-red-500 border-red-500/20'
                    when 'canceled' then 'bg-slate-800 text-slate-500 border-slate-700'
                    else 'bg-slate-800 text-slate-400 border-slate-700'
                    end
                %>
                <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border <%= status_classes %>">
                  <% if campaign.running? %>
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                    </span>
                  <% end %>
                  <span class="text-[9px] font-black uppercase tracking-[0.1em]"><%= campaign.status.humanize %></span>
                </div>
              </td>
              <td class="px-10 py-8 whitespace-nowrap">
                <span class="text-[10px] font-black text-white uppercase tracking-widest block"><%= campaign.created_at.strftime('%d/%m/%Y') %></span>
                <span class="text-[9px] font-bold text-slate-600 uppercase tracking-widest block mt-0.5"><%= campaign.created_at.strftime('%H:%M') %></span>
              </td>
              <td class="px-10 py-8 whitespace-nowrap text-right">
                <div class="flex items-center justify-end gap-3">
                  <% if campaign.paused? || campaign.failed? || campaign.canceled? %>
                    <%= button_to resume_account_campaign_path(@account, campaign), method: :patch, title: 'Retomar Campanha', class: 'p-3 bg-emerald-500 text-[#0D1117] rounded-xl hover:bg-emerald-400 transition-all border-none cursor-pointer shadow-lg shadow-emerald-500/10' do %>
                      <i data-lucide="play" class="w-4 h-4 fill-current"></i>
                    <% end %>
                  <% end %>

                  <% if campaign.running? %>
                    <%= button_to pause_account_campaign_path(@account, campaign), method: :patch, title: 'Pausar Envio', class: 'p-3 bg-amber-500 text-[#0D1117] rounded-xl hover:bg-amber-400 transition-all border-none cursor-pointer shadow-lg shadow-amber-500/10' do %>
                      <i data-lucide="pause" class="w-4 h-4 fill-current"></i>
                    <% end %>
                    
                    <%= button_to cancel_account_campaign_path(@account, campaign), method: :patch, title: 'Cancelar Definitivo', data: { confirm: 'Deseja realmente cancelar esta campanha? Esta ação não pode ser desfeita.' }, class: 'p-3 bg-slate-900 border border-slate-800 text-slate-500 rounded-xl hover:text-white hover:border-slate-600 transition-all cursor-pointer' do %>
                      <i data-lucide="x-circle" class="w-4 h-4"></i>
                    <% end %>
                  <% end %>

                  <%= link_to edit_account_campaign_path(@account, campaign), title: 'Configurações', class: 'p-3 bg-slate-900 border border-slate-800 text-slate-500 rounded-xl hover:text-brand-palette-03 hover:border-brand-palette-03/30 transition-all' do %>
                    <i data-lucide="settings" class="w-4 h-4"></i>
                  <% end %>

                  <% unless campaign.running? %>
                    <%= button_to account_campaign_path(@account, campaign), method: :delete, title: 'Excluir Campanha', data: { confirm: 'Deseja excluir permanentemente esta campanha?' }, class: 'p-3 bg-slate-900 border border-slate-800 text-slate-500 rounded-xl hover:text-red-500 hover:border-red-500/30 transition-all cursor-pointer' do %>
                      <i data-lucide="trash-2" class="w-4 h-4"></i>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    
    <% if @campaigns.empty? %>
      <div class="py-24 flex flex-col items-center justify-center text-center opacity-40">
        <div class="w-24 h-24 bg-slate-900 rounded-full flex items-center justify-center mb-6 border border-slate-800/40">
          <i data-lucide="send" class="w-10 h-10 text-slate-600"></i>
        </div>
        <h3 class="text-sm font-black text-white uppercase tracking-widest">Nenhuma campanha em execução</h3>
        <p class="text-[10px] text-slate-500 max-w-xs mt-3 uppercase tracking-widest leading-loose">Seas campanhas finalizadas ou ativas aparecerão nesta área.</p>
      </div>
    <% end %>
  </div>

  <footer class="mt-8 flex justify-center opacity-20">
     <p class="text-[9px] font-black text-slate-500 uppercase tracking-[0.4em]">Woof CRM • Campaign Flow v3.0 PROFISSIONAL</p>
  </footer>
</div>

<style>
  /* Custom Scrollbar needed for dark theme table containers if they grow */
  .custom-scrollbar::-webkit-scrollbar { width: 4px; height: 4px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #1F2937; border-radius: 10px; }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #374151; }
</style>

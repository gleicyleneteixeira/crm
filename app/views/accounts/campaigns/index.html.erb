<div class="flex flex-col gap-8 p-8 bg-slate-50/50 min-h-screen">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight">Suas Campanhas</h1>
      <p class="text-sm text-slate-500 font-medium mt-1">Gerencie seus disparos e acompanhe o progresso em tempo real.</p>
    </div>
    <%= link_to new_account_campaign_path(@account), class: 'flex items-center gap-2 px-6 py-3 bg-brand-palette-03 text-white rounded-2xl font-bold hover:bg-brand-palette-04 transition-all shadow-lg shadow-brand-palette-03/20 active:scale-95 group' do %>
      <i data-lucide="plus" class="w-5 h-5 group-hover:rotate-90 transition-transform"></i>
      Nova Campanha
    <% end %>
  </div>

  <% if @draft_campaigns.any? %>
    <!-- Dashboard de Retomada -->
    <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm">
      <div class="flex items-center gap-4 mb-6">
        <div class="w-12 h-12 bg-amber-100 rounded-2xl flex items-center justify-center">
          <i data-lucide="history" class="w-6 h-6 text-amber-600"></i>
        </div>
        <div>
          <h2 class="text-lg font-bold text-slate-800">Retomar Rascunhos</h2>
          <p class="text-xs text-slate-500 font-medium uppercase tracking-widest">Você possui <%= pluralize(@draft_campaigns.count, 'campanha', 'campanhas') %> incompletas</p>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @draft_campaigns.limit(3).each do |draft| %>
          <div class="group bg-slate-50 border border-slate-100 p-5 rounded-3xl flex items-center justify-between hover:bg-white hover:border-amber-200 hover:shadow-md transition-all">
            <div class="min-w-0 pr-4">
              <p class="text-sm font-bold text-slate-800 truncate" title="<%= draft.name %>"><%= draft.name %></p>
              <div class="flex items-center gap-2 mt-1">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Passo <%= draft.current_step %>/4 • <%= draft.updated_at.strftime('%d/%m %H:%M') %></p>
              </div>
            </div>
            <% 
              resume_path = case draft.current_step
                            when 1 then edit_account_campaign_path(@account, draft)
                            when 2 then composition_account_campaign_path(@account, draft)
                            when 3 then logistics_account_campaign_path(@account, draft)
                            when 4 then automation_account_campaign_path(@account, draft)
                            else edit_account_campaign_path(@account, draft)
                            end
            %>
            <div class="flex gap-2">
              <%= button_to account_campaign_path(@account, draft), method: :delete, data: { confirm: 'Tem certeza que deseja excluir este rascunho?' }, class: 'p-2.5 bg-white text-slate-400 rounded-xl hover:text-red-500 hover:bg-red-50 transition-all border border-slate-100 cursor-pointer shadow-sm' do %>
                <i data-lucide="trash-2" class="w-4 h-4"></i>
              <% end %>
              <%= link_to resume_path, class: 'p-2.5 bg-white text-amber-600 rounded-xl hover:bg-amber-600 hover:text-white transition-all border border-amber-100 cursor-pointer shadow-sm group-hover:scale-105' do %>
                <i data-lucide="play" class="w-4 h-4 fill-current"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Tabela de Campanhas -->
  <div class="bg-white border border-slate-200 rounded-[2rem] shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-100">
        <thead class="bg-slate-50/50">
          <tr>
            <th class="px-8 py-5 text-left text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Campanha</th>
            <th class="px-8 py-5 text-left text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Progresso</th>
            <th class="px-8 py-5 text-left text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Status</th>
            <th class="px-8 py-5 text-left text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Data de Criação</th>
            <th class="px-8 py-5 text-right text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @campaigns.each do |campaign| %>
            <tr class="hover:bg-slate-50/50 transition-colors">
              <td class="px-8 py-6 whitespace-nowrap">
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-400">
                    <i data-lucide="<%= campaign.running? ? 'zap' : 'send' %>" class="w-5 h-5 <%= 'text-emerald-500' if campaign.running? %>"></i>
                  </div>
                  <div>
                    <%= link_to campaign.name, account_campaign_path(@account, campaign), class: 'text-sm font-bold text-slate-800 hover:text-brand-palette-03' %>
                    <p class="text-[10px] text-slate-400 font-medium"><%= campaign.total_leads %> contatos importados</p>
                  </div>
                </div>
              </td>
              <td class="px-8 py-6 whitespace-nowrap">
                <div class="w-32">
                  <div class="flex items-center justify-between mb-1 text-[9px] font-black text-slate-400 uppercase">
                    <span>Envios</span>
                    <span><%= campaign.processed_leads || 0 %> / <%= campaign.total_leads %></span>
                  </div>
                  <div class="h-1.5 w-full bg-slate-100 rounded-full overflow-hidden">
                    <% progress = campaign.total_leads.to_i > 0 ? (campaign.processed_leads.to_f / campaign.total_leads.to_f * 100).round : 0 %>
                    <div class="h-full bg-brand-palette-03 rounded-full" style="width: <%= progress %>%"></div>
                  </div>
                </div>
              </td>
              <td class="px-8 py-6 whitespace-nowrap">
                <% 
                  status_classes = case campaign.status
                    when 'running' then 'bg-emerald-100 text-emerald-700 border-emerald-200'
                    when 'paused' then 'bg-amber-100 text-amber-700 border-amber-200'
                    when 'completed' then 'bg-blue-100 text-blue-700 border-blue-200'
                    when 'failed' then 'bg-red-100 text-red-700 border-red-200'
                    when 'canceled' then 'bg-slate-100 text-slate-500 border-slate-200'
                    else 'bg-slate-100 text-slate-700 border-slate-200'
                    end
                %>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border <%= status_classes %>">
                  <% if campaign.running? %>
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                    </span>
                  <% end %>
                  <span class="text-[10px] font-black uppercase tracking-wider"><%= campaign.status.humanize %></span>
                </div>
              </td>
              <td class="px-8 py-6 whitespace-nowrap text-xs font-bold text-slate-400">
                <%= campaign.created_at.strftime('%d/%m/%Y') %>
                <span class="block text-[10px] font-medium text-slate-300"><%= campaign.created_at.strftime('%H:%M') %></span>
              </td>
              <td class="px-8 py-6 whitespace-nowrap text-right">
                <div class="flex items-center justify-end gap-2">
                  <% if campaign.paused? || campaign.failed? || campaign.canceled? %>
                    <%= button_to resume_account_campaign_path(@account, campaign), method: :patch, title: 'Iniciar/Retomar', class: 'p-2 text-emerald-600 bg-emerald-50 rounded-lg hover:bg-emerald-600 hover:text-white transition-all border-none cursor-pointer' do %>
                      <i data-lucide="play" class="w-4 h-4 fill-current"></i>
                    <% end %>
                  <% end %>

                  <% if campaign.running? %>
                    <%= button_to pause_account_campaign_path(@account, campaign), method: :patch, title: 'Pausar', class: 'p-2 text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-600 hover:text-white transition-all border-none cursor-pointer' do %>
                      <i data-lucide="pause" class="w-4 h-4 fill-current"></i>
                    <% end %>
                    
                    <%= button_to cancel_account_campaign_path(@account, campaign), method: :patch, title: 'Cancelar', data: { confirm: 'Deseja realmente cancelar esta campanha?' }, class: 'p-2 text-slate-400 bg-slate-50 rounded-lg hover:bg-slate-600 hover:text-white transition-all border-none cursor-pointer' do %>
                      <i data-lucide="x-circle" class="w-4 h-4"></i>
                    <% end %>
                  <% end %>

                  <%= link_to edit_account_campaign_path(@account, campaign), title: 'Editar', class: 'p-2 text-slate-400 bg-slate-50 rounded-lg hover:bg-brand-palette-03 hover:text-white transition-all' do %>
                    <i data-lucide="pencil" class="w-4 h-4"></i>
                  <% end %>

                  <% unless campaign.running? %>
                    <%= button_to account_campaign_path(@account, campaign), method: :delete, title: 'Excluir', data: { confirm: 'Excluir permanentemente esta campanha?' }, class: 'p-2 text-slate-400 bg-slate-50 rounded-lg hover:bg-red-500 hover:text-white transition-all border-none cursor-pointer' do %>
                      <i data-lucide="trash-2" class="w-4 h-4"></i>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    
    <% if @campaigns.empty? %>
      <div class="py-20 flex flex-col items-center justify-center text-center">
        <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mb-4">
          <i data-lucide="send" class="w-10 h-10 text-slate-200"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-800">Nenhuma campanha iniciada</h3>
        <p class="text-sm text-slate-500 max-w-xs mt-2">Suas campanhas ativas e finalizadas aparecerão aqui. Comece criando uma nova agora mesmo!</p>
      </div>
    <% end %>
  </div>
</div>

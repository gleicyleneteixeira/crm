<div class="max-w-4xl mx-auto py-8">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="typography-title-b-lh150 text-dark-gray-palette-p1"><%= @campaign.name %></h1>
      <p class="typography-body-s-lh150 text-slate-500">Resumo da Campanha e Status de Execução</p>
    </div>
    <div class="flex items-center gap-4">
      <span class="px-3 py-1 rounded-full typography-micro-b-lh150 <%= @campaign.completed? ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800' %>">
        <%= @campaign.status.humanize %>
      </span>
      <% if @campaign.draft? %>
        <%= button_to 'Iniciar Processamento', process_campaign_account_campaign_path(current_user.account, @campaign), method: :post, class: 'btn-primary' %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="md:col-span-2 space-y-8">
      <!-- Configurações -->
      <section class="bg-white dark:bg-slate-900 p-8 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700">
        <h2 class="typography-title-s-lh150 text-dark-gray-palette-p1 mb-6">Configurações de Envio</h2>
        
        <div class="grid grid-cols-2 gap-6">
          <div>
            <p class="typography-micro-b-lh150 text-slate-500 uppercase mb-1">Total de Contatos</p>
            <p class="typography-body-b-lh150 text-dark-gray-palette-p1"><%= @campaign.spreadsheet_data.count - 1 %> contatos</p>
          </div>
          <div>
            <p class="typography-micro-b-lh150 text-slate-500 uppercase mb-1">Intervalo (Delay)</p>
            <p class="typography-body-b-lh150 text-dark-gray-palette-p1"><%= @campaign.batch_delay %> segundos</p>
          </div>
          <div>
            <p class="typography-micro-b-lh150 text-slate-500 uppercase mb-1">Pipeline de Destino</p>
            <p class="typography-body-b-lh150 text-dark-gray-palette-p1"><%= @campaign.pipeline&.name || 'Nenhum' %></p>
          </div>
          <div>
            <p class="typography-micro-b-lh150 text-slate-500 uppercase mb-1">Estágio Inicial</p>
            <p class="typography-body-b-lh150 text-dark-gray-palette-p1"><%= @campaign.stage&.name || 'Nenhum' %></p>
          </div>
        </div>
      </section>

      <!-- Mensagens -->
      <section class="bg-white dark:bg-slate-900 p-8 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700">
        <h2 class="typography-title-s-lh150 text-dark-gray-palette-p1 mb-6">Sequência de Mensagens</h2>
        <div class="space-y-4">
          <% @campaign.message_sequence&.each_with_index do |block, index| %>
            <div class="flex items-start gap-4 p-4 bg-slate-50 dark:bg-slate-800 rounded-lg border border-slate-100 dark:border-slate-800">
              <span class="w-8 h-8 flex items-center justify-center bg-brand-palette-03 text-white rounded-full text-xs font-bold"><%= index + 1 %></span>
              <div>
                <p class="typography-micro-b-lh150 text-slate-500 uppercase mb-1"><%= block['type'].capitalize %></p>
                <p class="typography-body-s-lh150 text-dark-gray-palette-p1 whitespace-pre-wrap"><%= block['content'] %></p>
              </div>
            </div>
          <% end %>
        </div>
      </section>

      <!-- Logs -->
      <section class="bg-white dark:bg-slate-900 p-8 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700">
        <h2 class="typography-title-s-lh150 text-dark-gray-palette-p1 mb-6">Relatório de Execução</h2>
        <div class="space-y-2">
          <% if @campaign.campaign_logs.empty? %>
            <p class="text-slate-500 typography-body-s-lh150 italic">Nenhum log disponível ainda. Inicie o processamento para ver os detalhes.</p>
          <% else %>
            <% @campaign.campaign_logs.order(created_at: :desc).limit(50).each do |log| %>
              <div class="flex items-center justify-between p-3 rounded-lg border <%= log.status == 'success' ? 'border-green-100 bg-green-50 dark:bg-green-900/10' : 'border-red-100 bg-red-50 dark:bg-red-900/10' %>">
                <div class="flex items-center gap-3">
                  <i data-lucide="<%= log.status == 'success' ? 'check-circle-2' : 'alert-circle' %>" class="w-4 h-4 <%= log.status == 'success' ? 'text-green-500' : 'text-red-500' %>"></i>
                  <span class="typography-body-s-lh150 text-dark-gray-palette-p1"><%= log.message %></span>
                </div>
                <span class="text-[10px] text-slate-400 uppercase font-bold"><%= log.created_at.strftime('%H:%M:%S') %></span>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>
    </div>

    <div class="space-y-8">
      <!-- Resumo Rápido -->
      <section class="bg-brand-palette-03 p-8 rounded-xl shadow-lg text-white">
        <h3 class="typography-title-s-lh150 mb-4">Inboxes Selecionadas</h3>
        <ul class="space-y-2 opacity-90">
          <% @campaign.chatwoot_inbox_ids&.each do |inbox_id| %>
            <li class="flex items-center gap-2 text-sm">
              <i data-lucide="check" class="w-4 h-4"></i>
              ID da Inbox: <%= inbox_id %>
            </li>
          <% end %>
        </ul>
      </section>

      <div class="flex flex-col gap-2">
        <%= link_to 'Editar Configurações', composition_account_campaign_path(current_user.account, @campaign), class: 'btn-secondary w-full text-center' %>
        <%= button_to 'Remover Campanha', account_campaign_path(current_user.account, @campaign), method: :delete, data: { confirm: 'Tem certeza?' }, class: 'text-red-500 hover:text-red-700 text-xs font-bold uppercase py-2 w-full' %>
      </div>
    </div>
  </div>
</div>

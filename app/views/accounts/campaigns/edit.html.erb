<div class="h-[calc(100vh-80px)] overflow-y-auto w-full">
  <div class="w-full px-4 sm:px-6 lg:px-8 py-8 mx-auto">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="typography-title-b-lh150 text-dark-gray-palette-p1">Editar Campanha</h1>
        <p class="typography-body-s-lh150 text-slate-500">Passo 1: Configurações Básicas e Destino</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-3 py-1 bg-brand-palette-03/10 text-brand-palette-03 rounded-full typography-micro-b-lh150 font-bold">Passo 1 de 3</span>
      </div>
    </div>

    <%= form_with(model: [current_user.account, @campaign], data: { controller: 'campaign-import' }, class: "max-w-4xl mx-auto") do |f| %>
      <div class="bg-white dark:bg-slate-900 p-8 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 space-y-8">
        
        <!-- Basic Info Section -->
        <div>
          <h2 class="typography-title-s-lh150 text-dark-gray-palette-p1 mb-6 flex items-center gap-2">
            <i data-lucide="settings" class="w-5 h-5 text-brand-palette-03"></i> Identificação
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= f.label :name, 'Nome da Campanha', class: 'block typography-micro-b-lh150 text-slate-700 mb-2' %>
              <%= f.text_field :name, class: 'w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-800 focus:border-brand-palette-03 focus:ring-brand-palette-03 text-sm', placeholder: 'Ex: Lançamento Março 2024', required: true %>
            </div>
            
            <div>
              <%= f.label :campaign_category_id, 'Tipo de Campanha', class: 'block typography-micro-b-lh150 text-slate-700 mb-2' %>
              <div class="flex gap-2">
                <%= f.collection_select :campaign_category_id, @campaign_categories, :id, :name, { prompt: 'Selecione...' }, { id: 'category-select-options', class: 'w-full rounded-lg border-slate-300 focus:border-brand-palette-03 focus:ring-brand-palette-03 dark:bg-slate-800 dark:border-slate-600 text-sm', required: true, data: { action: 'change->campaign-import#handleCategoryChange' } } %>
                <%= link_to new_account_campaign_category_path(current_user.account), class: 'btn-secondary px-3 flex items-center justify-center', title: 'Novo Tipo de Campanha', data: { turbo_frame: 'modal' } do %>
                  <i data-lucide="plus" class="w-5 h-5"></i>
                <% end %>
              </div>
              
              <div class="mt-4 p-3 bg-slate-50 dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700">
                <label class="flex items-center gap-2 cursor-pointer mb-2">
                  <input type="checkbox" name="campaign[map_category_to_crm]" <%= @campaign.mapping&.key?('__campaign_category_target__') ? 'checked' : '' %> data-action="change->campaign-import#toggleCategoryMapping" class="rounded border-slate-300 text-brand-palette-03 focus:ring-brand-palette-03">
                  <span class="text-xs text-slate-700 dark:text-slate-300 font-bold uppercase">Mapear valor do Tipo para o CRM?</span>
                </label>
                <p class="text-[10px] text-slate-500 mb-2">Se marcado, o nome do tipo (ex: "Portabilidade") será salvo no campo escolhido abaixo para todos os contatos.</p>
                <div data-campaign-import-target="categoryMappingContainer" class="<%= @campaign.mapping&.key?('__campaign_category_target__') ? '' : 'hidden' %>">
                   <select name="campaign[mapping][__campaign_category_target__]" class="w-full text-xs py-2 px-2 rounded-md border-slate-300 dark:border-slate-600 dark:bg-slate-800 focus:border-brand-palette-03">
                    <option value="">Escolha o campo de destino...</option>
                    <% if @crm_fields['Negócio'] %>
                      <% @crm_fields['Negócio'].each do |label, key| %>
                        <option value="<%= key %>" <%= @campaign.mapping&.[]('__campaign_category_target__') == key ? 'selected' : '' %>><%= label %></option>
                      <% end %>
                    <% end %>
                  </select>
                </div>
              </div>
            </div>
          </div>
        </div>

        <hr class="border-slate-100 dark:border-slate-800">

        <!-- Destination Section -->
        <div>
          <h2 class="typography-title-s-lh150 text-dark-gray-palette-p1 mb-6 flex items-center gap-2">
            <i data-lucide="git-merge" class="w-5 h-5 text-brand-palette-03"></i> Funil de Vendas (CRM)
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= f.label :pipeline_id, 'Pipeline de Destino', class: 'block typography-micro-b-lh150 text-slate-700 mb-2' %>
              <%= f.collection_select :pipeline_id, @pipelines, :id, :name, { prompt: 'Selecione o funil...' }, { class: 'w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-800 focus:border-brand-palette-03 text-sm', data: { action: 'change->campaign-import#handlePipelineChange', 'campaign-import-target': 'pipelineSelect' }, required: true } %>
            </div>
            
            <div>
              <%= f.label :stage_id, 'Etapa Inicial', class: 'block typography-micro-b-lh150 text-slate-700 mb-2' %>
              <%= f.select :stage_id, [], { prompt: 'Selecione o funil primeiro...' }, { class: 'w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-800 focus:border-brand-palette-03 text-sm', data: { 'campaign-import-target': 'stageSelect' }, required: true } %>
            </div>
          </div>
        </div>

        <hr class="border-slate-100 dark:border-slate-800">

        <!-- Rules Section -->
        <div>
          <h2 class="typography-title-s-lh150 text-dark-gray-palette-p1 mb-6 flex items-center gap-2">
            <i data-lucide="shield-check" class="w-5 h-5 text-brand-palette-03"></i> Regras e Filtros
          </h2>
          
          <div class="space-y-6">
            <div>
              <label class="block typography-micro-b-lh150 text-slate-700 mb-3 uppercase">Telefones que já estão no CRM:</label>
              <div class="flex flex-col sm:flex-row gap-4">
                <label class="flex-1 flex items-center gap-3 p-4 border border-slate-200 dark:border-slate-700 rounded-lg cursor-pointer hover:bg-slate-50 transition-colors">
                  <%= f.radio_button :duplicate_action, 'update', checked: true, class: 'text-brand-palette-03 focus:ring-brand-palette-03' %>
                  <span class="text-sm font-medium text-slate-700 font-bold">Atualizar dados</span>
                </label>
                <label class="flex-1 flex items-center gap-3 p-4 border border-slate-200 dark:border-slate-700 rounded-lg cursor-pointer hover:bg-slate-50 transition-colors">
                  <%= f.radio_button :duplicate_action, 'keep', class: 'text-brand-palette-03 focus:ring-brand-palette-03' %>
                  <span class="text-sm font-medium text-slate-700 font-bold">Manter dados atuais</span>
                </label>
              </div>
            </div>

            <div class="p-4 bg-brand-palette-03/5 rounded-lg border border-brand-palette-03/10">
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="checkbox" id="insert_ddi" name="campaign[insert_ddi]" <%= @campaign.insert_ddi ? 'checked' : '' %> class="rounded border-slate-300 text-brand-palette-03 focus:ring-brand-palette-03">
                <div>
                  <span class="block text-sm font-bold text-brand-palette-03">Inserir DDI 55 Automaticamente</span>
                  <p class="text-xs text-slate-500">Recomendado para evitar erros de envio em números nacionais sem prefixo.</p>
                </div>
              </label>
            </div>
          </div>
        </div>

        <div class="pt-6 border-t border-slate-100 dark:border-slate-800 flex justify-end gap-4">
          <%= link_to 'Cancelar', account_campaigns_path(current_user.account), class: 'btn-secondary px-8 py-3' %>
          <%= f.button 'Salvar e Próximo <i data-lucide="arrow-right" class="ml-2 w-4 h-4"></i>'.html_safe, type: 'submit', class: 'btn-primary px-10 py-3 flex items-center shadow-lg hover:shadow-xl transition-all' %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script type="module">
  import { Controller } from "@hotwired/stimulus"
  const application = window.Stimulus
  
  if (application && !application.controllers.some(c => c.identifier === "campaign-import")) {
    application.register("campaign-import", class extends Controller {
      static targets = ["pipelineSelect", "stageSelect", "categoryMappingContainer"]
      
      connect() {
        this.pipelinesData = <%= raw @pipelines.to_json(include: :stages) %>
        this.currentStage = "<%= @campaign.stage_id %>"
        if (this.pipelineSelectTarget.value) {
          this.handlePipelineChange()
        }
      }
      
      handlePipelineChange() {
        const pipelineId = this.pipelineSelectTarget.value
        const stageSelect = this.stageSelectTarget
        stageSelect.innerHTML = '<option value="">Selecione...</option>'
        
        if (pipelineId) {
          const pipeline = this.pipelinesData.find(p => p.id.toString() === pipelineId.toString())
          if (pipeline && pipeline.stages) {
            pipeline.stages.forEach(s => {
              const op = document.createElement('option')
              op.value = s.id; op.textContent = s.name; 
              if (s.id.toString() === this.currentStage) op.selected = true;
              stageSelect.appendChild(op)
            })
          }
        }
      }

      toggleCategoryMapping(event) {
        if (event.target.checked) {
          this.categoryMappingContainerTarget.classList.remove('hidden')
        } else {
          this.categoryMappingContainerTarget.classList.add('hidden')
          this.categoryMappingContainerTarget.querySelector('select').value = ''
        }
      }
    })
  }
</script>

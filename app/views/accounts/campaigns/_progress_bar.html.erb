<div id="campaign_progress_bar" class="w-full bg-slate-900/40 backdrop-blur-md rounded-2xl p-4 border border-slate-800 shadow-2xl">
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-brand-palette-03/20 rounded-xl flex items-center justify-center border border-brand-palette-03/30 shadow-[0_0_15px_rgba(59,130,246,0.2)]">
        <i data-lucide="rocket" class="w-5 h-5 text-brand-palette-03"></i>
      </div>
      <div>
        <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-none">Status da Campanha</p>
        <div class="flex items-center gap-2 mt-1">
          <span class="w-2 h-2 rounded-full bg-brand-palette-03 animate-pulse"></span>
          <p class="text-sm font-bold text-white capitalize"><%= campaign.status %></p>
        </div>
      </div>
    </div>
    <div class="flex gap-6">
      <div class="text-right">
        <p class="text-[10px] font-black text-emerald-500 uppercase tracking-widest leading-none">Disparados</p>
        <p class="text-lg font-bold text-white mt-1"><%= campaign.processed_leads || 0 %></p>
      </div>
      <div class="text-right border-l border-slate-800 pl-6">
        <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-none">Pendentes</p>
        <p class="text-lg font-bold text-slate-300 mt-1"><%= (campaign.total_leads.to_i - campaign.processed_leads.to_i) %></p>
      </div>
    </div>
  </div>

  <div class="relative pt-1">
    <div class="flex mb-2 items-center justify-between">
      <div>
        <span class="text-xs font-semibold inline-block py-1 px-2 uppercase rounded-full text-brand-palette-03 bg-brand-palette-03/20 border border-brand-palette-03/30">
          Progresso Global
        </span>
      </div>
      <div class="text-right">
        <span class="text-xs font-bold inline-block text-white">
          <% progress = campaign.total_leads.to_i > 0 ? (campaign.processed_leads.to_f / campaign.total_leads.to_f * 100).round : 0 %>
          <%= progress %>%
        </span>
      </div>
    </div>
    <div class="overflow-hidden h-3 mb-1 text-xs flex rounded-full bg-slate-800/80 border border-slate-700/50 shadow-inner">
      <div style="width:<%= progress %>%" class="shadow-none flex flex-col text-center whitespace-nowrap text-white justify-center bg-gradient-to-r from-brand-palette-03 to-emerald-500 transition-all duration-1000 ease-in-out relative">
        <div class="absolute inset-0 bg-[linear-gradient(45deg,rgba(255,255,255,0.1)_25%,transparent_25%,transparent_50%,rgba(255,255,255,0.1)_50%,rgba(255,255,255,0.1)_75%,transparent_75%,transparent)] bg-[length:20px_20px] animate-[pulse_2s_linear_infinite]"></div>
      </div>
    </div>
    <p class="text-[9px] text-slate-500 mt-1 italic italic italic">Atualizado em tempo real via Turbo Stream</p>
  </div>
</div>

<div class="h-[calc(100vh-80px)] overflow-hidden w-full bg-[#0B0E14] text-slate-300 flex flex-col font-sans" 
     data-controller="campaign--composition"
     data-campaign--composition-headers-value="<%= (@campaign.spreadsheet_data&.first || []).to_json %>"
     data-campaign--composition-sample-row-value="<%= (@campaign.spreadsheet_data&.second || []).to_json %>"
     data-campaign--composition-initial-sequence-value="<%= @campaign.message_sequence.to_json %>">
  <!-- Top Progress Bar / Header -->
  <header class="bg-[#0B0E14] border-b border-slate-800/60 px-8 py-4 flex items-center justify-between shrink-0 z-30">
    <div class="flex items-center gap-4">
      <div class="w-10 h-10 bg-emerald-500/10 rounded-xl flex items-center justify-center border border-emerald-500/20">
        <i data-lucide="message-square" class="w-5 h-5 text-emerald-500"></i>
      </div>
      <div>
        <h1 class="text-lg font-bold text-white leading-tight">Mensagens</h1>
        <p class="text-[10px] text-slate-500 font-bold uppercase tracking-wider">Etapa 2: Conteúdo</p>
      </div>
    </div>
    
    <div class="flex items-center gap-6">
      <nav class="flex items-center gap-1 bg-slate-900/50 p-1 rounded-full border border-slate-800/50">
         <div class="w-8 h-8 rounded-full flex items-center justify-center text-emerald-500">
            <i data-lucide="check-circle-2" class="w-5 h-5"></i>
         </div>
         <div class="flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
            <span class="text-[10px] font-bold">2</span>
            <span class="text-[10px] font-black uppercase tracking-widest">Mensagens</span>
         </div>
         <div class="px-4 py-1.5 rounded-full text-slate-600">
            <span class="text-[10px] font-bold">3</span>
         </div>
         <div class="px-4 py-1.5 rounded-full text-slate-600">
            <span class="text-[10px] font-bold">4</span>
         </div>
      </nav>
      <div class="h-8 w-px bg-slate-800/60"></div>
      <%= link_to edit_account_campaign_path(@account, @campaign), class: 'text-[10px] font-black text-slate-500 hover:text-white transition-colors uppercase tracking-widest flex items-center gap-2' do %>
        <i data-lucide="arrow-left" class="w-3 h-3"></i> Voltar
      <% end %>
    </div>
  </header>

  <!-- Content Area -->
  <main class="flex-1 overflow-y-auto custom-scrollbar p-8">
    <div class="max-w-6xl mx-auto space-y-8">
      
      <!-- Variables Tray -->
      <section class="bg-[#161B22] border border-slate-800/60 rounded-2xl p-4 flex items-center gap-4">
        <div class="flex items-center gap-2 shrink-0">
          <i data-lucide="hash" class="w-4 h-4 text-emerald-500"></i>
          <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Variáveis:</span>
        </div>
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
          <!-- Smart Variable first_name -->
          <button type="button" 
                  data-action="click->campaign--composition#insertVariable"
                  data-variable="first_name"
                  class="px-3 py-1.5 bg-brand-palette-03/20 border border-brand-palette-03/40 rounded-lg text-[10px] font-black text-brand-palette-03 hover:border-brand-palette-03 transition-all shrink-0 flex items-center gap-1">
            <i data-lucide="sparkles" class="w-3 h-3"></i> {{first_name}}
          </button>

          <% headers = @campaign.spreadsheet_data&.first || [] %>
          <% headers.each do |header| %>
            <% var_name = header.parameterize.underscore %>
            <button type="button" 
                    data-action="click->campaign--composition#insertVariable"
                    data-variable="<%= var_name %>"
                    class="px-3 py-1.5 bg-[#0D1117] border border-slate-800 rounded-lg text-[10px] font-bold text-emerald-500 hover:border-emerald-500/50 transition-all shrink-0">
              {{<%= var_name %>}}
            </button>
          <% end %>
        </div>
      </section>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <!-- New Message Creator -->
        <section class="space-y-6">
          <div class="flex items-center justify-between">
             <div class="flex items-center gap-3">
               <i data-lucide="message-square-plus" class="w-5 h-5 text-emerald-500"></i>
               <h3 class="text-sm font-black text-white uppercase tracking-wider">Editor de Mensagem</h3>
             </div>
             
             <!-- Toggles AI/Audio Dashboard Look -->
             <div class="flex items-center gap-3">
               <div class="flex items-center gap-2 px-2 py-1 bg-slate-900 border border-slate-800 rounded-lg">
                 <span class="text-[8px] font-black uppercase text-slate-500">Anti-Ban</span>
                 <label class="relative inline-flex items-center cursor-pointer">
                   <input type="checkbox" id="toggle-ai" class="sr-only peer" data-action="change->campaign--composition#toggleAI">
                   <div class="w-6 h-3 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-2 after:w-2 after:transition-all peer-checked:bg-emerald-500"></div>
                 </label>
               </div>
               <div class="flex items-center gap-2 px-2 py-1 bg-slate-900 border border-slate-800 rounded-lg">
                 <span class="text-[8px] font-black uppercase text-slate-500">Áudio</span>
                 <label class="relative inline-flex items-center cursor-pointer">
                   <input type="checkbox" id="toggle-audio" class="sr-only peer" data-action="change->campaign--composition#toggleAudio">
                   <div class="w-6 h-3 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-2 after:w-2 after:transition-all peer-checked:bg-amber-500"></div>
                 </label>
               </div>
             </div>
          </div>

          <div class="bg-[#161B22] border border-slate-800/60 rounded-[2rem] p-8 shadow-2xl relative">
             <div class="space-y-6">
                <!-- Message Type Tabs -->
                <div class="space-y-3">
                   <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest pl-2">Tipo de mensagem</span>
                   <div class="flex items-center gap-2">
                      <button type="button" data-action="click->campaign--composition#setMessageType" data-type="text" class="px-4 py-2 bg-emerald-500/20 text-emerald-500 border border-emerald-500/30 rounded-xl text-[10px] font-black uppercase tracking-widest flex items-center gap-2 transition-all">
                        <i data-lucide="text" class="w-3 h-3"></i> Texto
                      </button>
                      <button type="button" data-action="click->campaign--composition#setMessageType" data-type="image" class="px-4 py-2 bg-slate-900 text-slate-500 border border-slate-800 rounded-xl text-[10px] font-black uppercase tracking-widest flex items-center gap-2 hover:border-slate-700 transition-all">
                        <i data-lucide="image" class="w-3 h-3"></i> Imagem
                      </button>
                      <button type="button" data-action="click->campaign--composition#setMessageType" data-type="audio" class="px-4 py-2 bg-slate-900 text-slate-500 border border-slate-800 rounded-xl text-[10px] font-black uppercase tracking-widest flex items-center gap-2 hover:border-slate-700 transition-all">
                        <i data-lucide="mic" class="w-3 h-3"></i> Áudio
                      </button>
                      <button type="button" data-action="click->campaign--composition#setMessageType" data-type="video" class="px-4 py-2 bg-slate-900 text-slate-500 border border-slate-800 rounded-xl text-[10px] font-black uppercase tracking-widest flex items-center gap-2 hover:border-slate-700 transition-all">
                        <i data-lucide="video" class="w-3 h-3"></i> Vídeo
                      </button>
                      <button type="button" data-action="click->campaign--composition#setMessageType" data-type="document" class="px-4 py-2 bg-slate-900 text-slate-500 border border-slate-800 rounded-xl text-[10px] font-black uppercase tracking-widest flex items-center gap-2 hover:border-slate-700 transition-all">
                        <i data-lucide="file-text" class="w-3 h-3"></i> Documento
                      </button>
                   </div>
                </div>

                <!-- Textarea Area -->
                <div class="bg-[#0D1117] rounded-3xl border border-slate-800 p-6 focus-within:border-emerald-500/50 shadow-inner transition-all group">
                   <textarea id="message-editor" 
                             data-campaign--composition-target="editor"
                             data-action="input->campaign--composition#updateAddButtonState"
                             class="w-full bg-transparent border-none p-0 text-sm text-white placeholder-slate-700 min-h-[160px] focus:ring-0 resize-none leading-relaxed" 
                             placeholder="Olá {{nome}}! Digite sua mensagem aqui..."></textarea>
                   
                   <div class="flex items-center justify-between mt-4 border-t border-slate-800/50 pt-4">
                      <div class="flex items-center gap-2">
                         <button type="button" 
                                 id="btn-generate-ai"
                                 class="hidden px-3 py-1.5 bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 rounded-lg hover:bg-emerald-500/20 transition-all text-[10px] font-bold flex items-center gap-2">
                         </button>
                         <button type="button" 
                                 id="btn-generate-audio"
                                 class="hidden px-3 py-1.5 bg-amber-500/10 text-amber-500 border border-amber-500/20 rounded-lg hover:bg-amber-500/20 transition-all text-[10px] font-bold flex items-center gap-2"
                                 data-action="click->campaign--composition#generateAudioPreview"
                                 data-campaign--composition-target="audioButton">
                           <i data-lucide="mic" class="w-3 h-3"></i> Gerar Áudio
                         </button>
                      </div>
                      <div class="flex items-center gap-2 relative">
                        <!-- Emoji Picker Popover -->
                        <div id="emoji-picker" 
                             class="absolute bottom-full left-0 mb-2 bg-[#161B22] border border-slate-700 rounded-2xl p-4 shadow-2xl z-50 grid grid-cols-6 gap-2 hidden animate-in slide-in-from-bottom-2"
                             data-campaign--composition-target="emojiPicker">
                           <% ['😀', '😃', '😄', '😁', '😅', '😂', '🤣', '😊', '😇', '🙂', '🙃', '😉', '😌', '😍', '🥰', '😘', '😗', '😙', '😚', '😋', '😛', '😝', '😜', '🤪', '🤨', '🧐', '🤓', '😎', '🤩', '🥳'].each do |emoji| %>
                             <button type="button" class="text-lg hover:bg-slate-800 p-1 rounded transition-colors" data-action="click->campaign--composition#insertEmoji"><%= emoji %></button>
                           <% end %>
                        </div>

                        <button type="button" 
                                data-action="click->campaign--composition#toggleEmojiPicker"
                                class="p-2 text-slate-600 hover:text-emerald-500 transition-all">
                           <i data-lucide="smile" class="w-5 h-5"></i>
                        </button>

                        <button type="button" class="p-2 text-slate-600 hover:text-emerald-500 transition-all">
                           <i data-lucide="sticker" class="w-5 h-5"></i>
                        </button>
                        
                        <button type="button" 
                                data-action="click->campaign--composition#openFileSelector"
                                class="p-2 text-slate-600 hover:text-emerald-500 transition-all">
                           <i data-lucide="paperclip" class="w-5 h-5"></i>
                        </button>

                        <button type="button" class="p-2 text-slate-600 hover:text-emerald-500 transition-all">
                           <i data-lucide="mic" class="w-5 h-5"></i>
                        </button>
                        <input type="file" class="hidden" data-campaign--composition-target="fileInput" data-action="change->campaign--composition#handleFileSelect">
                      </div>
                   </div>
                </div>

                <!-- Big Add Button -->
                <button type="button" 
                        data-action="click->campaign--composition#addBlock"
                        data-campaign--composition-target="addButton"
                        class="w-full py-4 bg-slate-900 border border-slate-800/60 rounded-2xl text-slate-400 font-bold text-xs uppercase tracking-widest hover:bg-emerald-500/10 hover:text-emerald-500 hover:border-emerald-500/30 transition-all flex items-center justify-center gap-3 active:scale-[0.98]">
                   <i data-lucide="plus" class="w-4 h-4"></i>
                   Adicionar Mensagem
                </button>

                <!-- AI Variations Display -->
                <div id="ai-variations-container" class="hidden space-y-3" data-campaign--composition-target="aiVariationsContainer">
                   <h4 class="text-[9px] font-black text-slate-500 uppercase tracking-widest pl-2">Sugestões IA (Groq)</h4>
                   <div class="grid grid-cols-1 gap-2" data-campaign--composition-target="aiVariationsList">
                      <!-- Variation cards will be injected here -->
                   </div>
                </div>
             </div>
          </div>
        </section>

        <!-- Live Preview -->
        <section class="space-y-6">
          <div class="flex items-center gap-3">
             <i data-lucide="eye" class="w-5 h-5 text-emerald-500"></i>
             <h3 class="text-sm font-black text-white uppercase tracking-wider">Simulador WhatsApp</h3>
          </div>

          <div class="bg-[#161B22] border border-slate-800/60 rounded-[2rem] p-8 min-h-[500px] max-h-[600px] flex flex-col relative group">
             <div class="absolute inset-0 bg-grid-slate-700/[0.1] [mask-image:linear-gradient(to_bottom,white,transparent)] -z-10"></div>
             
             <div class="flex-1 flex flex-col overflow-hidden">
                <div class="self-start text-[10px] font-bold text-slate-500 uppercase tracking-widest pl-4 mb-4">Simulador</div>
                
                <!-- Scrollable Messages History -->
                <div id="simulator-body" 
                     class="flex-1 overflow-y-auto custom-scrollbar space-y-4 px-2 pb-4 flex flex-col pt-2"
                     data-campaign--composition-target="simulatorBody">
                   <div id="simulator-history" class="space-y-4 flex flex-col" data-campaign--composition-target="simulatorHistory">
                      <!-- Saved messages will appear here -->
                   </div>
                   
                   <!-- Current Typing Preview Bubble (Always at bottom) -->
                   <div class="mt-auto pt-4">
                      <div class="self-start text-[8px] font-bold text-emerald-500/50 uppercase tracking-widest pl-2 mb-1">Digitando...</div>
                      <div class="bg-[#0D1117] border border-emerald-500/30 p-6 rounded-2xl rounded-tl-none shadow-2xl max-w-[90%] animate-in fade-in slide-in-from-left-2 transition-all">
                         <p id="preview-text" class="text-sm text-slate-300 leading-relaxed" data-campaign--composition-target="previewText">
                           Sua prévia aparecerá aqui conforme você digita...
                         </p>
                         
                         <!-- Audio Player Preview -->
                         <div id="audio-preview-container" class="mt-4 pt-4 border-t border-slate-800 hidden" data-campaign--composition-target="audioPreviewContainer">
                            <div class="flex items-center gap-3">
                               <div class="w-8 h-8 rounded-full bg-emerald-500/10 flex items-center justify-center">
                                  <i data-lucide="play" class="w-4 h-4 text-emerald-500"></i>
                               </div>
                               <div class="flex-1">
                                  <div class="h-1 bg-slate-800 rounded-full w-full mb-1"></div>
                                  <span class="text-[9px] text-slate-500 uppercase font-black tracking-widest">Áudio Gerado</span>
                               </div>
                               <audio id="audio-player" class="hidden" data-campaign--composition-target="audioPlayer" controls></audio>
                            </div>
                         </div>
                      </div>
                   </div>
                </div>
             </div>
          </div>
        </section>
      </div>

      <!-- Configured Messages List -->
      <section class="space-y-6 pb-24">
        <div class="flex items-center justify-between">
           <div class="flex items-center gap-3">
              <i data-lucide="list-checks" class="w-5 h-5 text-emerald-500"></i>
              <h3 class="text-sm font-black text-white uppercase tracking-wider">Sequência de Envio (<span data-campaign--composition-target="count">0</span>)</h3>
           </div>
        </div>

        <div id="messages-list" class="space-y-4" data-campaign--composition-target="messagesList">
           <!-- Items will be injected here via Stimulus -->
           <div class="no-messages-placeholder flex items-center justify-center p-12 bg-slate-900/20 border-2 border-dashed border-slate-800 rounded-[2rem]">
              <div class="text-center text-slate-600">
                 <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-4 opacity-20"></i>
                 <p class="text-xs font-bold uppercase tracking-widest">Nenhuma mensagem adicionada</p>
              </div>
           </div>
        </div>
      </section>
    </div>
  </main>

  <!-- Navigation Footer -->
  <footer class="h-24 bg-[#0B0E14] border-t border-slate-800/60 px-12 flex items-center justify-between shrink-0 z-40">
     <div class="flex items-center gap-6">
        <div class="flex flex-col">
           <span class="text-[9px] font-black text-slate-500 uppercase tracking-widest">Estado da Campanha</span>
           <span class="text-xs font-bold text-emerald-500" data-campaign--composition-target="status">Rascunho Salvo Automatizado</span>
        </div>
     </div>

     <%= form_with(model: [@account, @campaign], url: update_composition_account_campaign_path(@account, @campaign), method: :patch, id: 'campaign-form') do |f| %>
       <div data-campaign--composition-target="blocksContainer" class="hidden">
          <!-- Hidden inputs for actual persistence -->
       </div>
       <div class="flex items-center gap-4">
          <%= f.submit 'Salvar e Ver Logística', class: 'px-12 py-4 bg-[#161B22] border border-slate-700 text-slate-300 rounded-2xl font-black text-xs uppercase tracking-[0.15em] hover:bg-[#232931] transition-all' %>
          <button type="submit" class="px-12 py-4 bg-emerald-500 text-[#0D1117] rounded-2xl font-black text-xs uppercase tracking-[0.2em] shadow-xl shadow-emerald-500/20 hover:bg-emerald-400 transition-all active:scale-95 flex items-center gap-2">
             Próximo: Logística
             <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>
       </div>
     <% end %>
  </footer>

  <template data-campaign--composition-target="blockTemplate">
    <div class="message-item bg-[#161B22] border border-slate-800 rounded-2xl p-4 flex items-center gap-6 group hover:border-emerald-500/30 transition-all animate-in zoom-in-95" data-index="INDEX">
       <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-black text-[10px] index-wrapper">
         <span class="index-tag">INDEX</span>
       </div>
       <div class="flex-1">
          <p class="text-xs text-white font-bold truncate message-preview-line">CONTENT</p>
          <span class="text-[9px] text-slate-500 font-bold uppercase type-tag">TEXTO</span>
       </div>
        <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
          <button type="button" data-action="click->campaign--composition#removeBlock" class="p-2 bg-[#0D1117] text-slate-400 hover:text-red-500 rounded-lg transition-colors">
            <i data-lucide="trash-2" class="w-4 h-4"></i>
          </button>
        </div>
    </div>
  </template>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  
  .custom-scrollbar::-webkit-scrollbar { width: 5px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #1F2937; border-radius: 10px; }
</style>

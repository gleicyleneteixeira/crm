<div class="h-[calc(100vh-80px)] overflow-y-auto w-full">
  <div class="max-w-4xl px-4 mx-auto py-8">
    <div>
      <h1 class="typography-title-b-lh150 text-dark-gray-palette-p1">Configurações de Disparo</h1>
      <p class="typography-body-s-lh150 text-slate-500">Defina onde os contatos serão salvos e regras de duplicidade do CRM.</p>
    </div>
    <div class="flex items-center gap-2 mt-2">
      <span class="px-3 py-1 bg-brand-palette-03/10 text-brand-palette-03 rounded-full typography-micro-b-lh150 font-bold">Passo 3 de 3</span>
    </div>
  </div>

  <%= form_with(model: @campaign, url: update_settings_account_campaign_path(current_user.account, @campaign), method: :patch, data: { controller: 'campaign-settings' }) do |f| %>
    <div class="flex flex-col gap-8">
      
      <!-- Pipeline Configuration -->
      <section class="bg-white dark:bg-slate-900 p-8 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700">
        <h2 class="typography-title-s-lh150 text-dark-gray-palette-p1 mb-6 flex items-center gap-2">
          <i data-lucide="git-merge" class="w-5 h-5 text-brand-palette-03"></i> Funil de Vendas (Pipeline)
        </h2>
        
        <p class="text-sm text-slate-500 mb-6">Ao importar essa campanha, um novo Negócio (Deal) será criado para cada contato válido. Escolha onde eles devem entrar.</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <%= f.label :pipeline_id, 'Pipeline de Destino', class: 'block typography-micro-b-lh150 text-slate-700 mb-2' %>
            <%= f.collection_select :pipeline_id, @pipelines, :id, :name, { include_blank: 'Não criar negócio (Apenas salvar contato)' }, { class: 'w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-800 focus:border-brand-palette-03', data: { action: 'change->campaign-settings#handlePipelineChange', 'campaign-settings-target': 'pipelineSelect' } } %>
          </div>
          <div>
            <%= f.label :stage_id, 'Estágio do Funil', class: 'block typography-micro-b-lh150 text-slate-700 mb-2' %>
            <%= f.select :stage_id, [], { include_blank: 'Selecione um pipeline primeiro' }, { class: 'w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-800 focus:border-brand-palette-03', data: { 'campaign-settings-target': 'stageSelect' } } %>
          </div>
        </div>
      </section>

      <!-- Rules Configuration -->
      <section class="bg-white dark:bg-slate-900 p-8 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700">
        <h2 class="typography-title-s-lh150 text-dark-gray-palette-p1 mb-6 flex items-center gap-2">
          <i data-lucide="shield-alert" class="w-5 h-5 text-brand-palette-03"></i> Regras de Conflito
        </h2>

        <div class="space-y-4">
          <label class="block typography-micro-b-lh150 text-slate-700 mb-3">Para telefones que <span class="text-orange-500 font-bold">já existem no seu CRM</span>:</label>
          
          <label class="flex items-start gap-3 p-4 border border-slate-200 dark:border-slate-700 rounded-lg cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
            <%= f.radio_button :duplicate_action, 'update', checked: true, class: 'mt-1 text-brand-palette-03 focus:ring-brand-palette-03' %>
            <div>
              <span class="block text-sm font-bold text-slate-800 dark:text-slate-200 mb-1">Atualizar os dados do contato existente (Recomendado)</span>
              <p class="text-xs text-slate-500">Se o telefone for encontrado, o nome, email e outros atributos informados na planilha substituirão os dados antigos do contato.</p>
            </div>
          </label>
          
          <label class="flex items-start gap-3 p-4 border border-slate-200 dark:border-slate-700 rounded-lg cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
            <%= f.radio_button :duplicate_action, 'keep', class: 'mt-1 text-brand-palette-03 focus:ring-brand-palette-03' %>
            <div>
              <span class="block text-sm font-bold text-slate-800 dark:text-slate-200 mb-1">Manter dados atuais intactos</span>
              <p class="text-xs text-slate-500">O sistema usará o contato antigo para enviar a mensagem e criar o negócio, ignorando qualquer nome/email diferente que esteja na planilha atual.</p>
            </div>
          </label>
        </div>
      </section>

      <div class="flex justify-end gap-4 mt-6">
        <%= link_to 'Voltar', composition_account_campaign_path(current_user.account, @campaign), class: 'btn-secondary' %>
        <%= f.button '<i data-lucide="check" class="w-4 h-4 mr-2"></i> Salvar e Ir para Painel'.html_safe, type: 'submit', class: 'btn-primary px-8 py-3 flex items-center shadow-lg hover:shadow-xl transition-all bg-green-600 hover:bg-green-700 border-green-600' %>
      </div>
    </div>
  <% end %>

  <!-- Add missing JS controller directly since it's just a copy of the mapping one but simplified -->
  <script type="module">
    import { Controller } from "@hotwired/stimulus"

    export default class extends Controller {
      static targets = ["pipelineSelect", "stageSelect"]

      connect() {
        this.pipelinesData = <%= raw @pipelines.to_json(include: :stages) %>
        if (this.pipelineSelectTarget.value) {
          this.handlePipelineChange()
        }
      }

      handlePipelineChange() {
        const pipelineId = this.pipelineSelectTarget.value
        const stageSelect = this.stageSelectTarget
        
        stageSelect.innerHTML = '<option value="">Selecione uma etapa...</option>'
        stageSelect.disabled = !pipelineId

        if (pipelineId) {
          const pipeline = this.pipelinesData.find(p => p.id.toString() === pipelineId.toString())
          if (pipeline && pipeline.stages) {
            pipeline.stages.forEach(stage => {
              const option = document.createElement('option')
              option.value = stage.id
              option.textContent = stage.name
              if (this.data.get("currentStage") === stage.id.toString()) {
                option.selected = true
              }
              stageSelect.appendChild(option)
            })
          }
        }
      }
    }
    
    // Quick and dirty way to register the controller dynamically since we just added it inline
    const application = window.Stimulus
    if (application) {
      application.register("campaign-settings", module.exports.default)
    }
  </script>
</div>

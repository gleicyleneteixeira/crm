<% if ['edit', 'new'].include?(action_name) %>
  <nav class="navbar-container">
    <h1 class="typography-title-b-lh150 text-dark-gray-palette-p1">
      <%= t("activerecord.models.pipeline.#{action_name}") %>
    </h1>
  </nav>
<% else %>
  <nav class="bg-white dark:bg-slate-950 px-6 py-2 border-b-[1.5px] color-border-default dark:border-slate-800 transition-colors duration-200 flex justify-between w-full overflow-hidden shrink-0">
    <div class="flex flex-wrap items-center justify-between w-full gap-4">
      
      <%# LADO ESQUERDO: SELETOR DE FUNIL %>
      <div class="flex items-center space-x-2">
        <div class="flex items-center h-10 border-solid border-2 border-light-palette-p3 dark:border-slate-700 rounded-lg overflow-hidden bg-white dark:bg-slate-900">
          <div class="h-10 w-10 flex items-center justify-center bg-brand-palette-08 dark:bg-slate-800 border-r-2 border-light-palette-p3 dark:border-slate-700">
            <%= embedded_svg('vectooor2.svg', { class: 'h-5 w-5 color-fg-soft dark:text-slate-400' }) %>
          </div>
          <select class="px-2 h-full border-none focus:ring-0 typography-text-r-lh150 text-dark-gray-palette-p3 dark:text-slate-200 bg-transparent" onchange="window.location=this.value">
            <% @pipelines.each do |pipeline| %>
              <option value="<%= account_pipeline_path(Current.account, pipeline.id) %>" <%= pipeline.id == @pipeline.id ? 'selected' : '' %>>
                <%= pipeline.name %>
              </option>
            <% end %>
          </select>
          <%= link_to edit_account_pipeline_path(Current.account, @pipeline), class:'h-10 w-10 flex items-center justify-center border-l-2 border-light-palette-p3 dark:border-slate-700 hover:bg-gray-100 dark:hover:bg-slate-800' do %>
            <%= embedded_svg('pencil-icon.svg', { class: 'dark:text-slate-400' }) %>
          <% end %>
        </div>
      </div>

      <%# DIREITA: BOTÕES E O MODO DARK %>
      <div class="flex items-center flex-wrap gap-3">
        <%= link_to new_select_contact_account_deals_path(Current.account), class: 'button-default-fill-primary-md' do %>
          <i data-lucide="clipboard-plus"></i>
          <span class="ml-2 hidden lg:inline"><%= t('activerecord.models.deal.new') %></span>
        <% end %>

        <%= link_to new_account_pipeline_path(Current.account), class: 'button-default-blank-secondary-md dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800' do %>
          <i data-lucide="funnel-plus"></i>
          <span class="ml-2 hidden lg:inline"><%= t('activerecord.models.pipeline.new') %></span>
        <% end %>

        <div data-controller="filter-select-status-deal">
          <form action="<%= account_pipeline_path(Current.account, @pipeline) %>" method="get" data-filter-select-status-deal-target="form">
            <input type="hidden" name="filter_status_deal" value="<%= @filter_status_deal %>" data-filter-select-status-deal-target="status" />
          </form>
          <button id="dropdownSortDeals"
                  data-dropdown-toggle="dropdownSort"
                  class="button-default-blank-secondary-md dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
                  type="button"
                  data-filter-select-status-deal-target="button">
            <i data-lucide="sliders-horizontal"></i>
          </button>
          <div id="dropdownSort" class="z-30 hidden bg-white divide-y divide-gray-300 rounded-lg shadow w-56 dark:bg-gray-700 dark:divide-gray-600">
            <ul class="py-2 typography-text-m-lh150 text-dark-gray-palette-p3 dark:text-gray-200" data-filter-select-status-deal-target="links">
              <li>
                <a href="#"
                   value="open"
                   aria-selected="<%= @filter_status_deal == 'open' ? 'true' : 'false' %>"
                   class="flex items-center space-x-2 px-4 py-2 hover:bg-gray-300 dark:hover:bg-gray-600 block <%= 'bg-brand-palette-07 text-brand-palette-03 pointer-events-none' if @filter_status_deal == 'open' %>"
                   data-action="click->filter-select-status-deal#select">
                  <i data-lucide="copy-plus"></i>
                  <span>Em andamento</span>
                </a>
              </li>
              <li>
                <a href="#"
                   value="won"
                   aria-selected="<%= @filter_status_deal == 'won' ? 'true' : 'false' %>"
                   class="flex items-center space-x-2 px-4 py-2 hover:bg-gray-300 dark:hover:bg-gray-600 block <%= 'bg-brand-palette-07 text-brand-palette-03 pointer-events-none' if @filter_status_deal == 'won' %>"
                   data-action="click->filter-select-status-deal#select">
                  <i data-lucide="copy-check"></i>
                  <span>Ganhados</span>
                </a>
              </li>
              <li>
                <a href="#"
                   value="lost"
                   aria-selected="<%= @filter_status_deal == 'lost' ? 'true' : 'false' %>"
                   class="flex items-center space-x-2 px-4 py-2 hover:bg-gray-300 dark:hover:bg-gray-600 block <%= 'bg-brand-palette-07 text-brand-palette-03 pointer-events-none' if @filter_status_deal == 'lost' %>"
                   data-action="click->filter-select-status-deal#select">
                  <i data-lucide="copy-x"></i>
                  <span>Perdidos</span>
                </a>
              </li>
              <li>
                <a href="#"
                   value="all"
                   aria-selected="<%= @filter_status_deal == 'all' ? 'true' : 'false' %>"
                   class="flex items-center space-x-2 px-4 py-2 hover:bg-gray-300 dark:hover:bg-gray-600 block <%= 'bg-brand-palette-07 text-brand-palette-03 pointer-events-none' if @filter_status_deal == 'all' %>"
                   data-action="click->filter-select-status-deal#select">
                  <i data-lucide="copy"></i>
                  <span>Todos</span>
                </a>
              </li>
            </ul>
          </div>
        </div>

        <%= link_to account_deals_path(Current.account), class: 'button-default-blank-secondary-md dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800' do %>
          <i data-lucide="list"></i>
        <% end %>

        <%# --- BOTÃO MODO ESCURO VOLTOU AQUI --- %>
        <button id="theme-toggle" type="button" class="w-10 h-10 flex items-center justify-center text-gray-500 dark:text-amber-400 hover:bg-gray-100 dark:hover:bg-slate-800 rounded-lg p-2.5 border dark:border-slate-700 transition-colors">
          <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
          <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.707.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"></path></svg>
        </button>

        <%= render 'components/navs/user_menu' %>
      </div>
    </div>
  </nav>

  <script>
    var themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
    var themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
    var themeToggleBtn = document.getElementById('theme-toggle');

    if (themeToggleLightIcon && themeToggleDarkIcon) {
      if (localStorage.getItem('color-theme') === 'dark' || !('color-theme' in localStorage)) {
          themeToggleLightIcon.classList.remove('hidden');
          document.documentElement.classList.add('dark');
      } else {
          themeToggleDarkIcon.classList.remove('hidden');
          document.documentElement.classList.remove('dark');
      }
    }

    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', function() {
          if (themeToggleDarkIcon) themeToggleDarkIcon.classList.toggle('hidden');
          if (themeToggleLightIcon) themeToggleLightIcon.classList.toggle('hidden');
          if (localStorage.getItem('color-theme')) {
              if (localStorage.getItem('color-theme') === 'light') {
                  document.documentElement.classList.add('dark');
                  localStorage.setItem('color-theme', 'dark');
              } else {
                  document.documentElement.classList.remove('dark');
                  localStorage.setItem('color-theme', 'light');
              }
          } else {
              if (document.documentElement.classList.contains('dark')) {
                  document.documentElement.classList.remove('dark');
                  localStorage.setItem('color-theme', 'light');
              } else {
                  document.documentElement.classList.add('dark');
                  localStorage.setItem('color-theme', 'dark');
              }
          }
      });
    }
  </script>
<% end %>
